#!/bin/sh

. /usr/lib/nuubos/exfat-health.sh
. /usr/lib/nuubos/partitions.sh
. /usr/lib/nuubos/userdata.sh

MOUNT_DIR=/userdata
USERDATA_LABEL=NUUBOS_DATA
USERDATA_VERSION=2
PENDING=/state/migrations/userdata-init.pending

log()
{
    echo "nuubOS userdata: $*"
}

geometry()
{
    DISK="$(nuubos_boot_disk)" || {
        log "unable to derive boot disk"
        return 1
    }

    P3="$(partition_device "$DISK" "$NUUBOS_PART_STATE")"
    P5="$(partition_device "$DISK" "$NUUBOS_PART_SLOT_B")"
    P6="$(partition_device "$DISK" "$NUUBOS_PART_USERDATA")"

    [ -b "$DISK" ] || {
        log "boot disk missing: $DISK"
        return 1
    }

    [ -b "$P3" ] || {
        log "STATE partition missing: $P3"
        return 1
    }

    STATE_LABEL="$(blkid -s LABEL -o value "$P3" 2>/dev/null || true)"

    [ "$STATE_LABEL" = "NUUBOS_STATE" ] || {
        log "invalid STATE label: ${STATE_LABEL:-<none>}"
        return 1
    }

    P3_NAME="${P3#/dev/}"

    P3_START="$(cat "/sys/class/block/$P3_NAME/start")" || return 1
    P3_SIZE="$(cat "/sys/class/block/$P3_NAME/size")" || return 1
    DISK_SECTORS="$(blockdev --getsz "$DISK")" || return 1

    #
    # Extended partition from the end of STATE to the end of the card:
    # system slot B (1 MiB after the extended start, room for its EBR),
    # then USERDATA (1 MiB after slot B, room for the next EBR).
    #
    EXT_START=$((P3_START + P3_SIZE))
    EXT_SIZE=$((DISK_SECTORS - EXT_START))
    SLOT_START=$((EXT_START + 2048))
    SLOT_SIZE=$NUUBOS_SLOT_SECTORS
    EXPECTED_START=$((SLOT_START + SLOT_SIZE + 2048))
    EXPECTED_SIZE=$((DISK_SECTORS - EXPECTED_START))

    [ "$EXPECTED_SIZE" -gt 0 ] || {
        log "no space available for USERDATA"
        return 1
    }

    [ $((EXT_START % 2048)) -eq 0 ] || {
        log "USERDATA start is not 1 MiB aligned"
        return 1
    }

    return 0
}

partition_device()
{
    printf '%sp%s\n' "$1" "$2"
}

part_matches()
{
    [ -b "$1" ] || return 1

    PART_NAME="${1#/dev/}"
    PART_START="$(cat "/sys/class/block/$PART_NAME/start")" || return 1
    PART_SIZE="$(cat "/sys/class/block/$PART_NAME/size")" || return 1

    if [ "$PART_START" -ne "$2" ] || [ "$PART_SIZE" -ne "$3" ]; then
        log "unexpected geometry of $1"
        log "expected start=$2 size=$3"
        log "actual   start=$PART_START size=$PART_SIZE"
        return 1
    fi

    return 0
}

validate_layout()
{
    part_matches "$P5" "$SLOT_START" "$SLOT_SIZE" &&
        part_matches "$P6" "$EXPECTED_START" "$EXPECTED_SIZE"
}

register_partitions()
{
    #
    # The root filesystem and STATE are mounted, therefore a full
    # partition-table reread is expected to fail. Add only the new ones.
    #
    for NR in "$NUUBOS_PART_EXTENDED" "$NUUBOS_PART_SLOT_B" "$NUUBOS_PART_USERDATA"; do
        [ -b "$(partition_device "$DISK" "$NR")" ] && continue
        partx --add --nr "$NR" "$DISK" || return 1
    done

    [ -b "$P6" ] || {
        log "USERDATA partition did not appear"
        return 1
    }

    return 0
}

create_layout()
{
    mkdir -p /state/migrations

    cat > "$PENDING" <<EOF2
NUUBOS_USERDATA_INIT_VERSION=1
EOF2

    chmod 600 "$PENDING"
    sync

    log "creating system slot B and USERDATA partitions"

    printf 'start=%s, size=%s, type=5\nstart=%s, size=%s, type=83\nstart=%s, size=%s, type=7\n' \
        "$EXT_START" "$EXT_SIZE" \
        "$SLOT_START" "$SLOT_SIZE" \
        "$EXPECTED_START" "$EXPECTED_SIZE" |
        sfdisk \
            --append \
            --no-reread \
            --no-tell-kernel \
            "$DISK" \
            >/dev/null || return 1

    sync

    register_partitions || return 1
    validate_layout || return 1

    return 0
}

format_if_pending()
{
    #
    # PENDING is the initialization ownership token.
    #
    # If it exists, this USERDATA partition is being created by
    # nuubOS and must be initialized from scratch even if stale
    # filesystem signatures remain beyond the end of a previously
    # flashed image.
    #
    if [ -f "$PENDING" ]; then
        log "initializing USERDATA as exFAT"

        mkfs.exfat -L "$USERDATA_LABEL" "$P6" || return 1
        sync
    fi

    FS_TYPE="$(blkid -s TYPE -o value "$P6" 2>/dev/null || true)"
    FS_LABEL="$(blkid -s LABEL -o value "$P6" 2>/dev/null || true)"

    [ "$FS_TYPE" = "exfat" ] || {
        log "unexpected USERDATA filesystem: ${FS_TYPE:-<none>}"
        return 1
    }

    [ "$FS_LABEL" = "$USERDATA_LABEL" ] || {
        log "unexpected USERDATA label: ${FS_LABEL:-<none>}"
        return 1
    }

    return 0
}

mount_userdata()
{
    mkdir -p "$MOUNT_DIR"

    if grep -qs " $MOUNT_DIR " /proc/mounts; then
        return 0
    fi

    mount \
        -t exfat \
        -o rw,noatime,uid=0,gid=0,fmask=0022,dmask=0022 \
        "$P6" \
        "$MOUNT_DIR" || return 1

    return 0
}

validate_or_initialize_marker()
{
    MARKER="$MOUNT_DIR/.nuubos-userdata"

    if [ -f "$PENDING" ]; then
        cat > "$MARKER" <<EOF2
NUUBOS_USERDATA_VERSION=$USERDATA_VERSION
EOF2

        sync
        return 0
    fi

    if [ ! -f "$MARKER" ]; then
        log "USERDATA marker missing; refusing existing partition"
        umount "$MOUNT_DIR" 2>/dev/null || true
        return 1
    fi

    if ! grep -qx \
        "NUUBOS_USERDATA_VERSION=$USERDATA_VERSION" \
        "$MARKER"; then

        log "unsupported USERDATA marker"
        umount "$MOUNT_DIR" 2>/dev/null || true
        return 1
    fi

    return 0
}

prepare_layout()
{
    #
    # Shared content exists once per active USERDATA filesystem.
    #
    mkdir -p \
        "$MOUNT_DIR/roms" \
        "$MOUNT_DIR/bios" \
        "$MOUNT_DIR/themes" \
        "$MOUNT_DIR/music" \
        "$MOUNT_DIR/applications" \
        "$MOUNT_DIR/ports" \
        "$MOUNT_DIR/cheats" \
        "$MOUNT_DIR/library" \
        "$MOUNT_DIR/logs" \
        "$MOUNT_DIR/cache" \
        "$MOUNT_DIR/downloads" ||
        return 1

    #
    # Persistent per-user content is keyed by the stable UUID owned by STATE.
    #
    nuubos_userdata_prepare_users "$MOUNT_DIR" || return 1

    sync
}

start_userdata()
{
    geometry || return 1

    if [ ! -b "$P6" ]; then
        #
        # The partitions may already exist in the on-disk MBR after an
        # interrupted first boot while still being absent from the kernel.
        #
        if sfdisk -d "$DISK" 2>/dev/null |
           grep -q "^${P6}[[:space:]]*:"; then

            if [ ! -f "$PENDING" ]; then
                log "pre-existing USERDATA partition not owned by initializer"
                return 1
            fi

            log "resuming USERDATA partition registration"

            register_partitions || return 1
        else
            create_layout || return 1
        fi
    fi

    validate_layout || return 1
    format_if_pending || return 1

    if ! nuubos_exfat_prepare         "$P6"         /run/nuubos/storage/tf1.health
    then
        log "USERDATA filesystem health check failed; refusing rw mount"
        return 1
    fi

    mount_userdata || return 1

    # Second half of a scheduled factory reset (EPIC-049); no-op otherwise.
    /usr/sbin/nuubos-recoveryctl apply-pending userdata || true
    validate_or_initialize_marker || return 1
    prepare_layout || return 1

    if [ -f "$PENDING" ]; then
        rm -f "$PENDING"
        sync
    fi

    log "ready"
    return 0
}

case "${1:-}" in
    start)
        start_userdata
        ;;
    stop)
        umount "$MOUNT_DIR" 2>/dev/null || true
        ;;
    restart)
        umount "$MOUNT_DIR" 2>/dev/null || true
        start_userdata
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit $?
