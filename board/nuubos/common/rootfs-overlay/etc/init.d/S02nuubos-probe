#!/bin/sh
#
# Drivers built as modules that the system needs: Wi-Fi, Bluetooth, the
# HDMI/display glue, the GPU and the DMA-BUF heaps (/dev/dma_heap/{system,
# reserved}: Steam Link's Wayland video output allocates from them and
# crashes without them, streaming-media.md). modprobe returns once each
# driver is registered; their users start seconds later (wifid S44, the UI
# S50). Boot audit 2026-10-22: this script also slept 2 s and wrote a debug
# dump to /boot with sync on every boot (3.2 s); the dump now belongs to the
# diagnostic mode (S04nuubos-diagnostics, in RAM), and the firmware loads
# in the background.

for m in sun8i_dw_hdmi sun8i_mixer panfrost system_heap cma_heap; do
    modprobe "$m" 2>/dev/null
done
# Wi-Fi and Bluetooth load their firmware (~1 s together): in the
# background, the boot goes on. BlueZ takes the adapter whenever it comes;
# S44nuubos-wifid waits for wlan0 while /run/nuubos/wifi-probing exists.
mkdir -p /run/nuubos
: > /run/nuubos/wifi-probing
(
    modprobe rtw88_8821cs 2>/dev/null
    rm -f /run/nuubos/wifi-probing
    modprobe hci_uart 2>/dev/null
) &
exit 0
