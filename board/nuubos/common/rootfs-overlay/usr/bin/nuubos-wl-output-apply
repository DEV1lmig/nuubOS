#!/bin/sh

# HDMI modes are capped at 1080 lines: a 4K TV gets 1080p at the preferred
# refresh rate and upscales it itself (4x fewer pixels to render; at 2160p
# the GPU also hit job timeouts). Games keep this mode: RetroArch renders a
# smaller buffer that the display engine scales (nuubos-emud, emulation.md).
HDMI_MAX_LINES=1080

# HDMI mode for $1 as WxH@Hz: the sink's preferred mode when it fits the cap,
# else the best mode within it: square pixels (16:9 or 4:3, not the
# anamorphic 720x480/720x576 CEA modes) first, then the tallest, the widest
# and the refresh rate nearest the preferred one.
hdmi_mode()
{
    /usr/bin/wlr-randr 2>/dev/null | awk -v out="$1" -v cap="$HDMI_MAX_LINES" '
        function ad(x) { return x < 0 ? -x : x }
        function square(i) { return ad(mw[i] * 9 - mh[i] * 16) <= mh[i] * 9 / 100 || mw[i] * 3 == mh[i] * 4 }
        /^[A-Za-z0-9-]+ / { name = $1; next }
        name != out || $2 != "px," { next }
        {
            split($1, wh, "x"); w = wh[1] + 0; h = wh[2] + 0; r = $3 + 0
            n++; mw[n] = w; mh[n] = h; mr[n] = $3
            if ($0 ~ /preferred/) { pw = w; ph = h; pr = r }
        }
        END {
            if (!n) exit 1
            if (!ph) { pw = mw[1]; ph = mh[1]; pr = mr[1] + 0 }
            best = 0
            if (ph <= cap) {
                for (i = 1; i <= n; i++) if (mw[i] == pw && mh[i] == ph && (!best || ad(mr[i] - pr) < ad(mr[best] - pr))) best = i
            } else {
                for (i = 1; i <= n; i++) {
                    if (mh[i] > cap) continue
                    if (best && square(i) != square(best)) { if (square(i)) best = i; continue }
                    if (!best || mh[i] > mh[best] ||
                        (mh[i] == mh[best] && mw[i] > mw[best]) ||
                        (mh[i] == mh[best] && mw[i] == mw[best] && ad(mr[i] - pr) < ad(mr[best] - pr))) best = i
                }
                if (!best) { for (i = 1; i <= n; i++) if (mw[i] == pw && mh[i] == ph) { best = i; break } }
            }
            printf "%dx%d@%s\n", mw[best], mh[best], mr[best]
        }'
}

if [ "$1" = "--hdmi-mode" ]; then
    hdmi_mode "$2"
    exit $?
fi

# Built-in panel density: the 720x720 (RG CubeXX, ~258 ppi) and 720x480
# (RG34XX family, ~254 ppi) panels are much denser than the 640x480
# reference (RG40XX-V, ~200 ppi). 1.125 gives the UI a 640x640 / 640x427
# logical screen: the width its layouts are made for, with text and
# controls 12.5 % larger (docs/dev/ui.md). Other panels: 1.
panel_scale()
{
    /usr/bin/wlr-randr 2>/dev/null | awk -v out="$1" '
        /^[A-Za-z0-9-]+ / { name = $1 }
        name == out && /current/ { split($1, wh, "x"); w = wh[1] + 0; h = wh[2] + 0 }
        END { print (w == 720 && (h == 720 || h == 480)) ? "1.125" : "1" }'
}

current_scale()
{
    /usr/bin/wlr-randr 2>/dev/null | awk -v out="$1" '
        /^[A-Za-z0-9-]+ / { name = $1 }
        name == out && /^  Scale:/ { print $2 + 0 }'
}

# Scale of the built-in panel only (session start without HDMI): no mode
# change, nothing when it already matches.
if [ "$1" = "--panel-scale" ]; then
    PANEL="$(/usr/bin/wlr-randr 2>/dev/null | awk '/^[A-Za-z0-9-]+ / && $1 !~ /^HDMI-A-/ { print $1; exit }')"
    [ -n "$PANEL" ] || exit 0
    WANT="$(panel_scale "$PANEL")"
    [ "$(current_scale "$PANEL")" = "$WANT" ] && exit 0
    /usr/bin/wlr-randr --output "$PANEL" --scale "$WANT" >/dev/null 2>&1
    exit 0
fi

# Output scale for the current mode of $1 (see policy below).
hdmi_scale()
{
    /usr/bin/wlr-randr 2>/dev/null | awk -v out="$1" '
        /^[A-Za-z0-9-]+ / { name = $1 }
        name == out && /current/ { split($1, wh, "x"); h = wh[2] + 0 }
        END {
            # ~720 logical lines, in 0.25 steps: 1080p -> 1.5, 1440p -> 2, 2160p -> 3.
            s = int(h / 720 * 4) / 4
            if (s < 1) s = 1
            print s
        }'
}

OUTPUTS="$(/usr/bin/wlr-randr 2>/dev/null | awk '/^[A-Za-z0-9-]+ / {print $1}')"
[ -n "$OUTPUTS" ] || exit 0

HDMI="$(printf '%s\n' "$OUTPUTS" | grep '^HDMI-A-' | head -n 1)"
if [ -n "$HDMI" ]; then
    MODE="$(hdmi_mode "$HDMI")"
    if [ -n "$MODE" ]; then
        /usr/bin/wlr-randr --output "$HDMI" --on --mode "$MODE" >/dev/null 2>&1 || true
    else
        /usr/bin/wlr-randr --output "$HDMI" --on --preferred >/dev/null 2>&1 || true
    fi
    # TV/monitor density: scale so the UI sees ~720 logical lines and lays out
    # its native 16:9 variant crisply instead of drawing a tiny 1:1 UI.
    SCALE="$(hdmi_scale "$HDMI")"
    /usr/bin/wlr-randr --output "$HDMI" --scale "$SCALE" >/dev/null 2>&1 || true
    printf '%s\n' "$OUTPUTS" | while read -r OUTPUT; do
        [ -n "$OUTPUT" ] || continue
        [ "$OUTPUT" = "$HDMI" ] && continue
        /usr/bin/wlr-randr --output "$OUTPUT" --off >/dev/null 2>&1 || true
    done
else
    PRIMARY="$(printf '%s\n' "$OUTPUTS" | head -n 1)"
    if [ -n "$PRIMARY" ]; then
        /usr/bin/wlr-randr --output "$PRIMARY" --on --preferred >/dev/null 2>&1 || true
        /usr/bin/wlr-randr --output "$PRIMARY" --scale "$(panel_scale "$PRIMARY")" >/dev/null 2>&1 || true
        printf '%s\n' "$OUTPUTS" | while read -r OUTPUT; do
            [ -n "$OUTPUT" ] || continue
            [ "$OUTPUT" = "$PRIMARY" ] && continue
            /usr/bin/wlr-randr --output "$OUTPUT" --off >/dev/null 2>&1 || true
        done
    fi
fi

# The compositor survives hotplug, but the resident layer-shell client may
# retain output-local state from the previous topology. Recreate only that
# client once after applying the new output policy. The input socket closes
# with the old process, releasing any Quick Menu capture automatically.
/usr/bin/nuubos-quick-menu-session restart >/run/nuubos/quick-menu-session.log 2>&1 &

exit 0
