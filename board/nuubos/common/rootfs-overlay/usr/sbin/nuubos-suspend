#!/bin/sh

POWER_STATE=/sys/power/state
MEM_SLEEP=/sys/power/mem_sleep
DEVICE_HOOK=/usr/lib/nuubos/device-suspend-hook
INPUT_RUNTIME=/run/nuubos/input
SUPPRESS_START="$INPUT_RUNTIME/suppress-start"
SUPPRESS_POWER="$INPUT_RUNTIME/suppress-power"
INTERRUPTS=/proc/interrupts
# The hardware watchdog keeps counting while the SoC sleeps (sunxi_wdt has
# no suspend handling): it is stopped for the sleep and started again.
WATCHDOG=/etc/init.d/S12nuubos-watchdog
# Sleep mode from nuubos-systemd: "hypersleep" (the SoC is powered off,
# only the power key wakes it) or "quick" (the SoC stays powered: START and
# a lid wake it too, more drain). The firmware (BL31) reads it from RTC
# general purpose register 5 at every suspend (platform.md "Hypersleep").
SLEEP_MODE="${1:-hypersleep}"
RESUME_MODE_REG=0x07000114
RESUME_MODE_QUICK=0x5170c0de

suspend_log()
{
	echo "nuubOS suspend: $*"
}

run_device_hook()
{
	ACTION="$1"

	if [ -x "$DEVICE_HOOK" ]; then
		"$DEVICE_HOOK" "$ACTION"
	fi
}

# Interrupt count of one /proc/interrupts line, matched by its name
# (e.g. "Key Start", "axp20x-pek-dbf"); empty when the line is missing.
read_irq_count()
{
	awk -v name="$1" '
		index($0, name) {
			total = 0
			for (i = 2; i <= NF; i++) {
				if ($i ~ /^[0-9]+$/)
					total += $i
				else
					break
			}
			print total
			exit
		}
	' "$INTERRUPTS" 2>/dev/null
}

cancel_wake_guards()
{
	rm -f "$SUPPRESS_START" "$SUPPRESS_POWER"
}

# Keep the guard of one wake key only if its interrupt fired across the
# sleep: nuubos-inputd then consumes that key's press/release (START would
# reach the UI, power would open the Power OSD) and removes the marker on
# the physical release. No reliable evidence: never leak suppression.
resolve_wake_guard()
{
	KEY="$1"
	MARKER="$2"
	BEFORE="$3"
	AFTER="$4"

	case "$BEFORE:$AFTER" in
		:*|*unknown*|*:)
			rm -f "$MARKER"
			suspend_log "wake source not classifiable as $KEY; guard cleared"
			;;
		*)
			if [ "$AFTER" -gt "$BEFORE" ] 2>/dev/null; then
				suspend_log "wake source $KEY; guard held until physical release"
			else
				rm -f "$MARKER"
				suspend_log "wake source not $KEY; guard cleared"
			fi
			;;
	esac
}

resume_wifi()
{
	command -v wpa_cli >/dev/null 2>&1 || return 0
	[ -d /sys/class/net/wlan0 ] || return 0

	# statusd's wpa_cli event listener survives the sleep, but
	# wpa_supplicant may have detached it (its event sends failed while
	# everything was frozen; the listener's pings still work, so it never
	# notices): the top bar then kept "connecting" after a resume (user
	# report 2026-10-22). Start it again before any reconnect, and have
	# statusd read the state once now.
	/etc/init.d/S48nuubos-status start >/dev/null 2>&1 || true
	if [ -r /run/nuubos/statusd.pid ]; then
		kill -USR1 "$(cat /run/nuubos/statusd.pid)" 2>/dev/null || true
	fi

	WPA_STATE="$(wpa_cli -i wlan0 status 2>/dev/null | awk -F= '/^wpa_state=/ { print $2; exit }')"

	if [ "$WPA_STATE" != "COMPLETED" ]; then
		# One explicit request to the already-running supplicant. No daemon
		# restart, driver reload/rebind, or retry loop.
		wpa_cli -i wlan0 reconnect >/dev/null 2>&1 || true
		suspend_log "Wi-Fi resume requested from existing wpa_supplicant"
	fi

	# The radio power-save policy belongs to nuubos-wifid (on, off only
	# during low-latency sessions): ask it to apply it again in case the
	# driver reset it across the sleep.
	if [ -r /run/nuubos/wifid.pid ]; then
		kill -USR1 "$(cat /run/nuubos/wifid.pid)" 2>/dev/null || true
	fi
}

[ -w "$POWER_STATE" ] || {
	suspend_log "power state interface unavailable" >&2
	exit 1
}

run_device_hook prepare || {
	suspend_log "device suspend preparation failed" >&2
	exit 1
}

mkdir -p "$INPUT_RUNTIME"

START_IRQ_BEFORE="$(read_irq_count "Key Start")"
POWER_IRQ_BEFORE="$(read_irq_count "axp20x-pek-dbf")"
printf '%s\n' "${START_IRQ_BEFORE:-unknown}" > "$SUPPRESS_START"
printf '%s\n' "${POWER_IRQ_BEFORE:-unknown}" > "$SUPPRESS_POWER"

[ -x "$WATCHDOG" ] && "$WATCHDOG" stop

sync

# Deep sleep (suspend-to-RAM, BL31 SYSTEM_SUSPEND) when the firmware offers
# it; s2idle otherwise. "mem" selects deep, the kernel default once available.
SLEEP_STATE=freeze
SLEEP_NAME=s2idle
if grep -qw deep "$MEM_SLEEP" 2>/dev/null; then
	SLEEP_STATE=mem
	SLEEP_NAME=deep
fi

if [ "$SLEEP_STATE" = mem ] && command -v devmem >/dev/null 2>&1; then
	if [ "$SLEEP_MODE" = quick ]; then
		devmem "$RESUME_MODE_REG" 32 "$RESUME_MODE_QUICK"
	else
		devmem "$RESUME_MODE_REG" 32 0
	fi
	suspend_log "sleep mode $SLEEP_MODE"
fi

if ! echo "$SLEEP_STATE" > "$POWER_STATE"; then
	[ -x "$WATCHDOG" ] && "$WATCHDOG" start
	cancel_wake_guards
	run_device_hook resume >/dev/null 2>&1 || true
	suspend_log "$SLEEP_NAME entry failed" >&2
	exit 1
fi

[ -x "$WATCHDOG" ] && "$WATCHDOG" start

resolve_wake_guard START "$SUPPRESS_START" "$START_IRQ_BEFORE" \
	"$(read_irq_count "Key Start")"
resolve_wake_guard POWER "$SUPPRESS_POWER" "$POWER_IRQ_BEFORE" \
	"$(read_irq_count "axp20x-pek-dbf")"

if ! run_device_hook resume; then
	suspend_log "device resume handling failed" >&2
	exit 1
fi

resume_wifi

exit 0
