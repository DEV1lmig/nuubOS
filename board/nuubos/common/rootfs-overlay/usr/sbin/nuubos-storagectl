#!/bin/sh
# nuubOS storage: the games card in the TF2 slot (docs/dev/platform.md
# "SD2 = games card", EPIC-032).
#
# SD1 holds the system and every piece of user data. SD2 is a content card
# used as it is (exFAT, FAT32, ext4; partitioned or not): libraryd reads its
# ROM folder, Files and Media show it. Removing it never costs progress.
#
#   status                    SD1 and SD2 state (key=value)
#   hotplug add|remove DISK   from udev (TF2 disk events)
#   sd2 attach                identify, repair if dirty, mount (boot, udev, Use)
#   sd2 eject                 flush and unmount; ERR busy while files are open
#   sd2 ignore                "Don't Use": the card is left unmounted, now
#                             and whenever it comes back
#   sd2 use                   use an ignored or ejected card (background)
#   sd2 prepare               create the game folders (job worker)
#   sd2 format <CID>          erase and format exFAT (job worker)
#
# State (/run/nuubos/storage/sd2.status): SD2_SLOT=0|1, SD2_STATE=
# none|empty|checking|ready|readonly|unreadable|ejected, SD2_PATH (mount
# point while mounted), SD2_CID, SD2_FS, SD2_LABEL, SD2_REPAIRED=0|1,
# SD2_PROMPT=none|prepare|format (a card seen for the first time that needs
# the user's choice; cleared by ignore/prepare/format). SD2_STATE=ignored: a
# card the user chose not to use (CID in /state/storage/sd2-ignored). Every change pokes
# nuubos-systemd (snapshot to its subscribers) and libraryd (SCAN).

. /usr/lib/nuubos/exfat-health.sh

STATUS_DIR=/run/nuubos/storage
SD1_STATUS="$STATUS_DIR/storage.status"
SD2_STATUS="$STATUS_DIR/sd2.status"
LOCK="$STATUS_DIR/sd2.lock"
MOUNT=/media/sd2
KNOWN_DIR=/state/storage
KNOWN="$KNOWN_DIR/sd2-known"
IGNORED="$KNOWN_DIR/sd2-ignored"
SYSTEMS=/usr/share/nuubos/systems.conf
# TF2 is MMC2 on every H700 board (kernel 0036); found by its controller,
# not by its device number.
HOST=4022000.mmc
LABEL=NUUBOS

log() { echo "nuubos-storage: $*" >&2; logger -t nuubos-storage "$*" 2>/dev/null; return 0; }
fail() { if [ -n "${NUUBOS_JOB_ID:-}" ]; then echo "@error $1"; else echo "ERR $1"; fi; exit 1; }
progress() { [ -n "${NUUBOS_JOB_ID:-}" ] && echo "@progress $1"; return 0; }

value() { sed -n "s/^$2=//p" "$1" 2>/dev/null | tail -1; }

slot_present() { [ -d "/sys/bus/platform/devices/$HOST/mmc_host" ]; }

# Kernel name of the TF2 card disk, if a card is in.
card_disk()
{
    for d in /sys/block/mmcblk*; do
        [ -e "$d" ] || continue
        case "$(readlink -f "$d")" in */"$HOST"/*) basename "$d"; return 0 ;; esac
    done
    return 1
}

card_cid() { cat "/sys/block/$1/device/cid" 2>/dev/null; }

fs_type() { blkid -o value -s TYPE "$1" 2>/dev/null; }

supported() { case "$1" in exfat|vfat|ext4|ext3|ext2) return 0 ;; esac; return 1; }

# First partition with a supported filesystem, else the whole disk
# (unpartitioned "superfloppy" cards).
data_device()
{
    for p in /sys/block/"$1"/"$1"p*; do
        [ -e "$p" ] || continue
        dev="/dev/$(basename "$p")"
        supported "$(fs_type "$dev")" && { echo "$dev"; return 0; }
    done
    supported "$(fs_type "/dev/$1")" && { echo "/dev/$1"; return 0; }
    return 1
}

mounted() { awk -v m="$MOUNT" '$2 == m { f = 1 } END { exit !f }' /proc/mounts; }

write_status()
{
    mkdir -p "$STATUS_DIR"
    tmp="$SD2_STATUS.tmp.$$"
    {
        if slot_present; then echo "SD2_SLOT=1"; else echo "SD2_SLOT=0"; fi
        echo "SD2_STATE=$1"
        if mounted; then echo "SD2_PATH=$MOUNT"; else echo "SD2_PATH="; fi
        echo "SD2_CID=${CID:-}"
        echo "SD2_FS=${FS:-}"
        echo "SD2_LABEL=${VOLUME:-}"
        echo "SD2_REPAIRED=${REPAIRED:-0}"
        echo "SD2_PROMPT=${PROMPT:-none}"
    } > "$tmp" && mv "$tmp" "$SD2_STATUS"
}

# Keep what is known about the current card when only the state changes.
load_status()
{
    CID="$(value "$SD2_STATUS" SD2_CID)"
    FS="$(value "$SD2_STATUS" SD2_FS)"
    VOLUME="$(value "$SD2_STATUS" SD2_LABEL)"
    REPAIRED="$(value "$SD2_STATUS" SD2_REPAIRED)"
    PROMPT="$(value "$SD2_STATUS" SD2_PROMPT)"
}

announce()
{
    # The backup status depends on the card too; it pokes nuubos-systemd.
    if [ -x /usr/sbin/nuubos-sd2-backup ]; then
        /usr/sbin/nuubos-sd2-backup refresh >/dev/null 2>&1
    else
        nuubos-systemctl storage-changed >/dev/null 2>&1
    fi
    [ "${1:-}" = rescan ] && nuubos-libraryctl scan >/dev/null 2>&1
    return 0
}

toast()
{
    nuubos-notifyctl post storage.sd2 "storage.sd2.$1" ${2:+"$2"} >/dev/null 2>&1
    return 0
}

known() { [ -n "$1" ] && grep -qxF "$1" "$KNOWN" 2>/dev/null; }

ignored() { [ -n "$1" ] && grep -qxF "$1" "$IGNORED" 2>/dev/null; }

set_ignored()
{
    mkdir -p "$KNOWN_DIR"
    { grep -vxF "$1" "$IGNORED" 2>/dev/null | tail -n 31; [ "$2" = 1 ] && echo "$1"; } > "$IGNORED.tmp" &&
        mv "$IGNORED.tmp" "$IGNORED" && sync
}

remember()
{
    [ -n "$1" ] || return 0
    known "$1" && return 0
    mkdir -p "$KNOWN_DIR"
    # A few dozen cards at most; the oldest go first.
    { tail -n 63 "$KNOWN" 2>/dev/null; echo "$1"; } > "$KNOWN.tmp" &&
        mv "$KNOWN.tmp" "$KNOWN" && sync
}

key_of() { printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9'; }

# Folder holding the games: a roms folder in any case, else the card root.
roms_dir()
{
    for d in "$MOUNT"/*/; do
        [ -d "$d" ] || continue
        n="${d%/}"; n="${n##*/}"
        [ "$(key_of "$n")" = roms ] && { echo "${d%/}"; return 0; }
    done
    echo "$MOUNT"
}

# Does the card already hold games? A roms folder, or system folders at its
# root (ArkOS layout), named like a system id, folder, name or alias.
has_games()
{
    [ "$(roms_dir)" != "$MOUNT" ] && return 0
    keys="$(awk -F'|' '!/^#/ && NF >= 3 {
        print $1; print $2; print $3; n = split($7, a, ","); for (i = 1; i <= n; i++) print a[i] }' "$SYSTEMS" |
        while read -r k; do key_of "$k"; echo; done | sort -u)"
    for d in "$MOUNT"/*/; do
        [ -d "$d" ] || continue
        n="${d%/}"; n="$(key_of "${n##*/}")"
        [ -n "$n" ] && printf '%s\n' "$keys" | grep -qxF "$n" && return 0
    done
    return 1
}

# Repair a filesystem left dirty by a card pulled out without ejecting.
# Never on a mounted volume. 0 = clean or repaired, 1 = still damaged.
repair()
{
    REPAIRED=0
    case "$2" in
        exfat)
            nuubos_exfat_prepare "$1" "$STATUS_DIR/sd2.health" || return 1
            [ "$(nuubos_exfat_health_value "$STATUS_DIR/sd2.health" RESULT)" = REPAIRED ] && REPAIRED=1
            ;;
        vfat)
            command -v fsck.fat >/dev/null 2>&1 || return 0
            fsck.fat -a -w "$1" >/dev/null 2>&1
            case $? in 0) ;; 1) REPAIRED=1 ;; *) return 1 ;; esac
            ;;
        ext*)
            command -v e2fsck >/dev/null 2>&1 || return 0
            e2fsck -p "$1" >/dev/null 2>&1
            case $? in 0) ;; 1|2) REPAIRED=1 ;; *) return 1 ;; esac
            ;;
    esac
    return 0
}

mount_card()
{
    case "$2" in
        vfat|exfat) opts="nodev,nosuid,noexec,noatime,uid=0,gid=0,fmask=0022,dmask=0022,iocharset=utf8,errors=remount-ro" ;;
        ext*) opts="nodev,nosuid,noexec,noatime,errors=remount-ro" ;;
    esac
    [ "$(blockdev --getro "$1" 2>/dev/null)" = 1 ] && opts="ro,$opts"
    mkdir -p "$MOUNT" || return 1
    mount -t "$2" -o "$opts" "$1" "$MOUNT" 2>/dev/null && return 0
    mount -t "$2" -o "ro,$opts" "$1" "$MOUNT" 2>/dev/null
}

mount_readonly() { awk -v m="$MOUNT" '$2 == m { split($4, o, ","); for (i in o) if (o[i] == "ro") f = 1 } END { exit !f }' /proc/mounts; }

attach()
{
    quiet="${1:-}"
    # Boot (udev coldplug): the card is simply there, nothing to announce.
    [ -e /run/nuubos/ui-ready ] || quiet=1
    CID=""; FS=""; VOLUME=""; REPAIRED=0; PROMPT=none
    if ! slot_present; then
        write_status none; announce; return 0
    fi
    disk="$(card_disk)" || { mounted && umount -l "$MOUNT"; write_status empty; announce rescan; return 0; }
    CID="$(card_cid "$disk")"
    if ignored "$CID"; then
        # "Don't Use": never mounted, no question, no notification.
        mounted && umount -l "$MOUNT"
        write_status ignored
        announce rescan
        return 0
    fi
    if mounted; then
        load_status
        mount_readonly && write_status readonly || write_status ready
        announce; return 0
    fi
    write_status checking
    announce

    dev="$(data_device "$disk")" || {
        log "card $disk: no supported filesystem"
        known "$CID" || PROMPT=format
        write_status unreadable
        announce rescan
        [ -n "$quiet" ] || toast unreadable
        return 0
    }
    FS="$(fs_type "$dev")"
    VOLUME="$(blkid -o value -s LABEL "$dev" 2>/dev/null | tr -d '\t\n')"
    damaged=0
    repair "$dev" "$FS" || damaged=1
    if ! mount_card "$dev" "$FS"; then
        log "card $dev ($FS): mount failed"
        known "$CID" || PROMPT=format
        write_status unreadable
        announce rescan
        [ -n "$quiet" ] || toast unreadable
        return 0
    fi
    # A volume still damaged after the repair is only read.
    if [ "$damaged" = 1 ] && ! mount_readonly; then
        mount -o remount,ro "$MOUNT" 2>/dev/null
    fi
    if known "$CID"; then
        :
    elif has_games; then
        remember "$CID"
    else
        PROMPT=prepare
    fi
    if mount_readonly; then
        write_status readonly
        log "card $dev ($FS) mounted read-only"
        [ -n "$quiet" ] || toast readonly "name=$VOLUME"
    else
        write_status ready
        log "card $dev ($FS) mounted at $MOUNT"
        [ -n "$quiet" ] || toast inserted "name=$VOLUME"
    fi
    announce rescan
    [ -x /usr/sbin/nuubos-sd2-backup ] && /usr/sbin/nuubos-sd2-backup trigger attach >/dev/null 2>&1
    return 0
}

detach()
{
    prev="$(value "$SD2_STATUS" SD2_STATE)"
    CID=""; FS=""; VOLUME=""; REPAIRED=0; PROMPT=none
    if mounted; then
        # Pulled out without ejecting: detach now so nothing writes into
        # the mount point; open files fail instead of hanging.
        umount -l "$MOUNT" 2>/dev/null
    fi
    write_status empty
    announce rescan
    case "$prev" in
        ready|readonly)
            # A game running from the card is saved and closed (emud).
            nuubos-emuctl storage-lost "$MOUNT" >/dev/null 2>&1
            toast removed
            ;;
    esac
    log "card removed (was ${prev:-unknown})"
}

eject()
{
    state="$(value "$SD2_STATUS" SD2_STATE)"
    case "$state" in ready|readonly) ;; *) echo "ERR not-mounted"; return 1 ;; esac
    sync
    if ! umount "$MOUNT" 2>/dev/null; then
        echo "ERR busy"
        return 1
    fi
    load_status
    write_status ejected
    announce rescan
    toast ejected
    echo OK
}

ignore()
{
    load_status
    [ -n "$CID" ] || { echo "ERR absent"; return 1; }
    if mounted; then
        sync
        umount "$MOUNT" 2>/dev/null || { echo "ERR busy"; return 1; }
    fi
    remember "$CID"
    set_ignored "$CID" 1
    PROMPT=none
    write_status ignored
    announce rescan
    echo OK
}

use()
{
    load_status
    [ -n "$CID" ] && set_ignored "$CID" 0
    attach
}

prepare()
{
    state="$(value "$SD2_STATUS" SD2_STATE)"
    [ "$state" = ready ] || fail not-ready
    progress -1
    dir="$(roms_dir)"
    [ "$dir" = "$MOUNT" ] && dir="$MOUNT/roms"
    mkdir -p "$dir" "$MOUNT/music" "$MOUNT/videos" || fail storage
    awk -F'|' '!/^#/ && NF >= 3 && $3 != "" { print $3 }' "$SYSTEMS" |
        while read -r f; do
            # An existing folder in another case (Roms/GBA) is kept.
            ls -d "$dir"/* 2>/dev/null | awk -v f="$f" '{ n = $0; sub(".*/", "", n) } tolower(n) == tolower(f) { found = 1 } END { exit !found }' ||
                mkdir -p "$dir/$f"
        done
    sync
    load_status
    remember "$CID"
    PROMPT=none
    write_status ready
    announce rescan
    echo "@progress 100"
}

format_card()
{
    expected="$1"
    [ -n "$expected" ] || fail cid
    disk="$(card_disk)" || fail absent
    CID="$(card_cid "$disk")"
    [ "$CID" = "$expected" ] || fail changed
    case "/dev/$disk" in "$(sed -n 's/.*root=\(\/dev\/mmcblk[0-9]*\).*/\1/p' /proc/cmdline)"*) fail boot-disk ;; esac
    progress 5
    if mounted; then
        sync
        umount "$MOUNT" 2>/dev/null || fail busy
    fi
    write_status checking
    announce rescan
    log "formatting /dev/$disk (CID $CID)"
    printf 'label: dos\nunit: sectors\n\nstart=2048, type=7\n' |
        sfdisk --wipe always --wipe-partitions always "/dev/$disk" >/dev/null 2>&1 || { attach quiet; fail format; }
    blockdev --rereadpt "/dev/$disk" 2>/dev/null
    udevadm settle 2>/dev/null
    progress 30
    [ -b "/dev/${disk}p1" ] || { attach quiet; fail format; }
    mkfs.exfat -L "$LABEL" "/dev/${disk}p1" >/dev/null 2>&1 || { attach quiet; fail format; }
    progress 80
    remember "$CID"
    set_ignored "$CID" 0
    attach quiet
    [ "$(value "$SD2_STATUS" SD2_STATE)" = ready ] || fail format
    prepare >/dev/null
    toast formatted
    echo "@progress 100"
}

status()
{
    cat "$SD1_STATUS" 2>/dev/null
    cat "$SD2_STATUS" 2>/dev/null || echo "SD2_STATE=unknown"
}

# All card changes are serialised; udev events return at once and the work
# (a repair can take a while) goes on in the background.
locked() { mkdir -p "$STATUS_DIR"; exec 9> "$LOCK"; flock 9; "$@"; }

case "${1:-}" in
    status) status ;;
    hotplug)
        case "${2:-}" in
            add) ( locked attach ) </dev/null >/dev/null 2>&1 & ;;
            remove) ( locked detach ) </dev/null >/dev/null 2>&1 & ;;
            *) exit 2 ;;
        esac
        ;;
    sd2)
        case "${2:-}" in
            attach) locked attach "${3:-}" ;;
            eject) locked eject ;;
            ignore) locked ignore ;;
            # Identify and maybe repair: in the background like an insertion.
            use) ( locked use ) </dev/null >/dev/null 2>&1 & ;;
            prepare) locked prepare ;;
            format) locked format_card "${3:-}" ;;
            *) echo "Usage: nuubos-storagectl sd2 attach|eject|ignore|use|prepare|format CID" >&2; exit 2 ;;
        esac
        ;;
    *)
        echo "Usage: nuubos-storagectl status | hotplug add|remove DISK | sd2 attach|eject|ignore|use|prepare|format CID" >&2
        exit 2
        ;;
esac
