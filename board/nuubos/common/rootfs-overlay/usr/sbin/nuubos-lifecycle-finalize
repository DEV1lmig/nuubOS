#!/bin/sh

MODE="${1:-poweroff}"

case "$MODE" in
    reboot|restart)
        MODE=reboot
        ;;
    poweroff|shutdown)
        MODE=poweroff
        ;;
    *)
        echo "Usage: $0 {reboot|poweroff}" >&2
        exit 1
        ;;
esac

mkdir -p /run/nuubos
printf '%s\n' "$MODE" > /run/nuubos/shutdown-mode

LOG=/run/nuubos/lifecycle-final.log
: > "$LOG"

log()
{
    printf '%s\n' "$*" >> "$LOG"
}

log "mode=$MODE"

#
# Lifecycle splash animation (nuubUI/Quick Menu src/splash.rs): fade-in
# 280 ms, then two 900 ms sweeps (restart) or a 650 ms drain (power off),
# ending on the raster nuubos-splash --prepare draws below.
#
if [ "${NUUBOS_LIFECYCLE_PREANIMATED:-0}" = "1" ]; then
    #
    # A system-wide Overlay client (currently Quick Menu) has already
    # completed the lifecycle animation and is holding the
    # final raster on KMS. Do not trigger a second Home animation underneath.
    #
    log "slint-transition=preanimated-overlay"
elif pidof nuubui-home >/dev/null 2>&1 && [ -p /run/nuubos/ui-control ]; then
    printf '%s\n' "$MODE" > /run/nuubos/ui-control
    log "slint-transition=sent"
    if [ "$MODE" = reboot ]; then sleep 2.15; else sleep 1.00; fi
else
    log "slint-transition=unavailable"
fi

#
# Pre-render the exact same final lifecycle raster into fbdev while it remains
# hidden. --prepare does not unblank or force a display commit.
#
if /usr/bin/nuubos-splash --prepare "$MODE" >>"$LOG" 2>&1; then
    log "fbdev-prepare=ok"
else
    log "fbdev-prepare=fail"
    exit 1
fi

sync

#
# labwc's buffers die with it and the kernel turns the plane off: the
# screen stayed black (backlight on) through all of rcK until the fbdev
# splash at the very end (measured 2026-10-28). --handoff prepares the same
# final raster on KMS now, at each output's own mode, and shows it the
# moment labwc releases the device; it keeps the device open to the end.
# SIGUSR2 makes labwc drop master with its frame still on screen (labwc
# patch 0007), so the splash replaces it in one commit before labwc is
# killed: killing it first left one black frame (a flash).
# --hold (device open only, no fbdev restore) is the fallback.
handoff_wait()
{
    I=0
    while [ ! -e /run/nuubos/handoff-shown ] && [ "$I" -lt 40 ]; do
        sleep 0.025
        I=$((I + 1))
    done
    [ -e /run/nuubos/handoff-shown ]
}

rm -f /run/nuubos/handoff-shown
HANDOFF=0
if /usr/bin/nuubos-splash --handoff "$MODE" >>"$LOG" 2>&1; then
    HANDOFF=1
    log "drm-handoff=prepared"
    if pidof labwc >/dev/null 2>&1; then
        killall -USR2 labwc >>"$LOG" 2>&1 || true
        handoff_wait && log "drm-handoff=shown-before-kill"
    fi
else
    /usr/bin/nuubos-splash --hold >>"$LOG" 2>&1 && log "drm-hold=started"
fi

if pidof labwc >/dev/null 2>&1; then
    log "labwc-before=$(pidof labwc 2>/dev/null)"
    killall -9 labwc >>"$LOG" 2>&1 || true

    I=0
    while pidof labwc >/dev/null 2>&1 && [ "$I" -lt 40 ]; do
        sleep 0.025
        I=$((I + 1))
    done
fi

if pidof labwc >/dev/null 2>&1; then
    log "labwc-release=still-running"
    exit 1
fi

log "labwc-release=done"

if [ "$HANDOFF" = 1 ]; then
    handoff_wait && log "drm-handoff=shown" || log "drm-handoff=not-shown"
fi

sync
log "handoff=complete"

exit 0
