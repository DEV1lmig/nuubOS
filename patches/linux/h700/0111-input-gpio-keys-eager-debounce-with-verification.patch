From: nuubOS Project <noreply@nuubos.invalid>
Subject: [PATCH] input: gpio-keys: eager debounce with verification

The Allwinner PIO detects edges on the pins sampled by its debounce
clock (32 kHz by default), the data register reads them directly. Contact
bounce shorter than a sample reaches the data register without an edge,
so the single read at the end of the software debounce interval could
catch a level the pin had only for microseconds; with no further edge
the key stayed that way until it was pressed again (a released D-pad
direction kept held in games, a held one dropped).

For EV_KEY buttons on a GPIO readable in IRQ context: the first edge
reports the level at once (no debounce delay on a press or a release),
later edges restart the quiet interval, whose end reports the level only
when several reads agree, and the level is read again every 10 ms while
the key is reported pressed and three times after a release; two reads
in a row that disagree with the reported level correct it ("missed
edge" in the kernel log).

Signed-off-by: nuubOS Project <noreply@nuubos.invalid>
---
--- a/drivers/input/keyboard/gpio_keys.c
+++ b/drivers/input/keyboard/gpio_keys.c
@@ -53,6 +53,13 @@
 	bool key_pressed;
 	bool suspended;
 	bool debounce_use_hrtimer;
+
+	/* Eager debounce (EV_KEY on a GPIO that can be read in IRQ context). */
+	bool eager;
+	bool settling;		/* an edge was seen, the contact may bounce */
+	int reported;		/* last level reported */
+	int mismatch;		/* verify reads in a row that disagreed */
+	unsigned int verifies;	/* verify reads left while released */
 };
 
 struct gpio_keys_drvdata {
@@ -379,6 +386,123 @@
 	} else {
 		input_event(input, type, *bdata->code, state);
 	}
+	bdata->reported = state;
+}
+
+/*
+ * Eager debounce with verification (nuubOS).
+ *
+ * The Allwinner PIO detects edges on the pins sampled by its debounce
+ * clock (32 kHz by default) while the data register reads them directly.
+ * Contact bounce shorter than a sample reaches the data register without
+ * raising an edge, so the single read at the end of the debounce interval
+ * could catch a level the pin had only for microseconds, and with no
+ * further edge the key stayed that way: a released D-pad direction kept
+ * being held until it was pressed again, a held one dropped (user reports
+ * on the RG SP and RG40XX V, 2026-10-21..24).
+ *
+ * Now the first edge reports the level read at once (no debounce delay
+ * on a press or a release), later edges only restart the quiet interval,
+ * its end reports the level only when several reads agree (otherwise it
+ * is still bouncing: try again 1 ms later), and the level is read again
+ * every GPIO_KEYS_VERIFY_MS while the key is reported pressed and a few
+ * times after a release: two reads in a row that disagree with what was
+ * reported correct it.
+ */
+#define GPIO_KEYS_VERIFY_MS		10
+#define GPIO_KEYS_RELEASED_VERIFIES	3
+#define GPIO_KEYS_SAMPLES		3
+
+static int gpio_keys_eager_sample(struct gpio_button_data *bdata)
+{
+	int first = gpiod_get_value(bdata->gpiod);
+	int i;
+
+	if (first < 0)
+		return first;
+	for (i = 1; i < GPIO_KEYS_SAMPLES; i++) {
+		udelay(20);
+		if (gpiod_get_value(bdata->gpiod) != first)
+			return -EAGAIN;
+	}
+	return first;
+}
+
+static void gpio_keys_eager_report(struct gpio_button_data *bdata, int state)
+{
+	if (state < 0 || state == bdata->reported)
+		return;
+	input_event(bdata->input, EV_KEY, *bdata->code, state);
+	input_sync(bdata->input);
+	bdata->reported = state;
+}
+
+static enum hrtimer_restart gpio_keys_eager_timer(struct gpio_button_data *bdata,
+						  struct hrtimer *t)
+{
+	enum hrtimer_restart ret = HRTIMER_RESTART;
+	unsigned long flags;
+	int state;
+
+	spin_lock_irqsave(&bdata->lock, flags);
+
+	/* An edge restarted the timer while this run waited for the lock. */
+	if (hrtimer_is_queued(t)) {
+		ret = HRTIMER_NORESTART;
+		goto out;
+	}
+
+	if (bdata->settling) {
+		state = gpio_keys_eager_sample(bdata);
+		if (state == -EAGAIN) {
+			hrtimer_forward_now(t, ms_to_ktime(1));
+			goto out;
+		}
+		bdata->settling = false;
+		gpio_keys_eager_report(bdata, state);
+		if (bdata->button->wakeup)
+			pm_relax(bdata->input->dev.parent);
+		bdata->mismatch = 0;
+		bdata->verifies = GPIO_KEYS_RELEASED_VERIFIES;
+	} else {
+		state = gpiod_get_value(bdata->gpiod);
+		if (state >= 0 && state != bdata->reported) {
+			if (++bdata->mismatch >= 2) {
+				dev_info_ratelimited(bdata->input->dev.parent,
+						     "%s: missed edge, level %d\n",
+						     bdata->button->desc ?: "key", state);
+				gpio_keys_eager_report(bdata, state);
+				bdata->mismatch = 0;
+				bdata->verifies = GPIO_KEYS_RELEASED_VERIFIES;
+			}
+		} else {
+			bdata->mismatch = 0;
+		}
+		if (!bdata->reported && !bdata->mismatch &&
+		    !bdata->verifies--) {
+			ret = HRTIMER_NORESTART;
+			goto out;
+		}
+	}
+	hrtimer_forward_now(t, ms_to_ktime(GPIO_KEYS_VERIFY_MS));
+out:
+	spin_unlock_irqrestore(&bdata->lock, flags);
+	return ret;
+}
+
+/* After the state was read outside the edge path (open, resume). */
+static void gpio_keys_eager_resync(struct gpio_button_data *bdata)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&bdata->lock, flags);
+	if (!bdata->settling && !hrtimer_active(&bdata->debounce_timer)) {
+		bdata->mismatch = 0;
+		bdata->verifies = GPIO_KEYS_RELEASED_VERIFIES;
+		hrtimer_start(&bdata->debounce_timer,
+			      ms_to_ktime(GPIO_KEYS_VERIFY_MS), HRTIMER_MODE_REL);
+	}
+	spin_unlock_irqrestore(&bdata->lock, flags);
 }
 
 static void gpio_keys_debounce_event(struct gpio_button_data *bdata)
@@ -403,6 +527,9 @@
 	struct gpio_button_data *bdata =
 		container_of(t, struct gpio_button_data, debounce_timer);
 
+	if (bdata->eager)
+		return gpio_keys_eager_timer(bdata, t);
+
 	gpio_keys_debounce_event(bdata);
 
 	return HRTIMER_NORESTART;
@@ -426,10 +553,23 @@
 			 * handler to run.
 			 */
 			input_report_key(bdata->input, button->code, 1);
+			bdata->reported = 1;
 		}
 	}
 
-	if (bdata->debounce_use_hrtimer) {
+	if (bdata->eager) {
+		unsigned long flags;
+
+		spin_lock_irqsave(&bdata->lock, flags);
+		if (!bdata->settling) {
+			gpio_keys_eager_report(bdata, gpiod_get_value(bdata->gpiod));
+			bdata->settling = true;
+		}
+		hrtimer_start(&bdata->debounce_timer,
+			      ms_to_ktime(bdata->software_debounce),
+			      HRTIMER_MODE_REL);
+		spin_unlock_irqrestore(&bdata->lock, flags);
+	} else if (bdata->debounce_use_hrtimer) {
 		hrtimer_start(&bdata->debounce_timer,
 			      ms_to_ktime(bdata->software_debounce),
 			      HRTIMER_MODE_REL);
@@ -568,6 +708,9 @@
 			 */
 			bdata->debounce_use_hrtimer =
 					!gpiod_cansleep(bdata->gpiod);
+			bdata->eager = bdata->debounce_use_hrtimer &&
+				       bdata->software_debounce &&
+				       (!button->type || button->type == EV_KEY);
 		}
 
 		/*
@@ -723,6 +866,10 @@
 			gpio_keys_gpio_report_event(bdata);
 	}
 	input_sync(input);
+
+	for (i = 0; i < ddata->pdata->nbuttons; i++)
+		if (ddata->data[i].eager)
+			gpio_keys_eager_resync(&ddata->data[i]);
 }
 
 static int gpio_keys_open(struct input_dev *input)
