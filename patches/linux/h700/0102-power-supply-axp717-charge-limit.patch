+/*
+ * Power off: a held limit stays held (the PMIC keeps the register while
+ * the battery is connected; probe enables charging again at the next
+ * boot), otherwise the CV cap approximates the limit.
+ */
+static void axp20x_battery_shutdown(struct platform_device *pdev)
+{
+	axp717_charge_cap(platform_get_drvdata(pdev));
+}
