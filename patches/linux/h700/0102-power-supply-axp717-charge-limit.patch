+	/*
+	 * AXP717 charge limit (charge_control_end_threshold): charging stops
+	 * at charge_end percent and resumes AXP717_CHARGE_RESUME_DELTA below
+	 * it. charge_held = charging disabled by the limit. cv_saved holds
+	 * the CV register while the sleep/power-off cap replaces it, -1 when
+	 * not capped.
+	 */
+	bool has_charge_limit;
+	struct mutex charge_lock;
+	int charge_end;
+	bool charge_held;
+	int cv_saved;
 };
 
+#define AXP717_CHARGE_RESUME_DELTA	5
+#define AXP717_CHARGE_END_MIN		50
+#define AXP717_PWR_OP_VBUS_GOOD		BIT(5)
+/*
+ * While nothing watches the gauge (s2idle masks its IRQ, power off) the
+ * limit can only be approximated by the CV voltage: 4.1 V ends a Li-ion
+ * charge near 90 %, so it is used for limits up to 90 %.
+ */
+#define AXP717_CHARGE_CAP_MAX_END	90
+
+/* Called with charge_lock held. */
+static void axp717_charge_limit_apply_locked(struct axp20x_batt_ps *batt)
+{
+	unsigned int reg;
+	int cap;
+	bool hold = batt->charge_held;
+
+	if (regmap_read(batt->regmap, AXP717_ON_INDICATE, &reg))
+		return;
+	if (batt->charge_end >= 100 || !(reg & AXP717_PWR_OP_BATT_PRESENT)) {
+		hold = false;
+	} else {
+		if (regmap_read(batt->regmap, AXP717_BATT_PERCENT_DATA, &reg))
+			return;
+		cap = reg & AXP209_FG_PERCENT;
+		if (cap >= batt->charge_end)
+			hold = true;
+		else if (cap <= batt->charge_end - AXP717_CHARGE_RESUME_DELTA)
+			hold = false;
+	}
+	if (hold == batt->charge_held)
+		return;
+	if (regmap_update_bits(batt->regmap, AXP717_MODULE_EN_CONTROL_2,
+			       AXP717_CHRG_ENABLE, hold ? 0 : AXP717_CHRG_ENABLE))
+		return;
+	batt->charge_held = hold;
+}
+
+static void axp717_charge_limit_apply(struct axp20x_batt_ps *batt)
+{
+	if (!batt->has_charge_limit)
+		return;
+	mutex_lock(&batt->charge_lock);
+	axp717_charge_limit_apply_locked(batt);
+	mutex_unlock(&batt->charge_lock);
+}
+
+/* Sleep/power off: CV cap when the limit is low and charging may run. */
+static void axp717_charge_cap(struct axp20x_batt_ps *batt)
+{
+	unsigned int reg;
+
+	if (!batt->has_charge_limit)
+		return;
+	mutex_lock(&batt->charge_lock);
+	if (batt->cv_saved < 0 && !batt->charge_held &&
+	    batt->charge_end <= AXP717_CHARGE_CAP_MAX_END &&
+	    !regmap_read(batt->regmap, AXP717_CV_CHG_SET, &reg) &&
+	    (reg & AXP717_CHRG_CV_VOLT_MASK) > AXP717_CHRG_CV_4_1V &&
+	    (reg & AXP717_CHRG_CV_VOLT_MASK) != AXP717_CHRG_CV_5_0V &&
+	    !regmap_update_bits(batt->regmap, AXP717_CV_CHG_SET,
+				AXP717_CHRG_CV_VOLT_MASK, AXP717_CHRG_CV_4_1V))
+		batt->cv_saved = reg & AXP717_CHRG_CV_VOLT_MASK;
+	mutex_unlock(&batt->charge_lock);
+}
+
+static void axp717_charge_uncap(struct axp20x_batt_ps *batt)
+{
+	if (!batt->has_charge_limit)
+		return;
+	mutex_lock(&batt->charge_lock);
+	if (batt->cv_saved >= 0 &&
+	    !regmap_update_bits(batt->regmap, AXP717_CV_CHG_SET,
+				AXP717_CHRG_CV_VOLT_MASK, batt->cv_saved))
+		batt->cv_saved = -1;
+	mutex_unlock(&batt->charge_lock);
+}
