+
+	/* Send one byte; the flag clears by writing 1 (sunxi). */
+	.macro	twi_byte _byte, _status
+	mov	w1, #\_byte
+	str	w1, [x9, #TWI_DATA]
+	ldr	w1, [x9, #TWI_CNTR]
+	orr	w1, w1, #TWI_CNTR_IFLG
+	str	w1, [x9, #TWI_CNTR]
+	twi_wait \_status
+	.endm
+
+func sunxi_universal_sram
+	mov	x14, x0
+	mov_imm	x10, MCTL_CTL_BASE
+	mov_imm	x11, MCTL_COM_BASE
+	mov_imm	x12, STANDBY_STEP_REG
