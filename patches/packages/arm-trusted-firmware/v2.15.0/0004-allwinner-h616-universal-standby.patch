+	ldr	w5, [x11, #MC_MAER0]
+	ldr	w6, [x11, #MC_MAER1]
+	ldr	w7, [x11, #MC_MAER2]
+	str	wzr, [x11, #MC_MAER0]
+	str	wzr, [x11, #MC_MAER1]
+	str	wzr, [x11, #MC_MAER2]
+	dsb	sy
+
+	/* Request software self-refresh and wait for the controller. */
+	ldr	w1, [x10, #CTL_PWRCTL]
+	orr	w1, w1, #PWRCTL_SELFREF_SW
+	str	w1, [x10, #CTL_PWRCTL]
+	dsb	sy
+	mrs	x2, cntpct_el0
+	mov_imm	x3, SELFREF_TIMEOUT
+	add	x2, x2, x3
+1:	ldr	w1, [x10, #CTL_STATR]
+	and	w1, w1, #STATR_OP_MODE_MASK
+	cmp	w1, #STATR_OP_MODE_SELFREF
+	b.eq	2f
+	mrs	x3, cntpct_el0
+	cmp	x3, x2
+	b.lo	1b
+
+	/* Timed out: leave self-refresh, masters back, give up. */
+	standby_step 0xe1
+	ldr	w1, [x10, #CTL_PWRCTL]
+	bic	w1, w1, #PWRCTL_SELFREF_SW
+	str	w1, [x10, #CTL_PWRCTL]
+	dsb	sy
+3:	ldr	w1, [x10, #CTL_STATR]
+	and	w1, w1, #STATR_OP_MODE_MASK
+	cmp	w1, #STATR_OP_MODE_NORMAL
+	b.ne	3b
+	str	w5, [x11, #MC_MAER0]
+	str	w6, [x11, #MC_MAER1]
+	str	w7, [x11, #MC_MAER2]
+	dsb	sy
+	mov	w0, #1
+	ret
+
+	/* Hold the DRAM pads, then take the PHY out of DFI operation. */
+2:	standby_step 0x22
+	mov_imm	x5, DRAM_PAD_HOLD_REG
+	ldr	w1, [x5]
+	bic	w1, w1, #1
+	str	w1, [x5]
+	str	wzr, [x10, #CTL_SWCTL]
+	ldr	w1, [x10, #CTL_DFIMISC]
+	bic	w1, w1, #1
+	orr	w1, w1, #0x1f00
+	str	w1, [x10, #CTL_DFIMISC]
+	ldr	w1, [x10, #CTL_DFIMISC]
+	orr	w1, w1, #0x20
+	str	w1, [x10, #CTL_DFIMISC]
+	mov	w1, #1
+	str	w1, [x10, #CTL_SWCTL]
+	dsb	sy
+	mrs	x2, cntpct_el0
+	mov_imm	x3, SELFREF_TIMEOUT
+	add	x2, x2, x3
+4:	ldr	w1, [x10, #CTL_DFISTAT]
+	tbz	w1, #0, 5f
+	mrs	x3, cntpct_el0
+	cmp	x3, x2
+	b.lo	4b
+	standby_step 0xe2
+5:	standby_step 0x23
+	cbnz	x14, .Luniv_wdog
+
+	/* AXP717: START, address, SLEEP_CFG, 0x6d, STOP. */
+	mov_imm	x9, SUNXI_R_I2C_BASE
+	ldr	w1, [x9, #TWI_CNTR]
+	orr	w1, w1, #TWI_CNTR_START
+	str	w1, [x9, #TWI_CNTR]
+	twi_wait TWI_STAT_START
+	twi_byte AXP717_I2C_WRITE, TWI_STAT_ADDR_W_ACK
+	twi_byte AXP717_SLEEP_CFG_REG, TWI_STAT_DATA_W_ACK
+	twi_byte AXP717_SLEEP_ENTER, TWI_STAT_DATA_W_ACK
+	ldr	w1, [x9, #TWI_CNTR]
+	orr	w1, w1, #(TWI_CNTR_STOP | TWI_CNTR_IFLG)
+	str	w1, [x9, #TWI_CNTR]
+	dsb	sy
+	standby_step 0x24
+
+	/* The PMIC takes the power away here. */
+	mrs	x2, cntpct_el0
+	mov_imm	x3, POWER_OFF_TIMEOUT
+	add	x2, x2, x3
+6:	mrs	x3, cntpct_el0
+	cmp	x3, x2
+	b.lo	6b
+	standby_step 0xe5
+	b	.Luniv_wdog
+
+.Luniv_twi_fail:
+	str	w4, [x12, #-4]
+	standby_step 0xe4
+
+	/* Reset the SoC: the DRAM stays in self-refresh, held. */
+.Luniv_wdog:
+	standby_step 0x25
+	mov_imm	x1, WDOG_CFG_REG
+	mov	w2, #1
+	str	w2, [x1]
+	mov_imm	x1, WDOG_MODE_REG
+	str	w2, [x1]
+	dsb	sy
+7:	wfi
+	b	7b
+sunxi_universal_sram_end:
+endfunc sunxi_universal_sram
+
+/*
+ * int sunxi_universal_suspend_wfi(uintptr_t sram_entry, unsigned long mode)
+ *
+ * MMU off (the translation tables are in DRAM), run the SRAM part; back
+ * only when the DRAM could not enter self-refresh.
+ */
+func sunxi_universal_suspend_wfi
+	stp	x29, x30, [sp, #-16]!
+	mrs	x2, sctlr_el3
+	bic	x2, x2, #SCTLR_M_BIT
+	bic	x2, x2, #SCTLR_C_BIT
+	msr	sctlr_el3, x2
+	isb
+	ic	iallu
+	dsb	sy
+	isb
+	mov	x2, x0
+	mov	x0, x1
+	blr	x2
+	mrs	x1, sctlr_el3
+	orr	x1, x1, #SCTLR_M_BIT
+	msr	sctlr_el3, x1
+	isb
+	ldp	x29, x30, [sp], #16
+	ret
+endfunc sunxi_universal_suspend_wfi
+
+/*
+ * void sunxi_universal_resume_entry(void)
+ *
+ * Entered from U-Boot SPL at EL3 after a cold start of the SoC, the DRAM
+ * resumed: the counter frequency (per core, lost) and a reset-like
+ * SCTLR_EL3, then the PSCI warm boot path as for any CPU powered up.
+ */
+func sunxi_universal_resume_entry
+	msr	daifset, #0xf
+	mov_imm	x1, STANDBY_STEP_REG
+	mov_imm	w0, STANDBY_STEP(0x30)
+	str	w0, [x1]
+	mov_imm	x0, SUNXI_OSC24M_CLK_IN_HZ
+	msr	cntfrq_el0, x0
+	mrs	x0, sctlr_el3
+	bic	x0, x0, #SCTLR_M_BIT
+	bic	x0, x0, #SCTLR_C_BIT
+	bic	x0, x0, #SCTLR_A_BIT
+	msr	sctlr_el3, x0
+	isb
+	ic	iallu
+	tlbi	alle3
+	dsb	sy
+	isb
+	b	bl31_warm_entrypoint
+endfunc sunxi_universal_resume_entry
