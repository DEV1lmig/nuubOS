+/*
+ * Universal standby (the vendor "super standby", user request 2026-10-22):
+ * the AXP717 switches DCDC1 (VDD-CPU), DCDC2 (VDD-SYS) and CLDO3 (VCC-IO)
+ * off in its sleep state and back on at a wake-up IRQ, which then is a
+ * cold start of the SoC (U-Boot SPL resumes the DRAM and comes back here).
+ * Register use from the vendor sun50iw9 BL31 for this PMIC (0x0e = 2):
+ * every IRQ status cleared, SLEEP_CFG 0x25 = 0x2d (bit 5: IRQs wake),
+ * AUTO_SLP_MAP 0x28-0x2a = the rails to switch off, then 0x25 = 0x6d
+ * (bit 6: enter sleep), written from SRAM once the DRAM is in
+ * self-refresh (sunxi_universal_sram). Only the power key press and the
+ * critical battery level wake it: the IRQ enables are kept here and
+ * written back on resume, together with the VDD-CPU/VDD-SYS setpoints
+ * U-Boot programs at every start.
+ */
+#define AXP717_IRQ_EN0			0x40
+#define AXP717_IRQ_STATE0		0x48
+#define AXP717_IRQ_REGS			5
+#define AXP717_IRQ0_SOC_DROP_LVL2	BIT(7)
+#define AXP717_IRQ1_PEK_FALLING		BIT(1)
+#define AXP717_SLEEP_CFG		0x25
+#define AXP717_SLEEP_CFG_ARM		0x2d
+#define AXP717_AUTO_SLP_MAP0		0x28
+#define AXP717_DCDC2_CONTROL		0x84
+#define AXP717_DCDC_OUTPUT_CONTROL	0x80
+#define AXP717_LDO0_OUTPUT_CONTROL	0x90
+#define AXP717_LDO1_OUTPUT_CONTROL	0x91
+/* Map bits: map 0 = DCDC1-4 (bits 0-3), ALDO1-4 (4-7); map 1 = BLDO1-4
+ * (0-3), CLDO1-4 (4-7). DCDC1, DCDC2 (map 0) and CLDO3 (map 1 bit 6), as
+ * the vendor DT's standby_param (vdd-cpua | vdd-sys | vcc-io), plus CLDO1
+ * (map 1 bit 4, vcc-spkr-amp): with VCC-IO off its enable pin (PI5)
+ * floats, and a powered speaker amplifier popped. */
+static const uint8_t axp717_sleep_map[3] = { 0x03, 0x50, 0x00 };
+/* Optional rails, switched off too to bring the sleep drain down: those
+ * still enabled at this point but unused with the SoC off, each
+ * qualified alone (RTC GP5 test map, sunxi_native_pm.c; DRAM content
+ * checked across the wake, CubeXX 2026-10-22): DCDC4 0x08 (no consumer),
+ * ALDO1 0x10 (HDMI hvcc), ALDO4 0x80 (codec avcc, Wi-Fi vqmmc). Never
+ * BLDO2 (vcc-pll): the DRAM loses its content without it (the SPL
+ * resume fails, a cold boot). DCDC3 (vdd-dram) and CPUSLDO always stay
+ * on. The enable bits of these rails are written back on resume as
+ * Linux left them. */
+#define AXP717_SLEEP_EXTRA_MAP		0x0098
+
+static uint8_t axp717_standby_saved[AXP717_IRQ_REGS + 3];
+static uint8_t axp717_standby_extra[2];
+static uint8_t axp717_standby_out[3];
+static bool axp717_standby_out_saved;
+
+int sunxi_pmic_standby_prepare(int extra_map)
+{
+	int i, val;
+
+	axp717_standby_out_saved = false;
+	if (pmic != AXP717 || is_using_rsb())
+		return -ENODEV;
+	/* The bus stays set up for the final write from SRAM. */
+	if (pmic_bus_init(SUNXI_SOC_H616, pmic_bus_addr) != 0)
+		return -EIO;
+
+	if (extra_map < 0)
+		extra_map = AXP717_SLEEP_EXTRA_MAP;
+	/* Never DCDC3 (vdd-dram): it keeps the DRAM in self-refresh. */
+	extra_map &= ~0x04;
+	axp717_standby_extra[0] = extra_map & 0xff;
+	axp717_standby_extra[1] = (extra_map >> 8) & 0xff;
+	val = axp_read(AXP717_DCDC_OUTPUT_CONTROL);
+	if (val < 0)
+		return val;
+	axp717_standby_out[0] = val;
+	val = axp_read(AXP717_LDO0_OUTPUT_CONTROL);
+	if (val < 0)
+		return val;
+	axp717_standby_out[1] = val;
+	val = axp_read(AXP717_LDO1_OUTPUT_CONTROL);
+	if (val < 0)
+		return val;
+	axp717_standby_out[2] = val;
+	axp717_standby_out_saved = true;
+
+	for (i = 0; i < AXP717_IRQ_REGS; i++) {
+		val = axp_read(AXP717_IRQ_EN0 + i);
+		if (val < 0)
+			return val;
+		axp717_standby_saved[i] = val;
+	}
+	val = axp_read(AXP717_SLEEP_CFG);
+	if (val < 0)
+		return val;
+	axp717_standby_saved[AXP717_IRQ_REGS] = val;
+	val = axp_read(AXP717_DCDC1_CONTROL);
+	if (val < 0)
+		return val;
+	axp717_standby_saved[AXP717_IRQ_REGS + 1] = val;
+	val = axp_read(AXP717_DCDC2_CONTROL);
+	if (val < 0)
+		return val;
+	axp717_standby_saved[AXP717_IRQ_REGS + 2] = val;
+
+	for (i = 0; i < AXP717_IRQ_REGS; i++) {
+		uint8_t en = 0;
+
+		if (i == 0)
+			en = AXP717_IRQ0_SOC_DROP_LVL2;
+		else if (i == 1)
+			en = AXP717_IRQ1_PEK_FALLING;
+		if (axp_write(AXP717_IRQ_EN0 + i, en) != 0 ||
+		    axp_write(AXP717_IRQ_STATE0 + i, 0xff) != 0)
+			return -EIO;
+	}
+	for (i = 0; i < 3; i++) {
+		uint8_t map = axp717_sleep_map[i];
+
+		if (i < 2)
+			map |= axp717_standby_extra[i];
+		if (axp_write(AXP717_AUTO_SLP_MAP0 + i, map) != 0)
+			return -EIO;
+	}
+	if (axp_write(AXP717_SLEEP_CFG, AXP717_SLEEP_CFG_ARM) != 0)
+		return -EIO;
+
+	return 0;
+}
+
+/*
+ * The wake-up powers the map rails up again: give the optional ones back
+ * the state Linux left them in (an unused rail stays off).
+ */
+static void axp717_standby_restore_outputs(void)
+{
+	static const uint8_t reg[3] = {
+		AXP717_DCDC_OUTPUT_CONTROL,
+		AXP717_LDO0_OUTPUT_CONTROL,
+		AXP717_LDO1_OUTPUT_CONTROL,
+	};
+	/* Output control bits of the map bits: DCDC1-4 | ALDO1-4 | BLDO1-4
+	 * in 0x80 bits 0-3, 0x90 bits 0-3 and 4-7, CLDO1-4 in 0x91 bits 0-3. */
+	uint8_t mask[3] = {
+		axp717_standby_extra[0] & 0x0f,
+		(axp717_standby_extra[0] >> 4) | (axp717_standby_extra[1] & 0x0f) << 4,
+		axp717_standby_extra[1] >> 4,
+	};
+	int i, val;
+
+	axp717_standby_out_saved = false;
+	for (i = 0; i < 3; i++) {
+		if (mask[i] == 0)
+			continue;
+		val = axp_read(reg[i]);
+		if (val < 0)
+			continue;
+		val = (val & ~mask[i]) | (axp717_standby_out[i] & mask[i]);
+		(void)axp_write(reg[i], val);
+	}
+}
+
+/* Undo sunxi_pmic_standby_prepare(), after a resume or a failed entry. */
+void sunxi_pmic_standby_resume(void)
+{
+	int i;
+
+	if (pmic != AXP717 || is_using_rsb())
+		return;
+	if (pmic_bus_init(SUNXI_SOC_H616, pmic_bus_addr) != 0)
+		return;
+
+	/* Linux's setpoints first, before its clocks are back. */
+	(void)axp_write(AXP717_DCDC2_CONTROL, axp717_standby_saved[AXP717_IRQ_REGS + 2]);
+	(void)axp_write(AXP717_DCDC1_CONTROL, axp717_standby_saved[AXP717_IRQ_REGS + 1]);
+	udelay(AXP717_VDD_CPU_RAMP_US);
+	(void)axp_write(AXP717_SLEEP_CFG, axp717_standby_saved[AXP717_IRQ_REGS]);
+	for (i = 0; i < AXP717_IRQ_REGS; i++)
+		(void)axp_write(AXP717_IRQ_EN0 + i, axp717_standby_saved[i]);
+	if (axp717_standby_out_saved)
+		axp717_standby_restore_outputs();
+}
