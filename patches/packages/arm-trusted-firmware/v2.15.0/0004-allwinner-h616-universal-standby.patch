From: nuubOS Project <noreply@nuubos.invalid>
Subject: [PATCH] allwinner: h616: universal standby (SoC powered off)

Deep sleep (0003) keeps VDD-SYS, the DRAM controller and PLL_DDR running:
~3-4 % battery per hour measured on the RG CubeXX. Like the vendor
sun50iw9 firmware's "super standby" (universal-standby in its DT), this
leaves the DRAM in self-refresh with its pads held (RTC 0x1f4 bit0) and
has the AXP717 switch VDD-CPU (DCDC1), VDD-SYS (DCDC2), VCC-IO (CLDO3)
and the speaker amplifier supply (CLDO1: its enable pin floats with
VCC-IO off and it popped) off in its sleep state (SLEEP_CFG 0x25 = 0x2d, AUTO_SLP_MAP 0x28-0x2a,
then 0x25 = 0x6d written from SRAM once the DRAM is in self-refresh).
The rails still enabled but unused with the SoC off go too, each
qualified alone (DCDC4, ALDO1 HDMI, ALDO4 avcc; not BLDO2 vcc-pll: the
DRAM loses its content without it); their enable bits are written back
as Linux left them on resume.
Only the power key (and a critical battery) wakes the PMIC, which powers
the SoC up again as a cold start: U-Boot SPL resumes the DRAM (its patch
0003) and jumps to sunxi_universal_resume_entry, which re-enters the
PSCI warm boot path.

Saved before and written back after: CCU (PLLs first, U-Boot owns DRAM
and MBUS), PIO and R_PIO, R_PRCM, system control, timers 0/1 (Linux's
broadcast tick waits for timer 1), and, with their bus clock forced on,
the display clocks/mapping/mixer top, TCON TOP, both TCONs (dot clock
divider), PWM (backlight, LED, rumble), GPADC (analog sticks), the audio
codec (mixer controls: the speaker was silent after a wake) and the
IOMMU (programmed like sun50i_iommu_enable(), enable last). Then the
security setup, the CPU entry points, the CPUIDLE controller and the GIC
distributor are set up again; the NMI (PMIC IRQ line) is re-armed by
writing its pending bit, as Linux's sunxi-nmi does at probe (without it
no PMIC interrupt reached Linux: the power key stopped working), and the
EINT status latched while the pins were restored is cleared (Linux read
those edges as key presses: a Confirm launched a game). The resume block
(entry point, the two 4 KiB DRAM areas the training overwrites,
checksum) lies past BL31 in its reserved region; BL31 maps it and the
DRAM half.

Falls back to deep sleep when U-Boot published no DRAM state, the PMIC
cannot be armed or the DRAM does not enter self-refresh. RTC GP5, written
by nuubos-suspend before each suspend, selects the mode: 0x5170c0de =
quick resume (deep sleep: the SoC stays powered, START and a lid wake it
too), 0x57d0057d = watchdog reset instead of the PMIC sleep (development
aid), 0x5a3eNNNN = universal standby with NNNN as the optional rail set
(development aid), anything else = universal standby. RTC GP6 holds the last step
(0x5a5a002N entry, 0x3N resume).

Signed-off-by: nuubOS Project <noreply@nuubos.invalid>
---
--- a/plat/allwinner/common/include/platform_def.h
+++ b/plat/allwinner/common/include/platform_def.h
@@ -18,7 +18,8 @@
 #define BL31_BASE			SUNXI_DRAM_BASE
 #define BL31_LIMIT			(SUNXI_DRAM_BASE + 0x40000)
 
-#define MAX_XLAT_TABLES			4
+/* +1: the universal standby resume mappings (sunxi_native_pm.c). */
+#define MAX_XLAT_TABLES			5
 #define PLAT_VIRT_ADDR_SPACE_SIZE	(1ULL << 32)
 
 #define SUNXI_BL33_VIRT_BASE		PRELOADED_BL33_BASE
@@ -52,7 +53,8 @@
 #define CACHE_WRITEBACK_GRANULE		(1 << CACHE_WRITEBACK_SHIFT)
 
 #define MAX_STATIC_MMAP_REGIONS		3
-#define MAX_MMAP_REGIONS		(5 + MAX_STATIC_MMAP_REGIONS)
+/* +2: the universal standby resume block and DRAM half (H616). */
+#define MAX_MMAP_REGIONS		(7 + MAX_STATIC_MMAP_REGIONS)
 
 #define PLAT_CSS_SCP_COM_SHARED_MEM_BASE \
 	(SUNXI_SRAM_A2_BASE + SUNXI_SRAM_A2_SIZE - 0x200)
--- a/plat/allwinner/common/include/sunxi_private.h
+++ b/plat/allwinner/common/include/sunxi_private.h
@@ -25,6 +25,10 @@
 #ifdef PLAT_sun50i_h616
 int sunxi_pmic_vdd_cpu_suspend(void);
 void sunxi_pmic_vdd_cpu_resume(int saved);
+int sunxi_pmic_standby_prepare(int extra_map);
+void sunxi_pmic_standby_resume(void);
+void sunxi_program_rvbar(void);
+void sunxi_resume_mmap(void);
 #endif
 
 #if SUNXI_PSCI_USE_NATIVE
--- a/plat/allwinner/common/sunxi_common.c
+++ b/plat/allwinner/common/sunxi_common.c
@@ -56,6 +56,9 @@
 #endif
 
 	mmap_add(sunxi_mmap);
+#ifdef PLAT_sun50i_h616
+	sunxi_resume_mmap();
+#endif
 	init_xlat_tables();
 
 	enable_mmu_el3(0);
--- a/plat/allwinner/common/sunxi_native_pm.c
+++ b/plat/allwinner/common/sunxi_native_pm.c
@@ -7,11 +7,14 @@
 #include <string.h>
 
 #include <arch_helpers.h>
+#include <common/bl_common.h>
 #include <common/debug.h>
 #include <drivers/arm/gicv2.h>
 #include <drivers/delay_timer.h>
 #include <lib/mmio.h>
 #include <lib/psci/psci.h>
+#include <lib/xlat_tables/xlat_tables_v2.h>
+#include <platform_def.h>
 
 #include <sunxi_mmap.h>
 #include <sunxi_private.h>
@@ -56,6 +59,470 @@
 /* RTC general purpose register 5: VDD-CPU step result, for diagnosis. */
 #define SUNXI_SUSPEND_VDD_REG		0x07000114
 
+/*
+ * Universal standby (the vendor "super standby", user request 2026-10-22:
+ * sleep must cost a few tenths of a percent per hour at most). Deep sleep
+ * above keeps the SoC powered (~3-4 %/h measured on the CubeXX): here the
+ * DRAM stays in self-refresh with its pads held and the PMIC switches
+ * VDD-CPU, VDD-SYS and VCC-IO off. Only a PMIC IRQ (the power key, a
+ * critical battery) powers the SoC up again, as a cold start: U-Boot SPL
+ * finds SUNXI_RESUME_FLAG, resumes the DRAM with the geometry of the last
+ * cold boot, puts back the two DRAM areas its training overwrites (saved
+ * here in the resume block) and jumps to sunxi_universal_resume_entry,
+ * which re-enters the PSCI warm boot path. Everything VDD-SYS held that
+ * Linux expects to find again (clocks, pin setup, PRCM, system control)
+ * is saved here and written back in sunxi_pwr_domain_suspend_finish(),
+ * then the GIC, the security setup, the CPU entry points and the CPUIDLE
+ * controller are set up again. Linux saves and restores the GIC
+ * distributor itself (CPU cluster PM notifiers).
+ */
+#define SUNXI_RESUME_FLAG_REG		0x07000100	/* RTC GP0 */
+#define SUNXI_RESUME_FLAG_MAGIC		0x4e555352	/* "NUSR" */
+#define SUNXI_RESUME_GEOMETRY_REG	0x07000110	/* RTC GP4, U-Boot */
+#define SUNXI_RESUME_SIZE_REG		0x0700011c	/* RTC GP7, MiB */
+/* RTC GP5, written by nuubos-suspend before each suspend: the sleep mode.
+ * SUNXI_RESUME_MODE_QUICK keeps the SoC powered (deep sleep: START and a
+ * lid wake it too); SUNXI_RESUME_TEST_WDOG (development aid) resets with
+ * the watchdog instead of the PMIC sleep, so the resume path runs without
+ * anyone pressing the power key; SUNXI_RESUME_TEST_MAP | map (development
+ * aid) is the universal standby with the low 16 bits as the optional rail
+ * set (AUTO_SLP_MAP 0 | 1 << 8, sunxi_power.c) instead of the default;
+ * anything else is the universal standby. */
+#define SUNXI_RESUME_TEST_REG		0x07000114
+#define SUNXI_RESUME_MODE_QUICK		0x5170c0de
+#define SUNXI_RESUME_TEST_WDOG		0x57d0057d
+#define SUNXI_RESUME_TEST_MAP		0x5a3e0000
+/* RTC GP6: standby/resume step, shared with the SRAM code and U-Boot. */
+#define SUNXI_RESUME_STEP_REG		0x07000118
+#define SUNXI_RESUME_BLOCK		0x4003c000UL
+#define SUNXI_RESUME_BLOCK_MAGIC	0x4e55424c	/* "NUBL" */
+#define SUNXI_RESUME_SAVE_SIZE		0x1000
+
+struct sunxi_resume_block {
+	uint32_t magic;
+	uint32_t entry_lo;
+	uint32_t entry_hi;
+	uint32_t half;
+	uint32_t checksum;
+};
+
+extern const char sunxi_universal_sram[], sunxi_universal_sram_end[];
+int sunxi_universal_suspend_wfi(uintptr_t sram_entry, unsigned long mode);
+void sunxi_universal_resume_entry(void);
+
+#define SUNXI_CCU_PLL_DDR0		0x010
+#define SUNXI_CCU_PLL_DDR1		0x018
+#define SUNXI_CCU_PLL_DDR0_PAT		0x110
+#define SUNXI_CCU_PLL_DDR1_PAT		0x118
+#define SUNXI_CCU_MBUS			0x540
+#define SUNXI_CCU_DRAM_CLK		0x800
+#define SUNXI_CCU_DRAM_BGR		0x80c
+#define SUNXI_CCU_SEC_SWITCH		0xf00
+#define SUNXI_PIO_BANKS			9
+#define SUNXI_PIO_BANK_SIZE		0x24
+#define SUNXI_PIO_EINT_BASE		0x200
+#define SUNXI_PIO_EINT_SIZE		0x20
+#define SUNXI_PIO_EINT_STATUS		0x14
+#define SUNXI_PIO_POW_BASE		0x340
+#define SUNXI_R_PRCM_NMI_PENDING	0x324
+#define SUNXI_R_PRCM_SEC_SWITCH		0x290
+
+static uint32_t sunxi_saved_ccu[0x1000 / 4];
+static uint32_t sunxi_saved_pio[0x400 / 4];
+static uint32_t sunxi_saved_r_pio[0x400 / 4];
+static uint32_t sunxi_saved_r_prcm[0x400 / 4];
+static uint32_t sunxi_saved_syscon[0x100 / 4];
+/* Timers 0 and 1 (Linux's broadcast tick and its free-running reference:
+ * sun4i-timer waits for timer 1 to move); the watchdog after them is not
+ * part of it. */
+#define SUNXI_TIMER_BASE		0x03009000
+#define SUNXI_TIMER_IRQ_EN		0x00
+#define SUNXI_TIMER_CTL(n)		(0x10 * ((n) + 1))
+#define SUNXI_TIMER_INTV(n)		(0x10 * ((n) + 1) + 4)
+#define SUNXI_TIMER_CTL_ENABLE		BIT(0)
+#define SUNXI_TIMER_CTL_RELOAD		BIT(1)
+static uint32_t sunxi_saved_timer[0x30 / 4];
+
+/*
+ * Display and IOMMU state Linux sets up once when its drivers bind (DE33
+ * clock gates/resets, channel/port mapping and mixer top: display_clocks
+ * at 0x1008000; TCON TOP muxes; TCON dot clock dividers) and the IOMMU
+ * programming. Read and
+ * written with the block's bus clock forced on (an access to a gated
+ * display block can stall the bus).
+ */
+struct sunxi_gated_block {
+	uintptr_t base;
+	unsigned int size;
+	unsigned int bgr;	/* CCU bus gate (bit 0) / reset (bit 16) */
+	unsigned int mod;	/* CCU module clock (bit 31), 0 if none */
+	uint32_t *buf;
+};
+
+static uint32_t sunxi_saved_de[0x200 / 4];
+static uint32_t sunxi_saved_tcon_top[0x40 / 4];
+static uint32_t sunxi_saved_iommu[0x110 / 4];
+/* TCONs: their dot clock divider (TCON0_DCLK) lives here, and Linux's
+ * clock framework does not write it again for an unchanged rate. */
+static uint32_t sunxi_saved_tcon_lcd0[0x200 / 4];
+static uint32_t sunxi_saved_tcon_tv0[0x200 / 4];
+/* PWM (backlight, power LED, rumble): the PWM core does not write a state
+ * it already applied, so a channel would stay at its reset value. */
+#define SUNXI_PWM_BASE			0x0300a000
+#define SUNXI_PWM_PER			0x40
+static uint32_t sunxi_saved_pwm[0x140 / 4];
+/* GPADC (analog sticks): mode and calibration set at probe only. Only its
+ * configuration registers, never status or data. */
+#define SUNXI_GPADC_BASE		0x05070000
+static uint32_t sunxi_saved_gpadc[0x80 / 4];
+/* Audio codec: Linux writes its mixer controls (DAC and Line Out volume
+ * and switches, routes) only when they change, and its regmap has no
+ * cache to sync: without this the speaker stayed silent. Never the FIFO
+ * status, TX data or sample counter. */
+#define SUNXI_CODEC_BASE		0x05096000
+#define SUNXI_CODEC_DAC_DPC		0x000
+#define SUNXI_CODEC_DAC_FIFOC		0x010
+#define SUNXI_CODEC_ANALOG		0x300
+static uint32_t sunxi_saved_codec[0x320 / 4];
+
+static const struct sunxi_gated_block sunxi_gated_blocks[] = {
+	{ 0x01008000, sizeof(sunxi_saved_de), 0x60c, 0x600, sunxi_saved_de },
+	{ 0x06510000, sizeof(sunxi_saved_tcon_top), 0xb5c, 0, sunxi_saved_tcon_top },
+	{ 0x06511000, sizeof(sunxi_saved_tcon_lcd0), 0xb7c, 0xb60, sunxi_saved_tcon_lcd0 },
+	{ 0x06515000, sizeof(sunxi_saved_tcon_tv0), 0xb9c, 0, sunxi_saved_tcon_tv0 },
+	{ SUNXI_PWM_BASE, sizeof(sunxi_saved_pwm), 0x7ac, 0, sunxi_saved_pwm },
+	{ SUNXI_GPADC_BASE, sizeof(sunxi_saved_gpadc), 0x9ec, 0, sunxi_saved_gpadc },
+	{ SUNXI_CODEC_BASE, sizeof(sunxi_saved_codec), 0xa5c, 0, sunxi_saved_codec },
+	{ 0x030f0000, sizeof(sunxi_saved_iommu), 0x7bc, 0, sunxi_saved_iommu },
+};
+
+#define SUNXI_IOMMU_BASE		0x030f0000
+#define SUNXI_IOMMU_ENABLE		0x020
+#define SUNXI_IOMMU_TLB_FLUSH		0x080
+#define SUNXI_IOMMU_TLB_FLUSH_ALL	0x3003f
+
+static void sunxi_block_save(uintptr_t base, uint32_t *buf, unsigned int size);
+
+static void sunxi_block_clock_on(const struct sunxi_gated_block *b)
+{
+	mmio_setbits_32(SUNXI_CCU_BASE + b->bgr, BIT(16) | BIT(0));
+	if (b->mod)
+		mmio_setbits_32(SUNXI_CCU_BASE + b->mod, BIT(31));
+	dsbsy();
+	udelay(1);
+}
+
+static void sunxi_block_clock_back(const struct sunxi_gated_block *b)
+{
+	if (b->mod)
+		mmio_write_32(SUNXI_CCU_BASE + b->mod, sunxi_saved_ccu[b->mod / 4]);
+	mmio_write_32(SUNXI_CCU_BASE + b->bgr, sunxi_saved_ccu[b->bgr / 4]);
+	dsbsy();
+}
+
+/* The IOMMU as sun50i_iommu_enable() programs it, enable last. */
+static void sunxi_iommu_restore(void)
+{
+	const uint32_t *r = sunxi_saved_iommu;
+	unsigned int off, us;
+
+	if ((r[SUNXI_IOMMU_ENABLE / 4] & BIT(0)) == 0)
+		return;
+	for (off = 0x030; off <= 0x070; off += 4)
+		if (off != SUNXI_IOMMU_ENABLE)
+			mmio_write_32(SUNXI_IOMMU_BASE + off, r[off / 4]);
+	for (off = 0x0b0; off <= 0x0d0; off += 4)
+		mmio_write_32(SUNXI_IOMMU_BASE + off, r[off / 4]);
+	mmio_write_32(SUNXI_IOMMU_BASE + 0x100, r[0x100 / 4]);
+	mmio_write_32(SUNXI_IOMMU_BASE + SUNXI_IOMMU_TLB_FLUSH, SUNXI_IOMMU_TLB_FLUSH_ALL);
+	for (us = 0; us < 2000; us++) {
+		if (mmio_read_32(SUNXI_IOMMU_BASE + SUNXI_IOMMU_TLB_FLUSH) == 0)
+			break;
+		udelay(1);
+	}
+	mmio_write_32(SUNXI_IOMMU_BASE + SUNXI_IOMMU_ENABLE, r[SUNXI_IOMMU_ENABLE / 4]);
+}
+
+static void sunxi_gated_save(void)
+{
+	for (unsigned int i = 0; i < ARRAY_SIZE(sunxi_gated_blocks); i++) {
+		const struct sunxi_gated_block *b = &sunxi_gated_blocks[i];
+
+		sunxi_block_clock_on(b);
+		sunxi_block_save(b->base, b->buf, b->size);
+		sunxi_block_clock_back(b);
+	}
+}
+
+static void sunxi_gated_restore(void)
+{
+	for (unsigned int i = 0; i < ARRAY_SIZE(sunxi_gated_blocks); i++) {
+		const struct sunxi_gated_block *b = &sunxi_gated_blocks[i];
+
+		sunxi_block_clock_on(b);
+		if (b->base == SUNXI_IOMMU_BASE) {
+			sunxi_iommu_restore();
+		} else if (b->base == SUNXI_GPADC_BASE) {
+			for (unsigned int off = 0x04; off <= 0x28; off += 4)
+				if (off != 0x10 && off != 0x14 && off != 0x18)
+					mmio_write_32(b->base + off, b->buf[off / 4]);
+			for (unsigned int off = 0x40; off < b->size; off += 4)
+				mmio_write_32(b->base + off, b->buf[off / 4]);
+		} else if (b->base == SUNXI_CODEC_BASE) {
+			/* Analog path first, the digital DAC enable last. */
+			for (unsigned int off = SUNXI_CODEC_ANALOG; off < b->size; off += 4)
+				mmio_write_32(b->base + off, b->buf[off / 4]);
+			mmio_write_32(b->base + 0x004, b->buf[0x004 / 4]);
+			mmio_write_32(b->base + SUNXI_CODEC_DAC_FIFOC,
+				      b->buf[SUNXI_CODEC_DAC_FIFOC / 4] & ~BIT(0));
+			mmio_write_32(b->base + 0x028, b->buf[0x028 / 4]);
+			mmio_write_32(b->base + 0x0f0, b->buf[0x0f0 / 4]);
+			mmio_write_32(b->base + SUNXI_CODEC_DAC_DPC,
+				      b->buf[SUNXI_CODEC_DAC_DPC / 4]);
+		} else if (b->base == SUNXI_PWM_BASE) {
+			/* Not the interrupt status; the channel enables last. */
+			for (unsigned int off = 0; off < b->size; off += 4)
+				if (off != 0x04 && off != 0x14 && off != SUNXI_PWM_PER)
+					mmio_write_32(b->base + off, b->buf[off / 4]);
+			mmio_write_32(b->base + SUNXI_PWM_PER, b->buf[SUNXI_PWM_PER / 4]);
+		} else {
+			for (unsigned int off = 0; off < b->size; off += 4)
+				mmio_write_32(b->base + off, b->buf[off / 4]);
+		}
+		sunxi_block_clock_back(b);
+	}
+}
+static bool sunxi_universal_resumed;
+
+static void sunxi_block_save(uintptr_t base, uint32_t *buf, unsigned int size)
+{
+	for (unsigned int off = 0; off < size; off += 4)
+		buf[off / 4] = mmio_read_32(base + off);
+}
+
+static void sunxi_pll_restore(unsigned int off)
+{
+	uint32_t val = sunxi_saved_ccu[off / 4];
+	unsigned int us;
+
+	mmio_write_32(SUNXI_CCU_BASE + off, val);
+	if ((val & BIT(31)) == 0)
+		return;
+	for (us = 0; us < SUNXI_PLL_LOCK_TIMEOUT_US; ++us) {
+		if ((mmio_read_32(SUNXI_CCU_BASE + off) & SUNXI_PLL_LOCK) != 0)
+			break;
+		udelay(1);
+	}
+}
+
+/* Pin controller: I/O voltages, then levels/drive/pulls, then functions,
+ * then the external interrupt setup (never its write-1-to-clear status). */
+static void sunxi_pio_restore(uintptr_t base, const uint32_t *buf)
+{
+	unsigned int b, off;
+
+	for (off = SUNXI_PIO_POW_BASE; off < 0x400; off += 4)
+		mmio_write_32(base + off, buf[off / 4]);
+	for (b = 0; b < SUNXI_PIO_BANKS; b++)
+		for (off = 0x10; off < SUNXI_PIO_BANK_SIZE; off += 4)
+			mmio_write_32(base + b * SUNXI_PIO_BANK_SIZE + off,
+				      buf[(b * SUNXI_PIO_BANK_SIZE + off) / 4]);
+	for (b = 0; b < SUNXI_PIO_BANKS; b++)
+		for (off = 0; off < 0x10; off += 4)
+			mmio_write_32(base + b * SUNXI_PIO_BANK_SIZE + off,
+				      buf[(b * SUNXI_PIO_BANK_SIZE + off) / 4]);
+	for (off = SUNXI_PIO_EINT_BASE; off < SUNXI_PIO_POW_BASE; off += 4)
+		if ((off - SUNXI_PIO_EINT_BASE) % SUNXI_PIO_EINT_SIZE !=
+		    SUNXI_PIO_EINT_STATUS)
+			mmio_write_32(base + off, buf[off / 4]);
+	/*
+	 * Edges latched while the pins went from their reset state back to
+	 * their functions are not key presses: Linux would read them as
+	 * such (a Confirm launched a game, START looked like the wake key).
+	 */
+	for (b = 0; b < SUNXI_PIO_BANKS; b++)
+		mmio_write_32(base + SUNXI_PIO_EINT_BASE + b * SUNXI_PIO_EINT_SIZE +
+			      SUNXI_PIO_EINT_STATUS, 0xffffffffU);
+}
+
+static void sunxi_soc_save(void)
+{
+	sunxi_block_save(SUNXI_CCU_BASE, sunxi_saved_ccu, sizeof(sunxi_saved_ccu));
+	sunxi_block_save(SUNXI_PIO_BASE, sunxi_saved_pio, sizeof(sunxi_saved_pio));
+	sunxi_block_save(SUNXI_R_PIO_BASE, sunxi_saved_r_pio, sizeof(sunxi_saved_r_pio));
+	sunxi_block_save(SUNXI_R_PRCM_BASE, sunxi_saved_r_prcm, sizeof(sunxi_saved_r_prcm));
+	sunxi_block_save(SUNXI_SYSCON_BASE, sunxi_saved_syscon, sizeof(sunxi_saved_syscon));
+	sunxi_block_save(SUNXI_TIMER_BASE, sunxi_saved_timer, sizeof(sunxi_saved_timer));
+	sunxi_gated_save();
+}
+
+static void sunxi_timer_restore(void)
+{
+	for (unsigned int n = 0; n < 2; n++) {
+		uint32_t ctl = sunxi_saved_timer[SUNXI_TIMER_CTL(n) / 4];
+
+		mmio_write_32(SUNXI_TIMER_BASE + SUNXI_TIMER_INTV(n),
+			      sunxi_saved_timer[SUNXI_TIMER_INTV(n) / 4]);
+		mmio_write_32(SUNXI_TIMER_BASE + SUNXI_TIMER_CTL(n),
+			      ctl & ~SUNXI_TIMER_CTL_ENABLE);
+		if (ctl & SUNXI_TIMER_CTL_ENABLE)
+			mmio_write_32(SUNXI_TIMER_BASE + SUNXI_TIMER_CTL(n),
+				      ctl | SUNXI_TIMER_CTL_RELOAD |
+				      SUNXI_TIMER_CTL_ENABLE);
+	}
+	mmio_write_32(SUNXI_TIMER_BASE + SUNXI_TIMER_IRQ_EN,
+		      sunxi_saved_timer[SUNXI_TIMER_IRQ_EN / 4]);
+}
+
+static void sunxi_soc_restore(void)
+{
+	uint32_t cpux_axi = sunxi_saved_ccu[0x500 / 4];
+	unsigned int off;
+
+	for (off = 0; off < sizeof(sunxi_saved_syscon); off += 4)
+		mmio_write_32(SUNXI_SYSCON_BASE + off, sunxi_saved_syscon[off / 4]);
+
+	/* PLLs first (U-Boot owns PLL_DDR), CPU 0 on OSC24M meanwhile. */
+	mmio_write_32(SUNXI_CCU_CPUX_AXI_REG, cpux_axi & ~SUNXI_CPUX_SRC_MASK);
+	dsbsy();
+	isb();
+	for (off = 0x100; off < 0x400; off += 4)
+		if (off != SUNXI_CCU_PLL_DDR0_PAT && off != SUNXI_CCU_PLL_DDR1_PAT &&
+		    (off < 0x200 || off >= 0x300))
+			mmio_write_32(SUNXI_CCU_BASE + off, sunxi_saved_ccu[off / 4]);
+	for (off = 0; off < 0x100; off += 4)
+		if (off != SUNXI_CCU_PLL_DDR0 && off != SUNXI_CCU_PLL_DDR1)
+			sunxi_pll_restore(off);
+	udelay(20);
+	/* Buses, module clocks, gates and resets. */
+	for (off = 0x500; off < sizeof(sunxi_saved_ccu); off += 4)
+		if (off != SUNXI_CCU_MBUS && off != SUNXI_CCU_DRAM_CLK &&
+		    off != SUNXI_CCU_DRAM_BGR && off != SUNXI_CCU_SEC_SWITCH)
+			mmio_write_32(SUNXI_CCU_BASE + off, sunxi_saved_ccu[off / 4]);
+	dsbsy();
+	isb();
+
+	for (off = 0; off < sizeof(sunxi_saved_r_prcm); off += 4)
+		if (off != SUNXI_R_PRCM_NMI_PENDING && off != SUNXI_R_PRCM_SEC_SWITCH)
+			mmio_write_32(SUNXI_R_PRCM_BASE + off, sunxi_saved_r_prcm[off / 4]);
+	/*
+	 * The NMI (PMIC IRQ line) latches nothing after a cold start until
+	 * its pending bit is written, as Linux's sunxi-nmi does at probe:
+	 * without this no PMIC interrupt (power key, charger, battery)
+	 * reached Linux after a resume.
+	 */
+	mmio_write_32(SUNXI_R_PRCM_BASE + SUNXI_R_PRCM_NMI_PENDING, 1);
+	sunxi_pio_restore(SUNXI_R_PIO_BASE, sunxi_saved_r_pio);
+	sunxi_pio_restore(SUNXI_PIO_BASE, sunxi_saved_pio);
+	sunxi_timer_restore();
+	sunxi_gated_restore();
+	dsbsy();
+}
+
+static uint32_t sunxi_resume_sum(const struct sunxi_resume_block *blk)
+{
+	const uint32_t *w = (const uint32_t *)(SUNXI_RESUME_BLOCK + SUNXI_RESUME_SAVE_SIZE);
+	uint32_t sum = blk->magic + blk->entry_lo + blk->entry_hi + blk->half;
+
+	for (unsigned int i = 0; i < 2 * SUNXI_RESUME_SAVE_SIZE / 4; i++)
+		sum += w[i];
+	return sum;
+}
+
+/*
+ * BL31 maps only its own image and the BL33 window: the resume block past
+ * it and the start of the DRAM half (Linux memory, a 2 MiB block) need
+ * mappings of their own. U-Boot published the DRAM size before BL31 ran.
+ */
+void sunxi_resume_mmap(void)
+{
+	uint32_t size_mib = mmio_read_32(SUNXI_RESUME_SIZE_REG);
+	uintptr_t half = SUNXI_DRAM_BASE + ((uintptr_t)size_mib << 19);
+
+	mmap_add_region(SUNXI_RESUME_BLOCK, SUNXI_RESUME_BLOCK,
+			3 * SUNXI_RESUME_SAVE_SIZE, MT_RW_DATA | MT_SECURE);
+	if (size_mib >= 128 && size_mib <= 4096 && !(size_mib & (size_mib - 1)))
+		mmap_add_region(half, half, 2U << 20, MT_RW_DATA | MT_NS);
+	else
+		mmio_write_32(SUNXI_RESUME_SIZE_REG, 0);
+}
+
+/* Returns only when the universal standby could not be entered. */
+static void sunxi_universal_suspend(void)
+{
+	struct sunxi_resume_block *blk = (void *)SUNXI_RESUME_BLOCK;
+	uint32_t size_mib = mmio_read_32(SUNXI_RESUME_SIZE_REG);
+	size_t size = sunxi_universal_sram_end - sunxi_universal_sram;
+	uintptr_t entry = (uintptr_t)sunxi_universal_resume_entry;
+	unsigned long mode;
+	int extra_map = -1;
+
+	/* The resume block lies past BL31, inside its reserved region. */
+	if (BL31_END > SUNXI_RESUME_BLOCK ||
+	    SUNXI_RESUME_BLOCK + 3 * SUNXI_RESUME_SAVE_SIZE > BL31_LIMIT)
+		return;
+	/* Needs a U-Boot that published the DRAM state at its cold boot. */
+	if (size_mib < 128 || size_mib > 4096 || (size_mib & (size_mib - 1)) ||
+	    (mmio_read_32(SUNXI_RESUME_GEOMETRY_REG) & 0xff) == 0)
+		return;
+	mode = mmio_read_32(SUNXI_RESUME_TEST_REG);
+	mmio_write_32(SUNXI_RESUME_TEST_REG, 0);
+	if (mode == SUNXI_RESUME_MODE_QUICK)
+		return;
+	if ((mode & 0xffff0000U) == SUNXI_RESUME_TEST_MAP)
+		extra_map = mode & 0xffffU;
+	mode = mode == SUNXI_RESUME_TEST_WDOG;
+
+	if (sunxi_pmic_standby_prepare(extra_map) != 0) {
+		sunxi_pmic_standby_resume();
+		return;
+	}
+	sunxi_soc_save();
+
+	/* The data cache is off: all of this goes straight to DRAM. */
+	blk->magic = SUNXI_RESUME_BLOCK_MAGIC;
+	blk->entry_lo = entry & 0xffffffffU;
+	blk->entry_hi = (uint64_t)entry >> 32;
+	blk->half = SUNXI_DRAM_BASE + (size_mib << 19);
+	memcpy((void *)(SUNXI_RESUME_BLOCK + SUNXI_RESUME_SAVE_SIZE),
+	       (void *)SUNXI_DRAM_BASE, SUNXI_RESUME_SAVE_SIZE);
+	memcpy((void *)(SUNXI_RESUME_BLOCK + 2 * SUNXI_RESUME_SAVE_SIZE),
+	       (void *)(uintptr_t)blk->half, SUNXI_RESUME_SAVE_SIZE);
+	blk->checksum = sunxi_resume_sum(blk);
+	sunxi_universal_resumed = true;
+	memcpy((void *)SUNXI_STANDBY_SRAM_BASE, sunxi_universal_sram, size);
+	mmio_write_32(SUNXI_RESUME_FLAG_REG, SUNXI_RESUME_FLAG_MAGIC);
+	dsbsy();
+
+	(void)sunxi_universal_suspend_wfi(SUNXI_STANDBY_SRAM_BASE, mode);
+
+	/* The DRAM never entered self-refresh: plain deep sleep instead. */
+	mmio_write_32(SUNXI_RESUME_FLAG_REG, 0);
+	sunxi_universal_resumed = false;
+	blk->magic = 0;
+	sunxi_pmic_standby_resume();
+}
