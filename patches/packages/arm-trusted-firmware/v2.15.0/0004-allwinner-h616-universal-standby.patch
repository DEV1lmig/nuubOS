+/*
+ * Universal standby (see sunxi_native_pm.c): SRAM part.
+ *
+ * int sunxi_universal_sram(unsigned long mode)
+ *
+ * Copied to SRAM A1 and run with the MMU and the data cache off, no
+ * stack. Puts the DRAM in self-refresh, holds its pads (RTC 0x1f4 bit0
+ * clear), takes the PHY out of DFI operation like the vendor firmware,
+ * then, mode 0, writes AXP717 SLEEP_CFG = 0x6d over R_I2C (set up by
+ * sunxi_pmic_standby_prepare()): the PMIC switches VDD-CPU/VDD-SYS off
+ * and this never returns. Mode 1 (test), or a PMIC that did not cut the
+ * power within 3 s, resets the SoC with the watchdog instead: the DRAM
+ * stays held and the SPL resumes it the same way. Returns 1 only if the
+ * DRAM never entered self-refresh (nothing changed then).
+ */
+#define DRAM_PAD_HOLD_REG	0x070001f4
+#define CTL_DFIMISC		0x1b0
+#define CTL_DFISTAT		0x1bc
+#define CTL_SWCTL		0x320
+#define TWI_DATA		0x08
+#define TWI_CNTR		0x0c
+#define TWI_STAT		0x10
+#define TWI_CNTR_IFLG		(1 << 3)
+#define TWI_CNTR_STOP		(1 << 4)
+#define TWI_CNTR_START		(1 << 5)
+#define TWI_STAT_START		0x08
+#define TWI_STAT_ADDR_W_ACK	0x18
+#define TWI_STAT_DATA_W_ACK	0x28
+#define AXP717_I2C_WRITE	(0x34 << 1)
+#define AXP717_SLEEP_CFG_REG	0x25
+#define AXP717_SLEEP_ENTER	0x6d
+#define WDOG_CFG_REG		(SUNXI_WDOG_BASE + 0x14)
+#define WDOG_MODE_REG		(SUNXI_WDOG_BASE + 0x18)
+/* 2 ms of the 24 MHz counter per I2C step, 3 s for the power to go. */
+#define TWI_TIMEOUT		48000
+#define POWER_OFF_TIMEOUT	72000000
+
+	/* Wait for the TWI interrupt flag, then check the status (w4). */
+	.macro	twi_wait _status
+	mrs	x2, cntpct_el0
+	mov_imm	x3, TWI_TIMEOUT
+	add	x2, x2, x3
+.Ltwi_poll\@:
+	ldr	w1, [x9, #TWI_CNTR]
+	tbnz	w1, #3, .Ltwi_flag\@
+	mrs	x3, cntpct_el0
+	cmp	x3, x2
