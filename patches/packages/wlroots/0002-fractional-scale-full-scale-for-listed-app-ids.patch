From: nuubOS <nuubos@localhost>
Subject: [PATCH] fractional-scale: full output scale for listed app_ids

The HDMI cap of patch 0001 (NUUBOS_CLIENT_MAX_LINES) is right for the
UI and games, which the display engine scales up, but the media video
player then drew 1080p video into a 1280x720 buffer. Surfaces whose
xdg-toplevel app_id is listed in NUUBOS_CLIENT_FULL_SCALE_APP_IDS (space
separated) get the output's own scale: a native-resolution buffer, still
scanned out directly. The scene re-evaluates on output enter, after the
first commit has set the app_id.

Signed-off-by: nuubOS
---
--- a/include/wlr/types/wlr_fractional_scale_v1.h
+++ b/include/wlr/types/wlr_fractional_scale_v1.h
@@ -35,6 +35,16 @@
  */
 double wlr_fractional_scale_v1_output_scale(struct wlr_output *output);
 
+/**
+ * nuubOS: the scale to suggest to this surface on this output. The capped
+ * wlr_fractional_scale_v1_output_scale(), except for surfaces whose
+ * xdg-toplevel app_id is listed (space separated) in
+ * NUUBOS_CLIENT_FULL_SCALE_APP_IDS: they get output->scale, i.e. a buffer
+ * at the output's native resolution (the video player on 1080p HDMI).
+ */
+double wlr_fractional_scale_v1_surface_output_scale(struct wlr_surface *surface,
+		struct wlr_output *output);
+
 void wlr_fractional_scale_v1_notify_scale(
 		struct wlr_surface *surface, double scale);
 
--- a/types/scene/surface.c
+++ b/types/scene/surface.c
@@ -17,8 +17,10 @@
 	double scale = 0;
 	struct wlr_surface_output *surface_output;
 	wl_list_for_each(surface_output, &surface->current_outputs, link) {
-		/* nuubOS: capped on HDMI (NUUBOS_CLIENT_MAX_LINES) */
-		double output_scale = wlr_fractional_scale_v1_output_scale(surface_output->output);
+		/* nuubOS: capped on HDMI (NUUBOS_CLIENT_MAX_LINES) unless the
+		 * app_id is in NUUBOS_CLIENT_FULL_SCALE_APP_IDS */
+		double output_scale = wlr_fractional_scale_v1_surface_output_scale(
+			surface, surface_output->output);
 		if (output_scale > scale) {
 			scale = output_scale;
 		}
--- a/types/wlr_fractional_scale_v1.c
+++ b/types/wlr_fractional_scale_v1.c
@@ -4,6 +4,7 @@
 #include <wlr/types/wlr_compositor.h>
 #include <wlr/types/wlr_fractional_scale_v1.h>
 #include <wlr/types/wlr_output.h>
+#include <wlr/types/wlr_xdg_shell.h>
 #include <wlr/util/log.h>
 
 #include "fractional-scale-v1-protocol.h"
@@ -92,6 +93,38 @@
 	return scale;
 }
 
+static bool app_id_has_full_scale(const char *app_id) {
+	static const char *list = NULL;
+	static bool loaded = false;
+	if (!loaded) {
+		list = getenv("NUUBOS_CLIENT_FULL_SCALE_APP_IDS");
+		loaded = true;
+	}
+	if (list == NULL || app_id == NULL || app_id[0] == '\0') {
+		return false;
+	}
+	size_t len = strlen(app_id);
+	for (const char *p = list; *p != '\0';) {
+		p += strspn(p, " ");
+		size_t word = strcspn(p, " ");
+		if (word == len && strncmp(p, app_id, len) == 0) {
+			return true;
+		}
+		p += word;
+	}
+	return false;
+}
+
+double wlr_fractional_scale_v1_surface_output_scale(struct wlr_surface *surface,
+		struct wlr_output *output) {
+	struct wlr_xdg_toplevel *toplevel = wlr_xdg_toplevel_try_from_wlr_surface(
+		wlr_surface_get_root_surface(surface));
+	if (toplevel != NULL && app_id_has_full_scale(toplevel->app_id)) {
+		return output->scale;
+	}
+	return wlr_fractional_scale_v1_output_scale(output);
+}
+
 static uint32_t double_to_v120(double d) {
 	return round(d * 120);
 }
