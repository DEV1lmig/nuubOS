diff --git a/package/libkrb5/libkrb5.mk b/package/libkrb5/libkrb5.mk
index 6bf08a2516..05d68165fc 100644
--- a/package/libkrb5/libkrb5.mk
+++ b/package/libkrb5/libkrb5.mk
@@ -57,12 +57,15 @@ else
 LIBKRB5_CONF_OPTS += --without-ldap
 endif
 
+# nuubOS: PKINIT (smart card / certificate preauth) and the k5tls plugin
+# (KDC over an HTTPS proxy) do not build with OpenSSL 4 (opaque
+# ASN1_STRING, const X509 names) and are not needed.
 ifeq ($(BR2_PACKAGE_LIBOPENSSL),y)
 LIBKRB5_CONF_OPTS += \
-	--enable-pkinit \
+	--disable-pkinit \
 	--with-crypto-impl=openssl \
 	--with-spake-openssl \
-	--with-tls-impl=openssl
+	--without-tls-impl
 LIBKRB5_DEPENDENCIES += openssl
 else
 LIBKRB5_CONF_OPTS += \
