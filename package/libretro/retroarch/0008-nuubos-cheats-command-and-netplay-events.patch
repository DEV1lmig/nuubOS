From: nuubOS <noreply@nuubos.invalid>
Subject: [PATCH] nuubOS CHEATS_LOAD and NETPLAY_STOP commands, netplay events

nuubOS manages cheats and netplay with its own controller-first UI
through nuubos-emud, which drives RetroArch on the stdin command
interface.

- CHEATS_LOAD <file>: replaces the session's cheats with the ones of a
  .cht file written by the session manager (the user's choice per game)
  and applies them; an empty argument clears them. Replies
  "CHEATS_LOAD OK|FAILED". Refused while netplay runs and in hardcore
  mode.
- NETPLAY_STOP: stops hosting or leaves the host (the netplay host
  toggle hotkey is an input bit that a paused game may never see).
  Replies "NETPLAY_STOP OK|FAILED".
- Netplay state changes are written as unsolicited lines on the command
  interface's output: "NETPLAY hosting", "NETPLAY joined <nick>",
  "NETPLAY left <nick>", "NETPLAY connected <host nick>",
  "NETPLAY disconnected", "NETPLAY failed", "NETPLAY off".

Upstream-Status: Inappropriate [nuubOS session manager integration]
---
--- a/command.c
+++ b/command.c
@@ -20,6 +20,7 @@
 #include <stdlib.h>
 #include <stddef.h>
 #include <locale.h>
+#include <stdarg.h>
 #ifdef HAVE_NETWORKING
 #include <net/net_compat.h>
 #include <net/net_socket.h>
@@ -837,6 +838,85 @@
    return true;
 }
 
+/* nuubOS: the session's cheats are a file the session manager writes
+ * (the user's choice per game, cheatN_enable). Replaces every cheat of
+ * the session with the file's and applies them; an empty argument clears
+ * them. Refused while netplay runs (RetroArch never allows cheats then)
+ * and in hardcore mode (applying would leave it). */
+bool command_cheats_load(command_t *cmd, const char *arg)
+{
+   char reply[64];
+   size_t _len;
+   bool ret = true;
+
+#ifdef HAVE_CHEATS
+#ifdef HAVE_NETWORKING
+   if (netplay_driver_ctl(RARCH_NETPLAY_CTL_IS_DATA_INITED, NULL))
+      ret = false;
+#endif
+#ifdef HAVE_CHEEVOS
+   if (rcheevos_hardcore_active())
+      ret = false;
+#endif
+   if (ret)
+   {
+      cheat_manager_state_free();
+      cheat_manager_alloc_if_empty();
+      if (!string_is_empty(arg))
+         ret = cheat_manager_load(arg, true);
+      /* Also clears the core's cheats when none is left. */
+      cheat_manager_apply_cheats(false);
+   }
+#else
+   ret = false;
+#endif
+   _len = snprintf(reply, sizeof(reply), "CHEATS_LOAD %s\n",
+         ret ? "OK" : "FAILED");
+   cmd->replier(cmd, reply, _len);
+   return ret;
+}
+
+/* nuubOS: ends the session's netplay (stops hosting, or leaves the host);
+ * the game goes on alone. Replies "NETPLAY_STOP OK|FAILED". */
+bool command_netplay_stop(command_t *cmd, const char *arg)
+{
+   char reply[64];
+   size_t _len;
+   bool ret = false;
+
+#ifdef HAVE_NETWORKING
+   if (netplay_driver_ctl(RARCH_NETPLAY_CTL_IS_ENABLED, NULL))
+      ret = command_event(CMD_EVENT_NETPLAY_DISCONNECT, NULL);
+#endif
+   _len = snprintf(reply, sizeof(reply), "NETPLAY_STOP %s\n",
+         ret ? "OK" : "FAILED");
+   cmd->replier(cmd, reply, _len);
+   return ret;
+}
+
+/* nuubOS: an unsolicited line for the session manager on the stdin
+ * command interface's output ("NETPLAY joined <nick>"...). */
+void command_nuubos_event(const char *fmt, ...)
+{
+   char line[256];
+   va_list ap;
+   int n;
+   settings_t *settings = config_get_ptr();
+
+   if (!settings || !settings->bools.stdin_cmd_enable)
+      return;
+   va_start(ap, fmt);
+   n = vsnprintf(line, sizeof(line) - 1, fmt, ap);
+   va_end(ap);
+   if (n <= 0)
+      return;
+   if ((size_t)n > sizeof(line) - 2)
+      n = (int)sizeof(line) - 2;
+   line[n++] = '\n';
+   fwrite(line, 1, (size_t)n, stdout);
+   fflush(stdout);
+}
+
 bool command_play_replay_slot(command_t *cmd, const char *arg)
 {
 #ifdef HAVE_BSV_MOVIE
