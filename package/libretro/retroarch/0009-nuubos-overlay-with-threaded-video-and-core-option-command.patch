+/* nuubOS: SET_CORE_OPTION <key> <value>: sets a core option of the
+ * running core as its menu would (the core sees the change at its next
+ * variable update; RetroArch saves it with the other options). Used for
+ * the session manager's live shortcuts (melonDS screen layout, stylus).
+ * Replies "SET_CORE_OPTION OK|FAILED". */
+bool command_set_core_option(command_t *cmd, const char *arg)
+{
+   char reply[64];
+   char key[128];
+   size_t _len;
+   size_t idx, val_idx;
+   bool ret                       = false;
+   runloop_state_t *runloop_st    = runloop_state_get_ptr();
+   core_option_manager_t *opt     = runloop_st->core_options;
+   const char *value              = arg ? strchr(arg, ' ') : NULL;
+
+   if (     opt && value
+         && (size_t)(value - arg) < sizeof(key))
+   {
+      strlcpy(key, arg, (size_t)(value - arg) + 1);
+      value++;
+      if (     core_option_manager_get_idx(opt, key, &idx)
+            && core_option_manager_get_val_idx(opt, idx, value, &val_idx))
+      {
+         core_option_manager_set_val(opt, idx, val_idx, false);
+         ret = true;
+      }
+   }
+   _len = snprintf(reply, sizeof(reply), "SET_CORE_OPTION %s\n",
+         ret ? "OK" : "FAILED");
+   cmd->replier(cmd, reply, _len);
+   return ret;
+}
+
 /* nuubOS: an unsolicited line for the session manager on the stdin
  * command interface's output ("NETPLAY joined <nick>"...). */
 void command_nuubos_event(const char *fmt, ...)
