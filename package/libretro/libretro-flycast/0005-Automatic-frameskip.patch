From 58b19972851363b0e364cf3f54d6f4a3ae43a2ce Mon Sep 17 00:00:00 2001
From: nuubOS <nuubos@localhost>
Date: Wed, 21 Oct 2026 15:54:36 +0200
Subject: [PATCH 5/6] Automatic frameskip (nuubOS)

reicast_frame_skipping gets "auto": with threaded rendering a frame the
game made is neither read nor drawn, never two in a row, while
RetroArch's audio buffer is below 33 % or about to underrun, that is
while the emulation falls behind. The machine still runs every frame, so
the game keeps its speed and its sound. Only games that draw every vblank
skip: one that draws every second or third (Test Drive Le Mans: 20 a
second) would show the same picture for 100 ms. Same rule as
melonDS-nuubOS.

Upstream: not submitted (nuubOS H700 tuning).
---
 core/hw/pvr/Renderer_if.cpp           | 23 ++++++++++-
 core/libretro/libretro.cpp            | 56 +++++++++++++++++++++++++++
 core/libretro/libretro_core_options.h |  3 +-
 3 files changed, 79 insertions(+), 3 deletions(-)

diff --git a/core/hw/pvr/Renderer_if.cpp b/core/hw/pvr/Renderer_if.cpp
index 805d031..c41b6eb 100644
--- a/core/hw/pvr/Renderer_if.cpp
+++ b/core/hw/pvr/Renderer_if.cpp
@@ -107,6 +107,8 @@ static TA_context *rend_deferred;
 static bool rend_deferred_read;	/* Process() has been done for it */
 bool rend_deferred_swapped;
 
+bool rend_skip_frame(void);	/* libretro.cpp */
+
 /* Libretro thread: draw the render left for later, if any. */
 bool rend_draw_deferred(void)
 {
@@ -114,9 +116,23 @@ bool rend_draw_deferred(void)
    TA_context *cur = _pvrrc;
    u8 *cur_regs = rend_pvr_regs;
 
+   /* Whether the game made a frame at the vblank before as well: only a
+    * game that draws every vblank can do without one. One that draws every
+    * second or third (Test Drive Le Mans: 20 a second) would show the same
+    * picture for 100 ms. */
+   static bool render_before;
+   const bool every_vblank = render_before;
+
+   render_before = ctx != NULL;
    if (ctx == NULL)
       return false;
    rend_deferred = NULL;
+   /* Automatic frameskip: this one is neither read nor drawn. */
+   if (!rend_deferred_read && every_vblank && rend_skip_frame())
+   {
+      tactx_Recycle(ctx);
+      return false;
+   }
    _pvrrc = ctx;
    rend_pvr_regs = ctx->regs;
    bool proc = true;
@@ -222,8 +238,11 @@ bool rend_frame(TA_context* ctx, bool draw_osd)
     * this render. */
    if (settings.rend.ThreadedRendering)
    {
-      /* A second render in the same frame: the one before is drawn first. */
-      rend_draw_deferred();
+      /* A second render in the same frame: the one before is drawn first.
+       * Only then: a call with nothing left would tell the frameskip that
+       * no frame was made at this vblank. */
+      if (rend_deferred != NULL)
+         rend_draw_deferred();
       rend_pvr_regs = ctx->regs;
    }
    /* Reading a render (Process) takes its display lists from the render's
diff --git a/core/libretro/libretro.cpp b/core/libretro/libretro.cpp
index e2b1157..92a6eb0 100644
--- a/core/libretro/libretro.cpp
+++ b/core/libretro/libretro.cpp
@@ -528,6 +528,53 @@ static void set_variable_visibility(void)
    }
 }
 
+/* Automatic frameskip (threaded rendering): a frame is not drawn, never two
+ * in a row, while RetroArch's audio buffer is below FRAMESKIP_THRESHOLD %
+ * or about to underrun, that is while the emulation falls behind. The
+ * machine still runs every frame: the game keeps its speed and its sound,
+ * the libretro thread and the GPU skip a frame's reading and drawing.
+ * Same rule as melonDS-nuubOS. */
+#define FRAMESKIP_THRESHOLD 33
+static bool frameskip_auto;
+static bool frameskip_cb_set;
+static bool audio_buffer_active;
+static unsigned audio_buffer_occupancy;
+static bool audio_underrun_likely;
+static bool frame_skipped;
+
+static void audio_buffer_status(bool active, unsigned occupancy, bool underrun_likely)
+{
+   audio_buffer_active = active;
+   audio_buffer_occupancy = occupancy;
+   audio_underrun_likely = underrun_likely;
+}
+
+static void update_frameskip(bool enable)
+{
+   struct retro_audio_buffer_status_callback cb = { audio_buffer_status };
+
+   if (enable == frameskip_cb_set)
+      return;
+   frameskip_cb_set = environ_cb(RETRO_ENVIRONMENT_SET_AUDIO_BUFFER_STATUS_CALLBACK,
+         enable ? &cb : NULL) && enable;
+   if (!frameskip_cb_set)
+   {
+      audio_buffer_active = false;
+      audio_underrun_likely = false;
+   }
+}
+
+/* Libretro thread, for the render about to be read and drawn. */
+bool rend_skip_frame(void)
+{
+   bool skip = frameskip_auto && frameskip_cb_set && audio_buffer_active
+         && !frame_skipped
+         && (audio_underrun_likely || audio_buffer_occupancy < FRAMESKIP_THRESHOLD);
+
+   frame_skipped = skip;
+   return skip;
+}
+
 static void update_variables(bool first_startup)
 {
    struct retro_variable var;
@@ -916,16 +963,23 @@ static void update_variables(bool first_startup)
 #endif
 
    var.key = CORE_OPTION_NAME "_frame_skipping";
+   frameskip_auto = false;
    if (environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value)
    {
 	   if (!strcmp("disabled", var.value))
 		   settings.pvr.ta_skip = 0;
+	   else if (!strcmp("auto", var.value))
+	   {
+		   settings.pvr.ta_skip = 0;
+		   frameskip_auto = true;
+	   }
 	   else {
 		   settings.pvr.ta_skip = std::max(0, std::min(6, var.value[0] - '0'));
 	   }
    }
    else
 	   settings.pvr.ta_skip = 0;
+   update_frameskip(frameskip_auto);
 
    var.key = CORE_OPTION_NAME "_enable_purupuru";
    if (environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value)
@@ -2146,6 +2200,8 @@ bool retro_load_game_special(unsigned game_type, const struct retro_game_info *i
 void retro_unload_game(void)
 {
 	INFO_LOG(COMMON, "Flycast unloading game");
+   update_frameskip(false);
+   frame_skipped = false;
    if (game_data)
       free(game_data);
    game_data = NULL;
diff --git a/core/libretro/libretro_core_options.h b/core/libretro/libretro_core_options.h
index bb2274f..21c152e 100644
--- a/core/libretro/libretro_core_options.h
+++ b/core/libretro/libretro_core_options.h
@@ -555,11 +555,12 @@ struct retro_core_option_v2_definition option_defs_us[] = {
       CORE_OPTION_NAME "_frame_skipping",
       "Frame Skipping",
       NULL,
-      "Sets the number of frames to skip between each displayed frame.",
+      "Sets the number of frames to skip between each displayed frame. Auto skips drawing a frame, never two in a row, while the frontend's audio buffer runs low: the game keeps its full speed.",
       NULL,
       "video",
       {
          { "disabled",  NULL },
+         { "auto",      "Auto" },
          { "1",         NULL },
          { "2",         NULL },
          { "3",         NULL },
