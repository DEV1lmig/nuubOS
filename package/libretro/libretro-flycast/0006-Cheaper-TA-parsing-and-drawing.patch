 							verify(!dupe_next_vtx);
-							*ctx->idx.Append() = last_good_vtx;
+							*out++ = last_good_vtx;
 							dupe_next_vtx = true;
 						}
 						break;
@@ -1479,26 +1517,28 @@ static void make_index(const List<PolyParam> *polys, int first, int end, bool me
 				last_good_vtx = poly->first + i;
 				if (dupe_next_vtx)
 				{
-					*ctx->idx.Append() = last_good_vtx;
+					*out++ = last_good_vtx;
 					dupe_next_vtx = false;
 				}
