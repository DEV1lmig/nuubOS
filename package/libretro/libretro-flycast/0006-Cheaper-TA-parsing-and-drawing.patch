 	for (PolyParam *poly = &polys->head()[first]; poly != end_poly; poly++)
 	{
+		if (out_end - out < (ptrdiff_t)poly->count * 3 + 2)
+		{
+			ctx->idx.avail -= out - ctx->idx.LastPtr(0);
+			ctx->idx.daty = out;
+			ctx->idx.Append(poly->count * 3 + 2);	/* overrun */
+			return;
+		}
 		int first_index;
 		bool dupe_next_vtx = false;
 		if (merge
@@ -1441,32 +1478,33 @@ static void make_index(const List<PolyParam> *polys, int first, int end, bool me
 				// FIXME tcw1, tsp1, tileclip?
 				)
 		{
-			const u32 last_vtx = indices[last_poly->first + last_poly->count - 1];
-			*ctx->idx.Append() = last_vtx;
+			const u32 last_vtx = idx_base[last_poly->first + last_poly->count - 1];
+			*out++ = last_vtx;
 			dupe_next_vtx = true;
 			first_index = last_poly->first;
 		}
 		else
 		{
 			last_poly = poly;
-			first_index = ctx->idx.used();
+			first_index = out - idx_base;
 		}
 		int last_good_vtx = -1;
+		const Vertex *pv = &vertices[poly->first];
+		auto inf = std::lower_bound(inf_vertices.begin(), inf_vertices.end(), poly->first);
+		const bool check_inf = inf != inf_vertices.end() && *inf < poly->first + poly->count;
 		for (u32 i = 0; i < poly->count; i++)
 		{
-			const Vertex& vtx = vertices[poly->first + i];
-			if (is_vertex_inf(vtx))
+			if (check_inf && is_vertex_inf(pv[i]))
 			{
 				while (i < poly->count - 1)
 				{
-					const Vertex& next_vtx = vertices[poly->first + i + 1];
-					if (!is_vertex_inf(next_vtx))
+					if (!is_vertex_inf(pv[i + 1]))
 					{
 						// repeat last and next vertices to link strips
 						if (last_good_vtx >= 0)
