+/* Vertices with huge x, y or z, a negative z or not numbers: make_index()
+ * leaves them out. Which ones they are (their index in the frame's vertex
+ * list, ascending) is noted as they are made, so that make_index() reads
+ * the vertices of a polygon only if it has one: reading back all of them
+ * (~1.5 MB a frame in Dead or Alive 2, gone from the cache by then) was
+ * most of its time. There are usually none. */
+static std::vector<u32> inf_vertices;
+
+static bool is_vertex_inf(const Vertex& vtx)
+{
+	return std::isnan(vtx.x) || fabsf(vtx.x) > 3.4e37f
+			|| std::isnan(vtx.y) || fabsf(vtx.y) > 3.4e37f
+			|| std::isnan(vtx.z) || vtx.z < 0.f || vtx.z > 3.4e37f;
+}
+
+static inline void note_inf_vertex(const Vertex *base, const Vertex *v)
+{
+	if (is_vertex_inf(*v))
+		inf_vertices.push_back((u32)(v - base));
+}
+
 /* A colour component given as a float, as the hardware takes it: clamped to
  * 0..1 (anything negative is 0; anything above 1, infinity and NaN are 1). */
