+			gl.map_buffer_range = (void *(*)(GLenum, GLintptr, GLsizeiptr, GLbitfield))
+					dlsym(RTLD_DEFAULT, "glMapBufferRange");
+			gl.unmap_buffer = (GLboolean (*)(GLenum))dlsym(RTLD_DEFAULT, "glUnmapBuffer");
+			if (gl.fence_sync == NULL || gl.client_wait_sync == NULL || gl.delete_sync == NULL
