@@ -891,7 +895,18 @@ static void upload_buffer(GLenum target, size_t bytes, const void *data)
 	if ((size_t)size < bytes)
 		glBufferData(target, bytes + bytes / 4, NULL, GL_DYNAMIC_DRAW);
 	if (bytes > 0)
-		glBufferSubData(target, 0, bytes, data);
+	{
+		/* GL_MAP_WRITE_BIT | GL_MAP_INVALIDATE_RANGE_BIT |
+		 * GL_MAP_UNSYNCHRONIZED_BIT: the fence has been waited for. */
+		void *p = gl.map_buffer_range(target, 0, bytes, 0x0002 | 0x0004 | 0x0020);
+		if (p != NULL)
+		{
+			memcpy(p, data, bytes);
+			gl.unmap_buffer(target);
+		}
+		else
+			glBufferSubData(target, 0, bytes, data);
+	}
