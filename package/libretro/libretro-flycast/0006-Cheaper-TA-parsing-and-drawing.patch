+	/* The four bytes are put together and stored at once: stored one by one
+	 * (as chars, which may alias anything) they made the compiler load the
+	 * face colour and the vertex list again after each, in the hottest loop
+	 * of the TA parser. */
+	static inline u32 intensity_color(const float *face, u8 alpha, float intensity)
+	{
+		return (u32)(u8)(face[0] * intensity)
+				| ((u32)(u8)(face[1] * intensity) << 8)
+				| ((u32)(u8)(face[2] * intensity) << 16)
+				| ((u32)alpha << 24);
+	}
