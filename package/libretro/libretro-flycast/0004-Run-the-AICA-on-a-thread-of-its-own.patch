    libARM_InterruptChange(p_ints,Lval);
 }
 
+/* The AICA on a thread of its own (threaded rendering).
+ *
+ * The sound chip took a quarter to a third of the emulation thread in
+ * heavy games (Shenmue II: mixing 13 %, DSP 9 %, stream and envelope
+ * steps, the ARM7). On the console the ARM7 and the SH4 run side by side
+ * and talk through sound RAM and the AICA registers, so here the AICA runs
+ * on its own thread, a tick of 32 samples at a time, never ahead of the
+ * SH4: each AICA tick of SH4 time (AicaUpdate) asks for one more, and at
+ * vblank the emulation thread waits until all asked for are made
+ * (libAICA_Sync), so between frames (save states, reset, the frame's
+ * audio) the AICA is as before.
+ *
+ * What changes: the SH4 sees the AICA up to a tick (0.7 ms) late. The
+ * registers are shared under aica_lock (the SH4 takes it for each access,
+ * the AICA thread for each sample); interrupts the AICA raises for the SH4
+ * are passed on by the emulation thread at the next tick; CD audio sectors
+ * are read ahead by the emulation thread (cdda_prefetch), since reading
+ * the disc belongs to the GD-ROM emulation. */
+std::mutex aica_lock;
+static thread_local bool aica_on_thread;
+static std::atomic<bool> sh4_ints_dirty;
+static bool aica_threaded;
+static std::thread aica_thread;
+static std::mutex aica_qlock;
+static std::condition_variable aica_qcv;
+static u32 ticks_asked, ticks_made;
+static bool aica_exit;
+
 //sh4 side
 static void UpdateSh4Ints()
 {
+   if (aica_on_thread)
+   {
+      /* The SH4's interrupt state belongs to the emulation thread. */
+      sh4_ints_dirty = true;
+      return;
+   }
    u32 p_ints = MCIEB->full & MCIPD->full;
    if (p_ints)
    {
@@ -105,13 +144,90 @@ u32 libAICA_SamplesIntoTick()
 	return samples > 31 ? 31 : samples;
 }
 
+static void aica_thread_func()
+{
+   aica_on_thread = true;
+   for (;;)
+   {
+      {
+         std::unique_lock<std::mutex> lk(aica_qlock);
+         aica_qcv.wait(lk, [] { return aica_exit || ticks_made != ticks_asked; });
+         if (aica_exit)
+            return;
+      }
+      for (int i = 0; i < 32; i++)
+      {
+         std::lock_guard<std::mutex> lk(aica_lock);
+         aicaarm::run(1);
+      }
+      {
+         std::lock_guard<std::mutex> lk(aica_qlock);
+         ticks_made++;
+      }
+      aica_qcv.notify_all();
+   }
+}
+
+/* Emulation thread: the interrupts the AICA thread raised for the SH4. */
+static void aica_pass_sh4_ints()
+{
+   if (sh4_ints_dirty.exchange(false))
+   {
+      std::lock_guard<std::mutex> lk(aica_lock);
+      UpdateSh4Ints();
+   }
+}
+
 static int AicaUpdate(int tag, int c, int j)
 {
-   aicaarm::run(32);
+   if (!settings.rend.ThreadedRendering)
+   {
+      aicaarm::run(32);
+      return AICA_TICK;
+   }
+   if (!aica_threaded)
+   {
+      aica_exit = false;
+      ticks_asked = ticks_made = 0;
+      aica_thread = std::thread(aica_thread_func);
+      aica_threaded = true;
+   }
+   cdda_prefetch();
+   aica_pass_sh4_ints();
+   {
+      std::lock_guard<std::mutex> lk(aica_qlock);
+      ticks_asked++;
+   }
+   aica_qcv.notify_all();
 
 	return AICA_TICK;
 }
 
+/* Emulation thread, at vblank: wait for the ticks asked for. */
+void libAICA_Sync()
+{
+   if (!aica_threaded)
+      return;
+   {
+      std::unique_lock<std::mutex> lk(aica_qlock);
+      aica_qcv.wait(lk, [] { return ticks_made == ticks_asked; });
+   }
+   aica_pass_sh4_ints();
+}
+
+static void aica_stop_thread()
+{
+   if (!aica_threaded)
+      return;
+   {
+      std::lock_guard<std::mutex> lk(aica_qlock);
+      aica_exit = true;
+   }
+   aica_qcv.notify_all();
+   aica_thread.join();
+   aica_threaded = false;
+}
+
 //Mainloop
 
 void libAICA_TimeStep()
@@ -301,6 +417,7 @@ void libAICA_Reset(bool hard)
 
 void libAICA_Term()
 {
+	aica_stop_thread();
 	sgc_Term();
 	term_mem();
 }
