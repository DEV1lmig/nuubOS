 //#define CLIP_WARN
@@ -1343,6 +1344,39 @@ void WriteCommonReg8(u32 reg,u32 data)
 s16 cdda_sector[CDDA_SIZE]={0};
 u32 cdda_index=CDDA_SIZE<<1;
 
+/* CD audio sectors read ahead on the emulation thread for an AICA running
+ * on its own thread (aica.cpp): a single-producer, single-consumer ring. */
+#define CDDA_AHEAD 4
+static s16 cdda_ring[CDDA_AHEAD][CDDA_SIZE];
+static std::atomic<u32> cdda_ring_w, cdda_ring_r;
+
+void cdda_prefetch()
+{
+	while (cdda_ring_w.load(std::memory_order_relaxed) - cdda_ring_r.load(std::memory_order_acquire) < CDDA_AHEAD - 1)
+	{
+		u32 w = cdda_ring_w.load(std::memory_order_relaxed);
+		libCore_CDDA_Sector(cdda_ring[w % CDDA_AHEAD]);
+		cdda_ring_w.store(w + 1, std::memory_order_release);
+	}
+}
+
+static void cdda_next_sector(s16 *sector)
+{
+	if (!settings.rend.ThreadedRendering)
+	{
+		libCore_CDDA_Sector(sector);
+		return;
+	}
+	u32 r = cdda_ring_r.load(std::memory_order_relaxed);
+	if (r == cdda_ring_w.load(std::memory_order_acquire))
+	{
+		memset(sector, 0, CDDA_SIZE * sizeof(s16));
+		return;
+	}
+	memcpy(sector, cdda_ring[r % CDDA_AHEAD], CDDA_SIZE * sizeof(s16));
+	cdda_ring_r.store(r + 1, std::memory_order_release);
+}
+
 void AICA_Sample()
 {
 	SampleType mixl,mixr;
@@ -1358,7 +1392,7 @@ void AICA_Sample()
 	if (cdda_index>=CDDA_SIZE)
 	{
 		cdda_index=0;
-		libCore_CDDA_Sector(cdda_sector);
+		cdda_next_sector(cdda_sector);
 	}
 	s32 EXTS0L=cdda_sector[cdda_index];
 	s32 EXTS0R=cdda_sector[cdda_index+1];
