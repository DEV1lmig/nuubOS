+++ b/core/libretro/libretro.cpp
@@ -188,6 +188,8 @@ void ResetAudioBuffer(void);
 void FlushAudioFrame(void);	// emit one frame's accumulated audio (non-threaded)
 void CaptureInput(void);	// sample input on the main thread, once per frame
 bool rend_single_frame();
+bool rend_draw_deferred(void);
+extern bool rend_deferred_swapped;
 
 static void refresh_devices(bool first_startup);
 static void init_disk_control_interface(void);
@@ -1176,6 +1178,11 @@ static void update_av_info_if_changed(void)
    pending_av_fps_count = 0;
 }
 
+/* Threaded rendering: the frame was handed to the frontend early in
+ * retro_run; a frame drawn after that is to be shown at the next call. */
+static bool video_sent;
+static bool shown_late;
+
 void retro_run (void)
 {
    bool updated     = false;
@@ -1212,17 +1219,36 @@ void retro_run (void)
          glsm_ctl(GLSM_CTL_STATE_BIND, NULL);
 
       emu_baton.StartFrame();
+      /* The render of the frame before, while this one is emulated. */
+      rend_deferred_swapped = false;
+      rend_draw_deferred();
+
+      /* And shown at once, so that the frontend's part of the frame (the
+       * presentation, ~2 ms on the H700) runs while the machine does
+       * too. A frame drawn after this point, a second render of the
+       * machine's frame, is shown at the next call. */
+      if (settings.pvr.rend == 0 || settings.pvr.rend == 3)
+         glsm_ctl(GLSM_CTL_STATE_UNBIND, NULL);
+      video_cb(rend_deferred_swapped || shown_late ? RETRO_HW_FRAME_BUFFER_VALID : 0,
+            screen_width, screen_height, 0);
+      video_sent = true;
+      shown_late = false;
+      rend_deferred_swapped = false;
+      if (settings.pvr.rend == 0 || settings.pvr.rend == 3)
+         glsm_ctl(GLSM_CTL_STATE_BIND, NULL);
       while (emu_baton.WaitWork() != NULL)
       {
          rend_single_frame();
          emu_baton.WorkDone();
       }
-      /* The frame is made and the emulation thread is asleep again; is_dupe
-       * was set at vblank (os_DoEvents). */
+      /* The frame is made and the emulation thread is asleep again. */
 
       if (settings.pvr.rend == 0 || settings.pvr.rend == 3)
          glsm_ctl(GLSM_CTL_STATE_UNBIND, NULL);
 
+      if (rend_deferred_swapped)
+         shown_late = true;
+
       /* This frame's audio, sent from this thread like its video. */
       FlushAudioFrame();
       /* The machine is asleep: what it saved this frame goes to disk now */
@@ -1240,8 +1266,10 @@ void retro_run (void)
 	   maple_FlushSaves();
    }
 #if defined(HAVE_OPENGL) || defined(HAVE_OPENGLES) || defined(HAVE_VULKAN)
-   video_cb(is_dupe ? 0 : RETRO_HW_FRAME_BUFFER_VALID, screen_width, screen_height, 0);
+   if (!video_sent)
+      video_cb(is_dupe ? 0 : RETRO_HW_FRAME_BUFFER_VALID, screen_width, screen_height, 0);
 #endif
+   video_sent = false;
    is_dupe = true;
 
    /* Keep timing.fps in step with the actual emulated refresh rate. */
diff --git a/core/rend/TexCache.cpp b/core/rend/TexCache.cpp
index c83f03a..1ab5a84 100644
--- a/core/rend/TexCache.cpp
+++ b/core/rend/TexCache.cpp
@@ -629,6 +629,24 @@ void BaseTextureCacheData::Update()
 			return;
 		}
 	}
+	//lock the texture to detect changes in it, unless it is frequently
+	//updated: each update of a protected texture costs a SIGSEGV (the write
+	//fault), the invalidation, a full re-upload, and a re-protect -- measured
+	//as 1-2 faults per frame sustained, with matching frame-time jitter, on
+	//titles that rewrite textures every frame (e.g. VF3tb). Past the update
+	//threshold, leave the pages writable and detect changes with a content
+	//hash at lookup time instead (see NeedsUpdate): a hash over the same range
+	//is cheaper than the fault path, and when the game rewrites identical
+	//content it avoids the re-upload entirely.
+	//Done before the texture is decoded: in threaded rendering the
+	//emulation runs while it is, and a write that comes in meanwhile must
+	//make the texture count as changed (a fault on the protected page, or
+	//a hash taken before it).
+	if (Updates < FREQUENT_UPDATE_COUNT)
+		libCore_vramlock_Lock(sa_tex, sa + size - 1, this);
+	else
+		vram_hash = ComputeVramHash();
+
