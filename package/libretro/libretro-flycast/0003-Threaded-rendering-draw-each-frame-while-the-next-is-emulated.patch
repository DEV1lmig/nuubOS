diff --git a/core/hw/pvr/Renderer_if.cpp b/core/hw/pvr/Renderer_if.cpp
index b745d8b..805d031 100644
--- a/core/hw/pvr/Renderer_if.cpp
+++ b/core/hw/pvr/Renderer_if.cpp
@@ -90,6 +90,60 @@ bool fb_dirty;
 
 TA_context* _pvrrc;
 
+#if !defined(TARGET_NO_THREADS)
+/* Threaded rendering draws a frame one retro_run() late: the render the
+ * game starts in frame N is read (Process) and drawn (Render) at the start
+ * of frame N + 1, while the emulation thread runs that frame. Games start
+ * their render late in the frame (Dead or Alive 2: after 18 of 18.5 ms of
+ * emulation), so reading and drawing it right away left the emulation
+ * thread idle all that time and the two threads took turns. The frame
+ * shown is the one before: one frame more of latency.
+ *
+ * A render to a texture is still drawn at once with the emulation asleep
+ * (it ends up in the game's memory), and a frame taken from the
+ * framebuffer is still read at once (it reads video memory the game draws
+ * into); its drawing waits like any other. */
+static TA_context *rend_deferred;
+static bool rend_deferred_read;	/* Process() has been done for it */
+bool rend_deferred_swapped;
+
+/* Libretro thread: draw the render left for later, if any. */
+bool rend_draw_deferred(void)
+{
+   TA_context *ctx = rend_deferred;
+   TA_context *cur = _pvrrc;
+   u8 *cur_regs = rend_pvr_regs;
+
+   if (ctx == NULL)
+      return false;
+   rend_deferred = NULL;
+   _pvrrc = ctx;
+   rend_pvr_regs = ctx->regs;
+   bool proc = true;
+   if (!rend_deferred_read)
+   {
+      palette_update();
+      proc = renderer->Process(ctx);
+   }
+   bool do_swp = proc && renderer->Render();
+   _pvrrc = cur;
+   rend_pvr_regs = cur_regs;
+   tactx_Recycle(ctx);
+   if (do_swp)
+      rend_deferred_swapped = true;
+   return do_swp;
+}
+
+/* Libretro thread, the renderer going away: forget the render left for
+ * later. */
+void rend_drop_deferred(void)
+{
+   if (rend_deferred != NULL)
+      tactx_Recycle(rend_deferred);
+   rend_deferred = NULL;
+}
+#endif
+
 void rend_create_renderer()
 {
 	switch (settings.pvr.rend)
@@ -137,6 +191,9 @@ void rend_init_renderer()
 
 void rend_term_renderer()
 {
+#if !defined(TARGET_NO_THREADS)
+	rend_drop_deferred();
+#endif
 	if (renderer != NULL)
 	{
 		renderer->Term();
@@ -164,7 +221,27 @@ bool rend_frame(TA_context* ctx, bool draw_osd)
    /* The renderer reads the registers as they were when the game started
     * this render. */
    if (settings.rend.ThreadedRendering)
+   {
+      /* A second render in the same frame: the one before is drawn first. */
+      rend_draw_deferred();
       rend_pvr_regs = ctx->regs;
+   }
+   /* Reading a render (Process) takes its display lists from the render's
+    * own copy, its registers from ctx->regs and what it needs of the
+    * region array from what was saved at the hand-over (ta_save_regions),
+    * so it is left for later too and the emulation goes on at once (it
+    * used to wait 4-6 ms a frame in Dead or Alive 2). Textures are still
+    * read from video memory: a texture is protected before it is decoded,
+    * so one the game rewrites meanwhile is decoded again at its next use. */
+   const bool early_ack = settings.rend.ThreadedRendering
+         && !ctx->rend.isRTT && !ctx->rend.isRenderFramebuffer;
+   if (early_ack)
+   {
+      emu_baton.AckWork();
+      rend_deferred = ctx;
+      rend_deferred_read = false;
+      return false;
+   }
 #endif
    /* The palette this frame is drawn with, converted here, on the thread
     * that draws, from the registers the frame is drawn with. */
@@ -172,16 +249,20 @@ bool rend_frame(TA_context* ctx, bool draw_osd)
 
    bool proc = renderer->Process(ctx);
 #if !defined(TARGET_NO_THREADS)
-   /* Process() has read everything the frame takes from the game's memory:
-    * the display lists, the textures, the framebuffer. The emulation thread
-    * has been asleep since it handed the render over, so what was read is
-    * what non-threaded rendering would have read; from here it can run
-    * while the frame is drawn. A render to a texture ends up back in the
-    * game's memory, so that one keeps the emulation asleep until it is
-    * finished. */
+   /* A render to a texture or a frame taken from the framebuffer: Process()
+    * has read what it takes from the game's memory with the emulation
+    * asleep. A render to a texture ends up back in the game's memory, so
+    * that one keeps the emulation asleep until it is drawn; the other is
+    * drawn later like the rest. */
    const bool hold = proc && ctx->rend.isRTT;
-   if (settings.rend.ThreadedRendering && !hold)
+   if (settings.rend.ThreadedRendering && !hold && !early_ack)
       emu_baton.AckWork();
+   if (settings.rend.ThreadedRendering && proc && !hold)
+   {
+      rend_deferred = ctx;
+      rend_deferred_read = true;
+      return false;
+   }
 #endif
 
    bool do_swp = proc && renderer->Render();
@@ -212,6 +293,11 @@ bool rend_single_frame(void)
 		bool do_swp = rend_frame(_pvrrc, true);
 
 		//clear up & free data ..
+#if !defined(TARGET_NO_THREADS)
+		if (_pvrrc == rend_deferred)
+			DetachRender(_pvrrc);
+		else
+#endif
 		FinishRender(_pvrrc);
 		_pvrrc=0;
 		rend_pvr_regs = pvr_regs;
@@ -278,6 +364,8 @@ void rend_start_render(void)
                 * as they are now, and sleep until it has read what it needs
                 * of the game's memory. */
                memcpy(ctx->regs, pvr_regs, pvr_RendRegSize);
+               if (!ctx->rend.isRenderFramebuffer)
+                  ta_save_regions(ctx);
                emu_baton.HandOver(ctx);
             }
             else
