+++ b/core/hw/pvr/pvr_regs.cpp
@@ -6,7 +6,7 @@
 
 
 u8 pvr_regs[pvr_RegSize];
-u8 *rend_pvr_regs = pvr_regs;
+__thread u8 *rend_pvr_regs = pvr_regs;
 
 u32 pvr_ReadReg(u32 addr)
 {
diff --git a/core/hw/pvr/pvr_regs.h b/core/hw/pvr/pvr_regs.h
index d06239e..bf41e46 100644
--- a/core/hw/pvr/pvr_regs.h
+++ b/core/hw/pvr/pvr_regs.h
@@ -13,8 +13,12 @@ extern u8 pvr_regs[pvr_RegSize];
  * then and may have changed them.
  *
  * The files of the renderers define PVR_REGS_FOR_RENDERER before they
- * include anything, which points every register they read at this. */
-extern u8 *rend_pvr_regs;
+ * include anything, which points every register they read at this. It is
+ * per thread: the libretro thread points it at a render's copy while it
+ * reads or draws that render, the emulation thread always sees pvr_regs.
+ * ta_vtx.cpp is such a file too, and its background plane code runs on
+ * the emulation thread. */
+extern __thread u8 *rend_pvr_regs __attribute__((tls_model("initial-exec")));
 
 /* The part of the register block that is copied for a render: the
  * registers proper, the fog table and the palette. */
diff --git a/core/hw/pvr/ta_ctx.cpp b/core/hw/pvr/ta_ctx.cpp
index 66567ff..f52930d 100644
--- a/core/hw/pvr/ta_ctx.cpp
+++ b/core/hw/pvr/ta_ctx.cpp
@@ -132,6 +132,14 @@ void FinishRender(TA_context* ctx)
 	}
 }
 
+/* The render queued is taken off the queue without being given back: its
+ * drawing is left for later (rend_frame). */
+void DetachRender(TA_context* ctx)
+{
+	verify(retro_atomic_load_relaxed_ptr(&rqueue) == ctx);
+	retro_atomic_store_release_ptr(&rqueue, NULL);
+}
+
 /* Spare contexts. Both threads give them back; a slot hands each one to
  * a single taker. */
 static cSlotCache<TA_context, 3> ctx_pool;
diff --git a/core/hw/pvr/ta_ctx.h b/core/hw/pvr/ta_ctx.h
index 4a71ce3..5c913e8 100644
--- a/core/hw/pvr/ta_ctx.h
+++ b/core/hw/pvr/ta_ctx.h
@@ -170,6 +170,13 @@ struct TA_context
 	tad_context tad;
 	rend_context rend;
 
+	/* From the region array, when the render was started (ta_save_regions):
+	 * per render pass, then the tile clip as xmin, xmax, ymin, ymax. */
+	bool regions_saved = false;
+	bool pass_autosort[10];
+	bool pass_z_clear[10];
+	u32 tile_clip[4];
+
 	
 	/*
 		Dreamcast games use up to 20k vtx, 30k idx, 1k (in total) parameters.
@@ -229,6 +236,7 @@ struct TA_context
       tad.Clear();
 		rend.Clear();
 		rend.proc_end = rend.proc_start = tad.thd_root;
+		regions_saved = false;
 	}
 
 	void Free()
@@ -271,6 +279,8 @@ void SetCurrentTARC(u32 addr);
 bool QueueRender(TA_context* ctx);
 TA_context* DequeueRender();
 void FinishRender(TA_context* ctx);
+void DetachRender(TA_context* ctx);
+void ta_save_regions(TA_context* ctx);
 
 //must be moved to proper header
 void FillBGP(TA_context* ctx);
diff --git a/core/hw/pvr/ta_vtx.cpp b/core/hw/pvr/ta_vtx.cpp
index c9f9d7a..2678b62 100644
--- a/core/hw/pvr/ta_vtx.cpp
+++ b/core/hw/pvr/ta_vtx.cpp
@@ -3,6 +3,7 @@
 
 	Parsing of the TA stream and generation of vertex data !
 */
+#define PVR_REGS_FOR_RENDERER	// see hw/pvr/pvr_regs.h
 #include "ta.h"
 #include "ta_ctx.h"
 #include "pvr_mem.h"
@@ -1625,8 +1626,16 @@ bool ta_parse_vdrc(TA_context* ctx)
 						render_pass->tr_count, false, &vd_rc);
 				tr_poly_count = render_pass->tr_count;
 				render_pass->mvo_tr_count = vd_rc.global_param_mvo_tr.used();
-				render_pass->autosort = UsingAutoSort(pass);
-				render_pass->z_clear = ClearZBeforePass(pass);
+				if (ctx->regions_saved)
+				{
+					render_pass->autosort = ctx->pass_autosort[pass];
+					render_pass->z_clear = ctx->pass_z_clear[pass];
+				}
+				else
+				{
+					render_pass->autosort = UsingAutoSort(pass);
+					render_pass->z_clear = ClearZBeforePass(pass);
+				}
 			}
 		}
 		rv = !empty_context;
@@ -1643,7 +1652,15 @@ bool ta_parse_vdrc(TA_context* ctx)
    if (rv && !overrun)
    {
       u32 xmin, xmax, ymin, ymax;
-      getRegionTileClipping(xmin, xmax, ymin, ymax);
+      if (ctx->regions_saved)
+      {
+         xmin = ctx->tile_clip[0];
+         xmax = ctx->tile_clip[1];
+         ymin = ctx->tile_clip[2];
+         ymax = ctx->tile_clip[3];
+      }
+      else
+         getRegionTileClipping(xmin, xmax, ymin, ymax);
       vd_rc.fb_X_CLIP.min = std::max(vd_rc.fb_X_CLIP.min, xmin);
       vd_rc.fb_X_CLIP.max = std::min(vd_rc.fb_X_CLIP.max, xmax + 31);
       vd_rc.fb_Y_CLIP.min = std::max(vd_rc.fb_Y_CLIP.min, ymin);
@@ -1912,3 +1929,22 @@ static bool ClearZBeforePass(int pass_number)
 
 	return !tile.NoZClear;
 }
+
+/* Emulation thread, as it hands a render over (threaded rendering): what
+ * the render takes from the region array, read now. The game may write a
+ * new region array into video memory while the render is still being read
+ * on the libretro thread. */
+void ta_save_regions(TA_context* ctx)
+{
+	u32 passes = std::min(ctx->tad.render_pass_count + 1,
+			(u32)(sizeof(ctx->pass_autosort) / sizeof(ctx->pass_autosort[0])));
+
+	for (u32 pass = 0; pass < passes; pass++)
+	{
+		ctx->pass_autosort[pass] = UsingAutoSort(pass);
+		ctx->pass_z_clear[pass] = ClearZBeforePass(pass);
+	}
+	getRegionTileClipping(ctx->tile_clip[0], ctx->tile_clip[1],
+			ctx->tile_clip[2], ctx->tile_clip[3]);
+	ctx->regions_saved = true;
+}
