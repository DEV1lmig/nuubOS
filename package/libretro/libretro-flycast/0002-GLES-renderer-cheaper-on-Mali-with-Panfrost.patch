    findGLVersion();
@@ -848,6 +868,32 @@ void vertex_buffer_unmap(void)
 void DoCleanup() {
 }
 
+/* Fill the buffer bound to @target. The vertex, index and modifier volume
+ * buffers are three of each, used in turn, and the frame that drew from
+ * one last left a fence: once the GPU is past it the buffer is written in
+ * place. A new store each frame (glBufferData) was a new GPU buffer each
+ * frame in Panfrost, its pages faulted in and cleared by the kernel as
+ * they were written: ~20 % of the rendering thread in Dead or Alive 2.
+ * Writing in place without the fence is not safe: Panfrost let the GPU
+ * read the new data for a frame still being drawn (tiles of two frames).
+ * The store only grows; the small quads drawn on the side (framebuffer,
+ * VMU screens) still replace it with their own, and it grows back. */
+static void upload_buffer(GLenum target, size_t bytes, const void *data)
+{
+	GLint size = 0;
+
+	if (gl.fence_sync == NULL)
+	{
+		glBufferData(target, bytes, data, GL_STREAM_DRAW);
+		return;
+	}
+	glGetBufferParameteriv(target, GL_BUFFER_SIZE, &size);
+	if ((size_t)size < bytes)
+		glBufferData(target, bytes + bytes / 4, NULL, GL_DYNAMIC_DRAW);
+	if (bytes > 0)
+		glBufferSubData(target, 0, bytes, data);
+}
+
 static void upload_vertex_indices()
 {
 	if (gl.index_type == GL_UNSIGNED_SHORT)
@@ -859,10 +905,10 @@ static void upload_vertex_indices()
 		short_idx.Init(pvrrc.idx.used(), &overrun, NULL);
 		for (u32 *p = pvrrc.idx.head(); p < pvrrc.idx.LastPtr(0); p++)
 			*(short_idx.Append()) = *p;
-		glBufferData(GL_ELEMENT_ARRAY_BUFFER, short_idx.bytes(), short_idx.head(), GL_STREAM_DRAW);
+		upload_buffer(GL_ELEMENT_ARRAY_BUFFER, short_idx.bytes(), short_idx.head());
 	}
 	else
-		glBufferData(GL_ELEMENT_ARRAY_BUFFER,pvrrc.idx.bytes(),pvrrc.idx.head(),GL_STREAM_DRAW);
+		upload_buffer(GL_ELEMENT_ARRAY_BUFFER, pvrrc.idx.bytes(), pvrrc.idx.head());
 }
 
 static bool RenderFrame(void)
@@ -1017,13 +1063,25 @@ static bool RenderFrame(void)
 
 	//move vertex to gpu
 
+	gl.vbo.ring_pos = (gl.vbo.ring_pos + 1) % 3;
+	if (gl.vbo.ring_fence[gl.vbo.ring_pos] != NULL)
+	{
+		/* GL_SYNC_FLUSH_COMMANDS_BIT, no time limit */
+		gl.client_wait_sync(gl.vbo.ring_fence[gl.vbo.ring_pos], 0x1, ~(uint64_t)0);
+		gl.delete_sync(gl.vbo.ring_fence[gl.vbo.ring_pos]);
+		gl.vbo.ring_fence[gl.vbo.ring_pos] = NULL;
+	}
+	gl.vbo.geometry = gl.vbo.ring_geometry[gl.vbo.ring_pos];
+	gl.vbo.modvols = gl.vbo.ring_modvols[gl.vbo.ring_pos];
+	gl.vbo.idxs = gl.vbo.ring_idxs[gl.vbo.ring_pos];
+
 	if (!pvrrc.isRenderFramebuffer)
 	{
 		//Main VBO
 		glBindBuffer(GL_ARRAY_BUFFER, gl.vbo.geometry); glCheck();
 		glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, gl.vbo.idxs); glCheck();
 
-		glBufferData(GL_ARRAY_BUFFER,pvrrc.verts.bytes(),pvrrc.verts.head(),GL_STREAM_DRAW); glCheck();
+		upload_buffer(GL_ARRAY_BUFFER, pvrrc.verts.bytes(), pvrrc.verts.head()); glCheck();
 
 		upload_vertex_indices();
 
@@ -1031,7 +1089,7 @@ static bool RenderFrame(void)
 		if (pvrrc.modtrig.used())
 		{
 			glBindBuffer(GL_ARRAY_BUFFER, gl.vbo.modvols); glCheck();
-			glBufferData(GL_ARRAY_BUFFER,pvrrc.modtrig.bytes(),pvrrc.modtrig.head(),GL_STREAM_DRAW); glCheck();
+			upload_buffer(GL_ARRAY_BUFFER, pvrrc.modtrig.bytes(), pvrrc.modtrig.head()); glCheck();
 		}
 
 		if (!wide_screen_on)
@@ -1132,6 +1190,9 @@ static bool RenderFrame(void)
 
 	KillTex = false;
 
+	if (gl.fence_sync != NULL)	/* GL_SYNC_GPU_COMMANDS_COMPLETE */
+		gl.vbo.ring_fence[gl.vbo.ring_pos] = gl.fence_sync(0x9117, 0);
+
 	if (is_rtt)
 		ReadRTTBuffer();
 
