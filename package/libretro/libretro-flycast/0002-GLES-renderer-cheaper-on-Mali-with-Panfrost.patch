From 9e310f9f0d687de665e08f66b7e5414f8b12b0db Mon Sep 17 00:00:00 2001
From: nuubOS <nuubos@localhost>
Date: Wed, 21 Oct 2026 14:39:34 +0200
Subject: [PATCH 2/6] GLES renderer: cheaper on Mali with Panfrost (nuubOS)

Three changes for the H700 (Mali-G31 MP1, one shader core; Mesa
Panfrost), measured on Dead or Alive 2 at 640x480 on the RG CubeXX:

- Strips are drawn with glDrawRangeElements (GLES 3), their vertex range
  being their first and last index (make_index writes the indices of a
  strip in ascending order). Without a range Panfrost finds it by
  reading every index back from the uncached mapping of the index
  buffer: 27 % of the rendering thread.

- The depth test goes by the depth the vertex shader gives (an affine
  function of 1/w, exact across a triangle), as the GLES 2 path did. The
  fragment shaders wrote a logarithmic gl_FragDepth on GL/GLES 3, which
  turns off early depth testing and forward pixel kill: every hidden
  fragment was shaded (~9 layers a pixel). GPU busy 88 % -> 61 %.

- Vertex, index and modifier volume data go into three buffers of each,
  used in turn and written in place with glBufferSubData once the fence
  of the frame that last drew from them has passed. A new store every
  frame (glBufferData) was a new GPU buffer in Panfrost, its pages
  faulted in and cleared by the kernel as they were written (~20 % of
  the rendering thread); without the fence Panfrost let the GPU read the
  new data for a frame still being drawn.

Upstream: not submitted (nuubOS H700 tuning).
---
 core/rend/gles/gldraw.cpp |  28 ++++++++--
 core/rend/gles/gles.cpp   | 105 ++++++++++++++++++++++++++++++--------
 core/rend/gles/gles.h     |  12 +++++
 3 files changed, 119 insertions(+), 26 deletions(-)

diff --git a/core/rend/gles/gldraw.cpp b/core/rend/gles/gldraw.cpp
index e12336b..3beffc9 100644
--- a/core/rend/gles/gldraw.cpp
+++ b/core/rend/gles/gldraw.cpp
@@ -245,6 +245,28 @@ __forceinline
 	}
 }
 
+/* Draw the strip of index entries [first, first + count). Without a range
+ * Mesa's Panfrost finds the vertices a draw uses by reading every index
+ * back from the uncached mapping of the index buffer, which is new every
+ * frame: perf on Dead or Alive 2 (Mali-G31, Cortex-A53) put 27 % of the
+ * rendering thread there. make_index() writes the indices of a strip in
+ * ascending order, so its first and last ones are the range. */
+static void DrawStrip(u32 first, u32 count)
+{
+	const void *offset = (GLvoid*)(gl.get_index_size() * first);
+
+	if (count == 0)
+		return;
+	if (gl.draw_range_elements != NULL)
+	{
+		const u32 *idx = pvrrc.idx.head();
+		gl.draw_range_elements(GL_TRIANGLE_STRIP, idx[first],
+				idx[first + count - 1], count, gl.index_type, offset);
+	}
+	else
+		glDrawElements(GL_TRIANGLE_STRIP, count, gl.index_type, offset);
+}
+
 template <u32 Type, bool SortingEnabled>
 static void DrawList(const List<PolyParam>& gply, int first, int count)
 {
@@ -271,8 +293,7 @@ static void DrawList(const List<PolyParam>& gply, int first, int count)
 		if (params->count>2) /* this actually happens for some games. No idea why .. */
 		{
 			SetGPState<Type,SortingEnabled>(params);
-			glDrawElements(GL_TRIANGLE_STRIP, params->count, gl.index_type,
-						(GLvoid*)(gl.get_index_size() * params->first));
+			DrawStrip(params->first, params->count);
 		}
 
 		params++;
@@ -562,8 +583,7 @@ static void DrawShadowed(const List<PolyParam>& gply, int first, int count, cons
 			glcache.StencilFunc(GL_EQUAL, 0x81, 0xC1);
 			glcache.StencilOp(GL_KEEP, GL_KEEP, GL_INVERT);
 		}
-		glDrawElements(GL_TRIANGLE_STRIP, gp->count, gl.index_type,
-				(GLvoid*)(gl.get_index_size() * gp->first));
+		DrawStrip(gp->first, gp->count);
 	}
 }
 
