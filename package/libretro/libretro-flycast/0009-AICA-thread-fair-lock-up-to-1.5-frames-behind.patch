diff --git a/core/hw/aica/aica_lock.h b/core/hw/aica/aica_lock.h
new file mode 100644
index 0000000..6dc864e
--- /dev/null
+++ b/core/hw/aica/aica_lock.h
@@ -0,0 +1,42 @@
+#pragma once
+#include <atomic>
+#include <sched.h>
+
+/* nuubOS: the lock between the SH4 (each AICA register access) and the
+ * AICA thread (each sample). A std::mutex made the SH4 thread sleep in the
+ * kernel ~18000 times a second in Shenmue II (~6 ms of every frame that
+ * renders): the AICA thread took it back for the next sample before the
+ * sleeper woke up. A ticket lock is fair (the SH4 goes right after the
+ * sample in progress, a few microseconds) and spins instead of sleeping;
+ * it yields the CPU only if the holder is not running. */
+class AicaLock
+{
+	std::atomic<unsigned> next{0};
+	std::atomic<unsigned> serving{0};
+
+public:
+	void lock()
+	{
+		unsigned ticket = next.fetch_add(1, std::memory_order_relaxed);
+		unsigned spins = 0;
+
+		while (serving.load(std::memory_order_acquire) != ticket)
+		{
+			if (++spins < 4096)
+			{
+#if defined(__aarch64__) || defined(__arm__)
+				asm volatile("yield");
+#endif
+			}
+			else
+				sched_yield();
+		}
+	}
+
+	void unlock()
+	{
+		serving.store(serving.load(std::memory_order_relaxed) + 1, std::memory_order_release);
+	}
+};
+
+extern AicaLock aica_lock;
diff --git a/core/libretro/audiostream.cpp b/core/libretro/audiostream.cpp
index f568bff..c565416 100644
--- a/core/libretro/audiostream.cpp
+++ b/core/libretro/audiostream.cpp
@@ -4,78 +4,54 @@
 #include <string.h>
 #include <libretro.h>
 
-/* One retro_run is one video frame, and it comes with the sound the console
- * put out during that frame, in one consecutive batch. How much sound that
- * is follows from the hardware: the AICA runs at 44100 Hz and a frame lasts
- * as long as the sync generator says, so an NTSC or VGA frame (59.94 Hz)
- * carries 735 or 736 samples and a PAL frame (50 Hz) 882.
- *
- * The AICA is emulated a tick of 32 samples at a time, so at the end of a
- * frame the sound made so far is whole ticks: 704 or 736 samples for an
- * NTSC frame, not what the hardware puts out. FlushAudioFrame() therefore
- * asks how far into the current tick the frame ended and sends exactly the
- * samples due by then, keeping the rest for the next frame. To have them to
- * send it runs one tick, 32 samples or 0.7 ms, behind.
- *
- * The buffer comfortably exceeds one frame's worth of samples. If it is
- * ever exceeded it is flushed early as a safety valve. */
-#define AUDIO_BUFFER_SIZE 4096
+#include <atomic>
 
-/* Samples in one AICA tick: how far FlushAudioFrame() runs behind. */
-#define AUDIO_TICK_SAMPLES 32
+/* nuubOS: the AICA may run on its own thread and a little behind the SH4
+ * (aica.cpp, libAICA_SyncLag), so its samples go through a ring with one
+ * writer (WriteSample, the AICA) and one reader (FlushAudioFrame, the
+ * libretro thread at the end of retro_run), which sends what has been made
+ * so far. A frame then carries about, not exactly, the frame's 735 samples;
+ * RetroArch's rate control evens that out. A full ring drops samples. */
+#define AUDIO_RING_SIZE 8192	/* power of two, ~186 ms */
 
 extern retro_audio_sample_batch_t audio_batch_cb;
 
-/* Samples of the current AICA tick the hardware has put out by now, 0..31. */
-u32 libAICA_SamplesIntoTick();
-
-/* File-scope so the batch boundary can be reset deterministically on state
- * load / reset. If writePtr survived a load, two states saved at different
- * intra-batch offsets would replay a different partial batch, so identical
- * inputs would no longer produce identical audio output -- breaking netplay and
- * runahead determinism. */
-static SoundFrame Buffer[AUDIO_BUFFER_SIZE];
-static u32 writePtr; /* next sample index */
-
+static SoundFrame Ring[AUDIO_RING_SIZE];
+static std::atomic<u32> ring_write, ring_read;
 
 void WriteSample(s16 r, s16 l)
 {
-   Buffer[writePtr].r = r;
-   Buffer[writePtr].l = l;
-   ++writePtr;
+   const u32 w = ring_write.load(std::memory_order_relaxed);
 
-   /* The safety valve only trips if a single frame somehow overruns the
-    * buffer. */
-   if (writePtr == AUDIO_BUFFER_SIZE)
-   {
-      if (dc_is_running())
-         audio_batch_cb((const int16_t*)Buffer, writePtr);
-      writePtr = 0;
-   }
+   if (w - ring_read.load(std::memory_order_acquire) >= AUDIO_RING_SIZE)
+      return;
+   Ring[w & (AUDIO_RING_SIZE - 1)].r = r;
+   Ring[w & (AUDIO_RING_SIZE - 1)].l = l;
+   ring_write.store(w + 1, std::memory_order_release);
 }
 
-/* Send the sound of the frame that just ran, at the end of retro_run. The dc
- * is stopped at the frame boundary, so this is not gated on dc_is_running(). */
+/* Send the sound made so far, at the end of retro_run. */
 void FlushAudioFrame(void)
 {
-   /* Of the last tick made, the hardware has only put out the part that
-    * lies before the end of this frame; hold the rest back, on top of the
-    * one tick this runs behind. */
-   const u32 keep = AUDIO_TICK_SAMPLES - libAICA_SamplesIntoTick();
+   u32 r = ring_read.load(std::memory_order_relaxed);
+   const u32 w = ring_write.load(std::memory_order_acquire);
 
-   if (writePtr > keep)
+   while (r != w)
    {
-      const u32 count = writePtr - keep;
+      const u32 i = r & (AUDIO_RING_SIZE - 1);
+      u32 n = w - r;
 
-      audio_batch_cb((const int16_t*)Buffer, count);
-      memmove(Buffer, Buffer + count, keep * sizeof(Buffer[0]));
-      writePtr = keep;
+      if (n > AUDIO_RING_SIZE - i)
+         n = AUDIO_RING_SIZE - i;
+      audio_batch_cb((const int16_t*)&Ring[i], n);
+      r += n;
    }
+   ring_read.store(r, std::memory_order_release);
 }
 
-/* Drop any partially-filled batch and rewind to a known boundary. Called after
- * (un)serialize and reset so the audio ring is in a deterministic state. */
+/* Drop what is pending, after (un)serialize and reset (the machine is taken
+ * and the AICA thread caught up). */
 void ResetAudioBuffer(void)
 {
-   writePtr = 0;
+   ring_read.store(ring_write.load(std::memory_order_acquire), std::memory_order_release);
 }
