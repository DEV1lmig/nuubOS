From 0677a2666dda801af8697d6b89510d8cdc684a8e Mon Sep 17 00:00:00 2001
From: nuubOS Project <noreply@nuubos.invalid>
Date: Thu, 22 Oct 2026 19:03:14 +0200
Subject: [PATCH 1/3] libretro: optimize the Lua interpreter, signed overflow
 wraps

luaV_execute was compiled at -O0 under GCC because OP_FORLOOP lost its
wrap-around check when optimized. The wrap is a signed int32 overflow in
fix32 addition, which the optimizer may assume never happens. The
libretro build now passes -fwrapv, which defines that overflow as the
two's complement wrap PICO-8 has, and the interpreter is optimized like
the rest of the core.

A Healthy Dose of Dungeon (RG CubeXX, Cortex-A53 at 1.4 GHz): 49-52 fps
with the emulation thread at 93-95 % -> 60 fps at 62-71 %.

Upstream-Status: Pending
---
 libs/z8lua/lvm.c           | 6 +++++-
 platform/libretro/Makefile | 3 +++
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/libs/z8lua/lvm.c b/libs/z8lua/lvm.c
index 7943ea0..e7021c3 100644
--- a/libs/z8lua/lvm.c
+++ b/libs/z8lua/lvm.c
@@ -577,10 +577,14 @@ void luaV_finishOp (lua_State *L) {
 
 //turn off optimizations for this method.
 //OP_FORLOOP doesn't correctly detect wrapping in certain cases if optimization is on and aggressive
+//nuubOS: the wrap is a signed int32 overflow in fix32 (undefined
+//behaviour the optimizer may assume away); the libretro build passes
+//-fwrapv, which defines it as the two's complement wrap PICO-8 has, so
+//the interpreter is optimized like the rest (it was most of a frame).
 #if __clang__
 [[clang::optnone]]
 void luaV_execute (lua_State *L) {
-#elif __GNUC__
+#elif __GNUC__ && !defined(Z8LUA_WRAPV)
 void __attribute__((optimize("O0"))) luaV_execute (lua_State *L) {
 #else
 void luaV_execute (lua_State *L) {
diff --git a/platform/libretro/Makefile b/platform/libretro/Makefile
index 1033395..604a9eb 100644
--- a/platform/libretro/Makefile
+++ b/platform/libretro/Makefile
@@ -72,6 +72,9 @@ ifeq ($(platform), unix)
 	EXT ?= so
    TARGET := $(TARGET_NAME)_libretro.$(EXT)
    fpic := -fPIC
+   # signed fix32 overflow wraps as on PICO-8 (see luaV_execute)
+   CFLAGS += -fwrapv -DZ8LUA_WRAPV
+   CXXFLAGS += -fwrapv -DZ8LUA_WRAPV
    SHARED := -shared -Wl,--version-script=link.T -Wl,--no-undefined
 else ifeq ($(platform), linux-portable)
    TARGET := $(TARGET_NAME)_libretro.$(EXT)
-- 
