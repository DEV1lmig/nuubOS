+    Platform::Semaphore* Sema_LaneStart[NumLanes];
+    Platform::Semaphore* Sema_LaneDone[NumLanes];
+    Platform::Semaphore* Sema_FirstLine[NumLanes]; // raw line LaneStart[k] rendered
