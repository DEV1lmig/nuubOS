     void ClearBuffers();
@@ -534,14 +539,14 @@ private:
     Platform::Semaphore* Sema_RenderStart;
     Platform::Semaphore* Sema_RenderDone;
     Platform::Semaphore* Sema_ScanlineCount;
-    // lower half: its own thread, lines and handshakes with the upper half
-    Platform::Thread* LowerThread;
-    Platform::Semaphore* Sema_LowerStart;
-    Platform::Semaphore* Sema_LowerDone;
-    Platform::Semaphore* Sema_LowerScanlines;
-    Platform::Semaphore* Sema_LowerFirstLine; // raw line SplitLine rendered
