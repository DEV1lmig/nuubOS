-// Lines [SplitLine, 192): the final pass of a line needs the raw lines above
-// and below it, so the first one (SplitLine) is finished last, once the upper
-// half has rendered SplitLine-1; its lines are released to GetLine together.
-void SoftRenderer::RenderLowerHalf()
+static s64 LaneClock()
 {
-    Lane* L = &Lanes[1];
-    int j = SetupLane(L, LowerPolygons, LowerNumPolygons, SplitLine);
+    struct timespec t;
+    clock_gettime(CLOCK_THREAD_CPUTIME_ID, &t);
+    return (s64)t.tv_sec * 1000000000 + t.tv_nsec;
+}
 
-    RenderScanline(L, SplitLine, j);
-    Platform::Semaphore_Post(Sema_LowerFirstLine);
+// Renders the band of lane k. The final pass of a line needs the raw lines
+// above and below it: at each band edge the line before it is finished by
+// the lane above once this lane has rendered its first line, and the first
+// line is finished here last, once the lane above has rendered its last one.
+void SoftRenderer::RenderLane(int k)
+{
+    Lane* L = &Lanes[k];
+    s32 y0 = LaneStart[k], y1 = LaneStart[k+1];
+    s64 t0 = LaneClock();
+
+    int j = SetupLane(L, LanePolygons, LaneNumPolygons, y0);
 
-    for (s32 y = SplitLine+1; y < 192; y++)
+    RenderScanline(L, y0, j);
+    if (k > 0)
+        Platform::Semaphore_Post(Sema_FirstLine[k]);
+
+    for (s32 y = y0+1; y < y1; y++)
     {
         RenderScanline(L, y, j);
-        if (y-1 > SplitLine)
+        if (k == 0 || y-1 > y0)
             ScanlineFinalPass(y-1);
     }
-    ScanlineFinalPass(191);
 
-    Platform::Semaphore_Wait(Sema_UpperLastLine);
-    ScanlineFinalPass(SplitLine);
+    if (k < NumLanes-1)
+    {
+        Platform::Semaphore_Post(Sema_LastLine[k]);
+        Platform::Semaphore_Wait(Sema_FirstLine[k+1]);
+    }
+    ScanlineFinalPass(y1-1);
+
+    if (k > 0)
+    {
+        Platform::Semaphore_Wait(Sema_LastLine[k-1]);
+        ScanlineFinalPass(y0);
+    }
+
+    LaneTime[k] = LaneClock() - t0;
 }
 
-void SoftRenderer::LowerThreadFunc()
+void SoftRenderer::LaneThreadFunc(int k)
 {
     for (;;)
     {
-        Platform::Semaphore_Wait(Sema_LowerStart);
+        Platform::Semaphore_Wait(Sema_LaneStart[k]);
         if (!RenderThreadRunning) return;
 
-        RenderLowerHalf();
-        Platform::Semaphore_Post(Sema_LowerDone);
+        RenderLane(k);
+        Platform::Semaphore_Post(Sema_LaneDone[k]);
     }
 }
 
-void SoftRenderer::RenderPolygons(bool threaded, Polygon** polygons, int npolys)
+// Moves the band edges halfway towards an even split of the last frame's
+// cost (taken as uniform within each band), at least MinLines per band.
+void SoftRenderer::BalanceLanes()
 {
-    Lane* L = &Lanes[0];
+    constexpr int MinLines = 8;
+    double cost[NumLanes], total = 0;
+    for (int k = 0; k < NumLanes; k++)
+    {
+        if (LaneTime[k] <= 0) return;
+        cost[k] = (double)LaneTime[k] / (LaneStart[k+1] - LaneStart[k]);
+        total += LaneTime[k];
+    }
 
+    int edges[NumLanes+1];
+    edges[0] = 0;
+    edges[NumLanes] = 192;
+    int k = 0;
+    double acc = 0;
+    for (int m = 1; m < NumLanes; m++)
+    {
+        double target = total * m / NumLanes;
+        while (k < NumLanes && acc + LaneTime[k] < target)
+            acc += LaneTime[k++];
+        double line = (k < NumLanes) ? LaneStart[k] + (target - acc) / cost[k] : 192;
+        edges[m] = (int)(line + 0.5);
+    }
+
+    for (int m = 1; m < NumLanes; m++)
+    {
+        int e = (LaneStart[m] + edges[m] + 1) / 2;
+        int lo = LaneStart[m-1] + MinLines;
+        int hi = 192 - (NumLanes - m) * MinLines;
+        LaneStart[m] = std::clamp(e, lo, hi);
+    }
+}
+
+void SoftRenderer::RenderPolygons(bool threaded, Polygon** polygons, int npolys)
+{
     if (!threaded)
     {
+        Lane* L = &Lanes[0];
         int j = SetupLane(L, polygons, npolys, 0);
 
         RenderScanline(L, 0, j);
@@ -1721,25 +1793,18 @@ void SoftRenderer::RenderPolygons(bool threaded, Polygon** polygons, int npolys)
         return;
     }
 
-    // the lower half starts now, on its own thread (buffers are cleared)
-    LowerPolygons = polygons;
-    LowerNumPolygons = npolys;
-    Platform::Semaphore_Post(Sema_LowerStart);
+    // the other lanes start now, on their threads (buffers are cleared)
+    LanePolygons = polygons;
+    LaneNumPolygons = npolys;
+    for (int k = 1; k < NumLanes; k++)
+        Platform::Semaphore_Post(Sema_LaneStart[k]);
 
-    int j = SetupLane(L, polygons, npolys, 0);
-
-    RenderScanline(L, 0, j);
-    for (s32 y = 1; y < SplitLine; y++)
-    {
-        RenderScanline(L, y, j);
-        ScanlineFinalPass(y-1);
-    }
-    Platform::Semaphore_Post(Sema_UpperLastLine);
+    RenderLane(0);
 
-    Platform::Semaphore_Wait(Sema_LowerFirstLine);
-    ScanlineFinalPass(SplitLine-1);
+    for (int k = 1; k < NumLanes; k++)
+        Platform::Semaphore_Wait(Sema_LaneDone[k]);
 
-    Platform::Semaphore_Wait(Sema_LowerDone);
+    BalanceLanes();
 }
 
