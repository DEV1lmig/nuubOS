 bool cursor_enabled(InputState *state)
 {
-   return state->current_touch_mode == TouchMode::Mouse || state->current_touch_mode == TouchMode::Joystick;
+   return state->stylus != Stylus::Off ||
+          state->current_touch_mode == TouchMode::Mouse || state->current_touch_mode == TouchMode::Joystick;
+}
+
+// One stick axis as cursor speed in 1/256 px per frame: a dead zone, then
+// quadratic up to 5 px a frame (fine aiming near the centre).
+static int stick_speed(int16_t v)
+{
+   const int dead = 4096;
+   int a = v < 0 ? -v : v;
+   if (a <= dead)
+      return 0;
+   long long m = (long long)(a - dead) * 256 / (32767 - dead);   // 0..256
+   int speed = (int)(m * m * 5 / 256);
+   return v < 0 ? -speed : speed;
+}
+
+// nuubOS stylus: moves the cursor with the chosen control; the D-pad
+// starts slow and speeds up while held.
+static void move_stylus(InputState *state, u32 *joypad_bits, int16_t lx, int16_t ly)
+{
+   int dx = 0, dy = 0;
+
+   switch (state->stylus)
+   {
+      case Stylus::RightStick:
+         dx = stick_speed(input_state_cb(0, RETRO_DEVICE_ANALOG, RETRO_DEVICE_INDEX_ANALOG_RIGHT, RETRO_DEVICE_ID_ANALOG_X));
+         dy = stick_speed(input_state_cb(0, RETRO_DEVICE_ANALOG, RETRO_DEVICE_INDEX_ANALOG_RIGHT, RETRO_DEVICE_ID_ANALOG_Y));
+         break;
+      case Stylus::LeftStick:
+         dx = stick_speed(lx);
+         dy = stick_speed(ly);
+         break;
+      case Stylus::Dpad:
+      {
+         u32 dirs = (1 << RETRO_DEVICE_ID_JOYPAD_LEFT) | (1 << RETRO_DEVICE_ID_JOYPAD_RIGHT) |
+                    (1 << RETRO_DEVICE_ID_JOYPAD_UP) | (1 << RETRO_DEVICE_ID_JOYPAD_DOWN);
+         int step = state->dpad_frames < 12 ? 384 : std::min(1280, 384 + (state->dpad_frames - 12) * 32);
+
+         if (*joypad_bits & (1 << RETRO_DEVICE_ID_JOYPAD_LEFT))  dx -= step;
+         if (*joypad_bits & (1 << RETRO_DEVICE_ID_JOYPAD_RIGHT)) dx += step;
+         if (*joypad_bits & (1 << RETRO_DEVICE_ID_JOYPAD_UP))    dy -= step;
+         if (*joypad_bits & (1 << RETRO_DEVICE_ID_JOYPAD_DOWN))  dy += step;
+         state->dpad_frames = (*joypad_bits & dirs) ? state->dpad_frames + 1 : 0;
+         *joypad_bits &= ~dirs;   // the D-pad is the cursor now
+         break;
+      }
+      default:
+         break;
+   }
+
+   state->cursor_fx = Clamp(state->cursor_fx + dx, 0, ((VIDEO_WIDTH - 1) << 8));
+   state->cursor_fy = Clamp(state->cursor_fy + dy, 0, ((VIDEO_HEIGHT - 1) << 8));
+   state->touch_x = state->cursor_fx >> 8;
+   state->touch_y = state->cursor_fy >> 8;
+   state->touching = !!(*joypad_bits & (1 << RETRO_DEVICE_ID_JOYPAD_L2));
 }
 
