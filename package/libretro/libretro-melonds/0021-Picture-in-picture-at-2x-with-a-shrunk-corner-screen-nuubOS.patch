+// nuubOS Picture in Picture: the corner screen shrunk to 2/3 (every 3x3
+// source block becomes 2x2, weights 2:1 on each axis, a leftover column or
+// row is kept as is), blended three parts to one over the picture.
+static inline uint32_t mix21(uint32_t a, uint32_t b)
+{
+   // (2a + b) / 3 per 8-bit channel (x * 0x5556 >> 16 = x / 3 up to 765)
+   uint32_t r = ((a >> 16 & 0xFF) * 2 + (b >> 16 & 0xFF)) * 0x5556 >> 16;
+   uint32_t g = ((a >> 8 & 0xFF) * 2 + (b >> 8 & 0xFF)) * 0x5556 >> 16;
+   uint32_t bl = ((a & 0xFF) * 2 + (b & 0xFF)) * 0x5556 >> 16;
+   return (a & 0xFF000000) | r << 16 | g << 8 | bl;
+}
+
+static inline uint32_t blend31(uint32_t a, uint32_t b)
+{
+   return ((a >> 1) & 0x7F7F7F7F) + ((a >> 2) & 0x3F3F3F3F) + ((b >> 2) & 0x3F3F3F3F);
+}
+
+static void shrink_row(uint32_t* out, const uint32_t* r, unsigned width)
+{
+   unsigned x = 0, o = 0;
+   for (; x + 3 <= width; x += 3, o += 2)
+   {
+      out[o] = mix21(r[x], r[x + 1]);
+      out[o + 1] = mix21(r[x + 2], r[x + 1]);
+   }
+   for (; x < width; x++)
+      out[o++] = r[x];
+}
+
+static void shrink_blend(uint32_t* dst, unsigned stride, const uint32_t* src, unsigned width, unsigned height)
+{
+   uint32_t a[256], b[256], c[256];
+   unsigned ow = (width * 2 + 2) / 3;
+   unsigned y = 0;
+
+   if (width > 256)
+      return;
+   for (; y + 3 <= height; y += 3)
+   {
+      shrink_row(a, src + y * width, width);
+      shrink_row(b, src + (y + 1) * width, width);
+      shrink_row(c, src + (y + 2) * width, width);
+      for (unsigned x = 0; x < ow; x++)
+      {
+         dst[x] = blend31(mix21(a[x], b[x]), dst[x]);
+         dst[stride + x] = blend31(mix21(c[x], b[x]), dst[stride + x]);
+      }
+      dst += 2 * stride;
+   }
+   for (; y < height; y++, dst += stride)
+   {
+      shrink_row(a, src + y * width, width);
+      for (unsigned x = 0; x < ow; x++)
+         dst[x] = blend31(a[x], dst[x]);
+   }
+}
+
 // nuubOS layouts: the main screen scaled up by an integer factor, the other
 // one at its own size at (small_x, small_y), three parts opaque to one
 // part of the picture below it in the picture-in-picture layouts.
