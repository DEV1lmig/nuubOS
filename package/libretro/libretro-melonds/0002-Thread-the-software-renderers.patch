 #ifdef OGLRENDERER_ENABLED
     else
     {
@@ -1026,6 +1364,25 @@ void StartHBlank(u32 line)
         // a display capture writes VRAM the game reads back: always drawn
         bool draw = !FrameSkip || GPU2D_A.CaptureLatch;
 
+        if (!Sync2D)
+        {
+            bool drawline = line < 192 && draw;
+            bool drawsprites = line < 191 && draw;
+            if (drawline)
+            {
