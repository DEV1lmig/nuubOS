--- a/src/GPU.cpp
+++ b/src/GPU.cpp
@@ -22,6 +22,8 @@
 #include "GPU.h"
 
 #include "GPU2D_Soft.h"
+#include "Platform.h"
+#include <atomic>
 
 namespace GPU
 {
@@ -140,6 +142,325 @@ u8 VRAMFlat_TexPal[128*1024];
 
 u32 OAMDirty;
 u32 PaletteDirty;
+u32 PalOAMGen = 0;
+
+/*
+ * Threaded 2D (nuubOS, H700): both 2D engines are drawn on a worker thread,
+ * one queued job per scanline (HBlank), concurrently with the emulation. A
+ * job carries copies of both units' registers, the VCount and, when they
+ * changed, palette and OAM, so raster effects done with register or palette
+ * writes stay line-exact. The emulation thread keeps the VRAM flattening
+ * (dirty tracking is not thread-safe); VRAM changed in the middle of a frame
+ * may be seen a few lines early. Fields the renderer itself advances per line
+ * (affine reference points, mosaic counters) live in the worker's units and
+ * are taken from the emulation side only when that side changed them
+ * (register write, VBlank reload). Frames with a display capture are drawn on
+ * the emulation thread as before (the capture writes VRAM the game reads).
+ * Drained at VCount 192 (the 3D renderer starts overwriting the lines the 2D
+ * engines read at 215) and before the framebuffers flip.
+ */
+namespace
+{
+struct Job2D
+{
+    u32 Kind;           // Job_Line, Job_Sprites0, Job_Fence
+    u32 First, Last;    // lines (Job_Line: VCount runs along with them)
+    u32 VCount;         // at First
+    u8 UnitChanged[2];  // Units[n] holds a new copy
+    u8 DrawLine, DrawSprites, PalChanged, Wait3D;
+    s32 Buf3D;
+    alignas(16) u8 Units[2][sizeof(GPU2D::Unit)];
+    alignas(16) u8 PalOAM[4096];
+};
+enum { Job_Line, Job_Sprites0, Job_Fence };
+constexpr u32 Job2DCount = 64;
+
+struct OwnedFields
+{
+    s32 BGXRefInternal[2], BGYRefInternal[2];
+    u8 BGMosaicY, BGMosaicYMax, OBJMosaicY, OBJMosaicYCount;
+};
+
+Job2D* Jobs2D = nullptr;
+u32 Job2DHead = 0, Job2DTail = 0;
+Platform::Thread* Thread2D = nullptr;
+Platform::Semaphore *Sema2DJobs, *Sema2DFree, *Sema2DFence;
+std::atomic_bool Thread2DRunning{false};
+bool Threaded2D = false;    // setting (threaded software renderer)
+bool Sync2D = true;         // this frame is drawn on the emulation thread
+bool Queued2D = false;      // jobs queued since the last drain
+bool JobOpen = false;       // the job at Job2DHead is being extended
+u32 SentRegGen[2] = { ~0u, ~0u };
+constexpr u32 Job2DBatch = 16;  // lines per job at most (the worker starts early)
+u32 PalOAMGenSent = ~0u;
+GPU2D::Unit* WorkUnits[2] = { nullptr, nullptr };
+u32 LastOwnedGen[2][5];
+alignas(16) u8 WorkPalOAM[4096];
+
+OwnedFields GetOwned(const GPU2D::Unit* u)
+{
+    OwnedFields f;
+    for (int i = 0; i < 2; i++)
+    {
+        f.BGXRefInternal[i] = u->BGXRefInternal[i];
+        f.BGYRefInternal[i] = u->BGYRefInternal[i];
+    }
+    f.BGMosaicY = u->BGMosaicY; f.BGMosaicYMax = u->BGMosaicYMax;
+    f.OBJMosaicY = u->OBJMosaicY; f.OBJMosaicYCount = u->OBJMosaicYCount;
+    return f;
+}
+
+// The worker's copy of a unit: registers from the emulation side; the fields
+// the renderer advances per line stay the worker's unless the emulation side
+// set them since the previous job (OwnedGen).
+void MergeUnit(int n, const u8* snap)
+{
+    GPU2D::Unit* w = WorkUnits[n];
+    const GPU2D::Unit* s = (const GPU2D::Unit*)snap;
+    OwnedFields keep = GetOwned(w);
+    u32 win0 = w->Win0Active, win1 = w->Win1Active;
+    u32* last = LastOwnedGen[n];
+
+    memcpy((void*)w, snap, sizeof(GPU2D::Unit));
+    for (int i = 0; i < 2; i++)
+    {
+        if (s->OwnedGen[i] == last[i]) w->BGXRefInternal[i] = keep.BGXRefInternal[i];
+        if (s->OwnedGen[2+i] == last[2+i]) w->BGYRefInternal[i] = keep.BGYRefInternal[i];
+    }
+    if (s->OwnedGen[4] == last[4])
+    {
+        w->BGMosaicY = keep.BGMosaicY;
+        w->BGMosaicYMax = keep.BGMosaicYMax;
+    }
+    // OBJ mosaic counters are only ever advanced and reset by the renderer,
+    // and so is the horizontal half (bit 1) of the window active flags
+    w->OBJMosaicY = keep.OBJMosaicY;
+    w->OBJMosaicYCount = keep.OBJMosaicYCount;
+    w->Win0Active = (w->Win0Active & ~0x2) | (win0 & 0x2);
+    w->Win1Active = (w->Win1Active & ~0x2) | (win1 & 0x2);
+    memcpy(last, s->OwnedGen, sizeof(s->OwnedGen));
+}
+
+void Worker2D()
+{
+    GPU2D::Renderer2D* r = GPU2D_Renderer.get();
+    for (;;)
+    {
+        Platform::Semaphore_Wait(Sema2DJobs);
+        if (!Thread2DRunning.load(std::memory_order_acquire))
+            return;
+
+        Job2D& j = Jobs2D[Job2DTail % Job2DCount];
+        Job2DTail++;
+
+        if (j.Kind == Job_Fence)
+        {
+            Platform::Semaphore_Post(Sema2DFree);
+            Platform::Semaphore_Post(Sema2DFence);
+            continue;
+        }
+
+        if (j.PalChanged)
+            memcpy(WorkPalOAM, j.PalOAM, sizeof(WorkPalOAM));
+        if (j.UnitChanged[0]) MergeUnit(0, j.Units[0]);
+        if (j.UnitChanged[1]) MergeUnit(1, j.Units[1]);
+        GPU3D::Line3DBuf = j.Buf3D;
+        GPU3D::Line3DWait = j.Wait3D;
+
+        if (j.Kind == Job_Line)
+        {
+            for (u32 line = j.First; line <= j.Last; line++)
+            {
+                r->JobVCount = j.VCount + (line - j.First);
+                if (j.DrawLine)
+                {
+                    r->DrawScanline(line, WorkUnits[0]);
+                    r->DrawScanline(line, WorkUnits[1]);
+                }
+                if (j.DrawSprites)
+                {
+                    r->DrawSprites(line+1, WorkUnits[0]);
+                    r->DrawSprites(line+1, WorkUnits[1]);
+                }
+            }
+        }
+        else
+        {
+            r->JobVCount = j.VCount;
+            r->DrawSprites(0, WorkUnits[0]);
+            r->DrawSprites(0, WorkUnits[1]);
+        }
+
+        Platform::Semaphore_Post(Sema2DFree);
+    }
+}
+
+bool FIFOMode(const GPU2D::Unit* u)
+{
+    return ((u->DispCnt >> 16) & (u->Num ? 0x1 : 0x3)) == 3;
+}
+
+// A unit's registers; the 512-byte display FIFO line buffer only when the
+// unit displays from the FIFO (main memory display mode).
+void CopyUnit(u8* dst, const GPU2D::Unit* u)
+{
+    const u8* src = (const u8*)u;
+    size_t fifo = (const u8*)u->DispFIFOBuffer - src;
+    size_t fifoend = fifo + sizeof(u->DispFIFOBuffer);
+
+    if (FIFOMode(u))
+    {
+        memcpy(dst, src, sizeof(GPU2D::Unit));
+        return;
+    }
+    memcpy(dst, src, fifo);
+    memcpy(dst + fifoend, src + fifoend, sizeof(GPU2D::Unit) - fifoend);
+}
+
+// Hands the open job to the worker.
+void Publish2D()
+{
+    if (!JobOpen) return;
+    JobOpen = false;
+    Job2DHead++;
+    Queued2D = true;
+    Platform::Semaphore_Post(Sema2DJobs);
+}
+
+// Opens a job at Job2DHead with what changed since the previous one.
+void Begin2D(u32 kind, u32 line, bool drawline, bool drawsprites)
+{
+    Publish2D();
+    Platform::Semaphore_Wait(Sema2DFree);
+    Job2D& j = Jobs2D[Job2DHead % Job2DCount];
+    j.Kind = kind;
+    j.First = j.Last = line;
+    j.VCount = VCount;
+    j.DrawLine = drawline;
+    j.DrawSprites = drawsprites;
+    j.Buf3D = GPU3D::DisplayBuf3D;
+    j.Wait3D = GPU3D::DisplayWait3D;
+    j.UnitChanged[0] = j.UnitChanged[1] = 0;
+    j.PalChanged = 0;
+    if (kind != Job_Fence)
+    {
+        GPU2D::Unit* units[2] = { &GPU2D_A, &GPU2D_B };
+        for (int n = 0; n < 2; n++)
+        {
+            if (!FIFOMode(units[n]) && units[n]->RegGen == SentRegGen[n])
+                continue;
+            CopyUnit(j.Units[n], units[n]);
+            SentRegGen[n] = units[n]->RegGen;
+            j.UnitChanged[n] = 1;
+        }
+        // the worker never captures (capture frames are drawn synchronously)
+        if (j.UnitChanged[0])
+        {
+            ((GPU2D::Unit*)j.Units[0])->CaptureCnt &= ~(1u << 31);
+            ((GPU2D::Unit*)j.Units[0])->CaptureLatch = false;
+        }
+        j.PalChanged = (PalOAMGen != PalOAMGenSent);
+        if (j.PalChanged)
+        {
+            memcpy(j.PalOAM, Palette, 2048);
+            memcpy(j.PalOAM + 2048, OAM, 2048);
+            PalOAMGenSent = PalOAMGen;
+        }
+    }
+    JobOpen = true;
+}
+
+void Push2D(u32 kind, u32 line, bool drawline, bool drawsprites)
+{
+    Begin2D(kind, line, drawline, drawsprites);
+    Publish2D();
+}
+
+// One scanline: extends the open job while nothing the worker reads changed,
+// so most frames need a handful of jobs instead of one per line.
+void PushLine2D(u32 line, bool drawline, bool drawsprites)
+{
+    if (JobOpen)
+    {
+        Job2D& j = Jobs2D[Job2DHead % Job2DCount];
+        if (j.Kind == Job_Line && j.Last + 1 == line && VCount == j.VCount + (line - j.First) &&
+            j.DrawLine == drawline && j.DrawSprites == drawsprites &&
+            GPU2D_A.RegGen == SentRegGen[0] && GPU2D_B.RegGen == SentRegGen[1] &&
+            PalOAMGen == PalOAMGenSent && !FIFOMode(&GPU2D_A) && !FIFOMode(&GPU2D_B))
+        {
+            j.Last = line;
+            if (j.Last - j.First + 1 >= Job2DBatch || line >= 190)
+                Publish2D();
+            return;
+        }
+    }
+    Begin2D(Job_Line, line, drawline, drawsprites);
+    if (line >= 190)
+        Publish2D();
+}
+
+// Renderer configuration for the emulation thread (sync) or the worker.
+void Configure2D(bool worker)
+{
+    GPU2D::Renderer2D* r = GPU2D_Renderer.get();
+    r->DeferVRAMSync = worker;
+    r->UseJobVCount = worker;
+    r->PalBase = worker ? WorkPalOAM : Palette;
+    r->OAMBase = worker ? WorkPalOAM + 2048 : OAM;
+}
+
+// Worker units start as copies of the emulation side.
+void ResyncWorkUnits()
+{
+    memcpy((void*)WorkUnits[0], (const void*)&GPU2D_A, sizeof(GPU2D::Unit));
+    memcpy((void*)WorkUnits[1], (const void*)&GPU2D_B, sizeof(GPU2D::Unit));
+    memcpy(LastOwnedGen[0], GPU2D_A.OwnedGen, sizeof(LastOwnedGen[0]));
+    memcpy(LastOwnedGen[1], GPU2D_B.OwnedGen, sizeof(LastOwnedGen[1]));
+    PalOAMGenSent = ~0u;
+    SentRegGen[0] = SentRegGen[1] = ~0u;
+}
+
+void Start2DThread()
+{
+    if (Thread2DRunning.load()) return;
+    if (!Jobs2D) Jobs2D = new Job2D[Job2DCount];
+    if (!WorkUnits[0]) { WorkUnits[0] = new GPU2D::Unit(0); WorkUnits[1] = new GPU2D::Unit(1); }
+    Sema2DJobs = Platform::Semaphore_Create();
+    Sema2DFree = Platform::Semaphore_Create();
+    Sema2DFence = Platform::Semaphore_Create();
+    Platform::Semaphore_Post(Sema2DFree, Job2DCount);
+    Job2DHead = Job2DTail = 0;
+    Queued2D = false;
+    JobOpen = false;
+    Thread2DRunning = true;
+    Thread2D = Platform::Thread_Create(Worker2D);
+    ResyncWorkUnits();
+}
+
+void Stop2DThread()
+{
+    if (!Thread2DRunning.load()) return;
+    Drain2D();
+    Thread2DRunning.store(false, std::memory_order_release);
+    Platform::Semaphore_Post(Sema2DJobs);
+    Platform::Thread_Wait(Thread2D);
+    Platform::Thread_Free(Thread2D);
+    Platform::Semaphore_Free(Sema2DJobs);
+    Platform::Semaphore_Free(Sema2DFree);
+    Platform::Semaphore_Free(Sema2DFence);
+    Sync2D = true;
+    Configure2D(false);
+}
+}
+
+void Drain2D()
+{
+    if (!Queued2D || !Thread2DRunning.load())
+        return;
+    Push2D(Job_Fence, 0, false, false);
+    Platform::Semaphore_Wait(Sema2DFence);
+    Queued2D = false;
+}
 
 #ifdef OGLRENDERER_ENABLED
 std::unique_ptr<GLCompositor> CurGLCompositor = {};
