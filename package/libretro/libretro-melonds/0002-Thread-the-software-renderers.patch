+    delete[] Jobs2D; Jobs2D = nullptr;
+    delete WorkUnits[0]; delete WorkUnits[1];
+    WorkUnits[0] = WorkUnits[1] = nullptr;
     GPU2D_Renderer.reset();
     GPU3D::DeInit();
 
