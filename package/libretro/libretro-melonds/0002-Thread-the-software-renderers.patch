         NDS::CheckDMAs(0, 0x02);
     }
@@ -1047,8 +1405,17 @@ void StartHBlank(u32 line)
     }
     else if (VCount == 262 && !FrameSkipNext)
     {
-        GPU2D_Renderer->DrawSprites(0, &GPU2D_A);
-        GPU2D_Renderer->DrawSprites(0, &GPU2D_B);
+        if (!Sync2D)
+        {
+            GPU2D_Renderer->SyncVRAM(0, true);
