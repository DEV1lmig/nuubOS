From 407b64b64387feba1bf0709c0dee160f893b1df1 Mon Sep 17 00:00:00 2001
From: nuubOS <nuubos@localhost>
Date: Sun, 18 Oct 2026 08:50:15 +0200
Subject: [PATCH] Do not detach threads after joining them (nuubOS)

Platform::Thread_Wait (sthread_join) already frees the libretro thread
handle; every caller then called Thread_Free, which ran pthread_detach
on the id read from the freed handle. With the extra renderer threads
(patches 0002, 0012, 0014) this made RetroArch hang at quit (the main
thread stuck in GPU::Stop2DThread with no worker left) or crash with
SIGSEGV. Thread_Free is now empty: nothing else is left to release.
---
 src/libretro/platform.cpp | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/libretro/platform.cpp b/src/libretro/platform.cpp
index 3a4f6f6..c480fb2 100644
--- a/src/libretro/platform.cpp
+++ b/src/libretro/platform.cpp
@@ -189,11 +189,11 @@ namespace Platform
       return true;
    }
 
+   // nuubOS: every caller frees a thread after Thread_Wait, and sthread_join
+   // already released it; detaching it again read freed memory
+   // (pthread_detach on a stale id: hangs and crashes when the core quits)
    void Thread_Free(Thread *thread)
    {
-   #if HAVE_THREADS
-      sthread_detach((sthread_t*)thread);
-   #endif
    }
 
    struct ThreadData
