From a8e08c80121b8350badad54ee8d6428741a9929d Mon Sep 17 00:00:00 2001
From: nuubOS <nuubos@localhost>
Date: Sun, 18 Oct 2026 09:05:12 +0200
Subject: [PATCH] Map the ROM file instead of copying it (nuubOS)

RetroArch read the whole ROM into memory (the core's content override
asked for it) and the core copied it again: Pokemon Black 2 (512 MB) was
killed by the OOM killer on the 1 GB H700 devices. The core now opens
the ROM by path (need_fullpath, no content override) and maps it
privately (MAP_PRIVATE over a zeroed region of the power-of-two size):
the pages are page cache, copied only where the emulator writes (secure
area). Reset reloads from the path. Pokemon Black 2: RSS 210 MB.
---
 src/NDSCart.cpp           | 72 ++++++++++++++++++++++++++++++++++-----
 src/libretro/libretro.cpp | 26 +++++++-------
 2 files changed, 76 insertions(+), 22 deletions(-)

diff --git a/src/NDSCart.cpp b/src/NDSCart.cpp
index d0affcb..a5de1c8 100644
--- a/src/NDSCart.cpp
+++ b/src/NDSCart.cpp
@@ -32,6 +32,10 @@
 #ifdef __LIBRETRO__
 #undef __LIBRETRO_SDK_FILE_STREAM_TRANSFORMS_H
 #include <streams/file_stream_transforms.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <unistd.h>
 #endif
 
 namespace NDSCart
@@ -1399,6 +1403,58 @@ void CartHomebrew::ReadROM_B7(u32 addr, u32 len, u8* data, u32 offset)
 
 
 
+// nuubOS: a ROM loaded from a file is a private mapping of it (page cache,
+// copied only where the emulator writes): a 512 MB ROM no longer takes
+// 512 MB of the 1 GB of RAM. CartROMMapSize is its length, 0 for new[].
+size_t CartROMMapSize = 0;
+
+void FreeCartROM()
+{
+    if (CartROM && CartROMMapSize)
+        munmap(CartROM, CartROMMapSize);
+    else if (CartROM)
+        delete[] CartROM;
+    CartROM = nullptr;
+    CartROMMapSize = 0;
+}
+
+// The file at the start of a zeroed region of CartROMSize bytes.
+bool MapCartROM(const char* path, u32* len)
+{
+    struct stat st;
+    int fd = ::open(path, O_RDONLY | O_CLOEXEC);
+    if (fd < 0)
+        return false;
+    if (fstat(fd, &st) != 0 || st.st_size <= 0 || st.st_size > 0x40000000)
+    {
+        ::close(fd);
+        return false;
+    }
+
+    u32 size = 0x200;
+    while (size < (u32)st.st_size)
+        size <<= 1;
+    void* base = mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (base == MAP_FAILED)
+    {
+        ::close(fd);
+        return false;
+    }
+    if (mmap(base, st.st_size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_FIXED, fd, 0) == MAP_FAILED)
+    {
+        munmap(base, size);
+        ::close(fd);
+        return false;
+    }
+    ::close(fd);
+
+    CartROM = (u8*)base;
+    CartROMSize = size;
+    CartROMMapSize = size;
+    *len = (u32)st.st_size;
+    return true;
+}
+
 bool Init()
 {
     CartROM = nullptr;
@@ -1409,15 +1465,14 @@ bool Init()
 
 void DeInit()
 {
-    if (CartROM) delete[] CartROM;
+    FreeCartROM();
     if (Cart) delete Cart;
 }
 
 void Reset()
 {
     CartInserted = false;
-    if (CartROM) delete[] CartROM;
-    CartROM = nullptr;
+    FreeCartROM();
     CartROMSize = 0;
     CartID = 0;
     CartIsHomebrew = false;
@@ -1665,9 +1720,12 @@ bool LoadROMCommon(u32 filelength, const char *sram, bool direct)
 
 bool LoadROM(const char* path, const char* sram, bool direct)
 {
-    // TODO: streaming mode? for really big ROMs or systems with limited RAM
-    // for now we're lazy
-    // also TODO: validate what we're loading!!
+    // TODO: validate what we're loading!!
+
+    NDS::Reset();
+    u32 maplen;
+    if (MapCartROM(path, &maplen))
+        return LoadROMCommon(maplen, sram, direct);
 
     FILE* f = Platform::OpenFile(path, "rb");
     if (!f)
@@ -1675,8 +1733,6 @@ bool LoadROM(const char* path, const char* sram, bool direct)
         return false;
     }
 
-    NDS::Reset();
-
     fseek(f, 0, SEEK_END);
     u32 len = (u32)ftell(f);
 
