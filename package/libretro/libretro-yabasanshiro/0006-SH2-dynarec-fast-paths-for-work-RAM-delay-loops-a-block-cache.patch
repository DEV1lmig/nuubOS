+/* nuubOS: the JIT calls these for every SH2 load. Cached work RAM
+ * (0x06xxxxxx high, 0x002xxxxx low) costs no extra cycles there and is
+ * read here without a stack frame; anything else, including the
+ * cache-through mirrors, goes to the handlers above. memGetLong +
+ * memGetWord were 13 % of the emulation thread (Virtua Fighter 2). */
+u8 memGetByteFast(u32 addr)
+{
+  if ((addr & 0xFFF00000) == 0x06000000)
+    return T2ReadByte(HighWram, addr & 0xFFFFF);
+  if ((addr & 0xFFF00000) == 0x00200000)
+    return T2ReadByte(LowWram, addr & 0xFFFFF);
+  return memGetByte(addr);
+}
+
+u16 memGetWordFast(u32 addr)
+{
+  if ((addr & 0xFFF00000) == 0x06000000)
+    return T2ReadWord(HighWram, addr & 0xFFFFF);
+  if ((addr & 0xFFF00000) == 0x00200000)
+    return T2ReadWord(LowWram, addr & 0xFFFFF);
+  return memGetWord(addr);
+}
+
+/* Writes to cached high work RAM where no code was compiled from (the
+ * setDirty bitmap of patch 0002 is clear for those halfwords) need only
+ * the store; the rest goes to the handlers. */
+CompileBlocks *nuubCompileBlocks; /* set by DynarecSh2() */
+
+static inline bool hwramNoCode(u32 addr, u32 halfwords)
+{
+  u32 i = adress_mask(addr);
+  u32 mask = ((1u << halfwords) - 1) << (i & 7);
+  return !(nuubCompileBlocks->parent_bits_[i >> 3] & mask);
+}
+
+void memSetByteFast(u32 addr, u8 data)
+{
+  if ((addr & 0xFFF00000) == 0x06000000 && hwramNoCode(addr, 1)) {
+    T2WriteByte(HighWram, addr & 0xFFFFF, data);
+    return;
+  }
+  memSetByte(addr, data);
+}
+
+void memSetWordFast(u32 addr, u16 data)
+{
+  if ((addr & 0xFFF00001) == 0x06000000 && hwramNoCode(addr, 1)) {
+    T2WriteWord(HighWram, addr & 0xFFFFF, data);
+    return;
+  }
+  memSetWord(addr, data);
+}
+
+void memSetLongFast(u32 addr, u32 data)
+{
+  if ((addr & 0xFFF00003) == 0x06000000 && hwramNoCode(addr, 2)) {
+    T2WriteLong(HighWram, addr & 0xFFFFF, data);
+    return;
+  }
+  memSetLong(addr, data);
+}
+
+u32 memGetLongFast(u32 addr)
+{
+  if ((addr & 0xFFF00000) == 0x06000000)
+    return T2ReadLong(HighWram, addr & 0xFFFFF);
+  if ((addr & 0xFFF00000) == 0x00200000)
+    return T2ReadLong(LowWram, addr & 0xFFFFF);
+  return memGetLong(addr);
+}
+
 
