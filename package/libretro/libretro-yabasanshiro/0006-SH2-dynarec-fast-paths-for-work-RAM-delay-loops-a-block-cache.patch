+  /* nuubOS: the last blocks run, by PC, with their flags. The dispatcher
+   * found each block in a 4 MB table and read its flags 4 KB past its
+   * code: two cache misses per block (7 % of the emulation thread in
+   * Virtua Fighter 2). Every table entry is cleared through kill(),
+   * which drops the cached one with the same index. */
+  struct JcEntry { u32 pc; u32 flags; Block *b; };
+  enum { JC_SIZE = 8192 };
+  JcEntry jc_[JC_SIZE];
+  inline void kill(Block **table, u32 index) {
+    table[index] = NULL;
+    jc_[index & (JC_SIZE - 1)].pc = 0xFFFFFFFF;
+  }
   
