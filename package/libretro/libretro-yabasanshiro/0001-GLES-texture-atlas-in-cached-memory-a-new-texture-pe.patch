   int current;
-  GLuint textureID_in[2];
+  /* nuubOS: one CPU copy of the atlas (texture_in[0]) and YGL_TM_TEXTURES
+   * GL textures, a different one for each upload, so an upload never has
+   * to wait for the GPU to finish drawing with the one before. */
+#define YGL_TM_TEXTURES 4
+  GLuint textureID_in[YGL_TM_TEXTURES];
   GLuint pixelBufferID_in[2];
   unsigned int * texture_in[2];
 
