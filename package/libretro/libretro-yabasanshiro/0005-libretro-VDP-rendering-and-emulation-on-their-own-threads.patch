--- /dev/null
+++ b/yabause/src/nuub_vdp2view.h
@@ -0,0 +1,32 @@
+/* nuubOS: the VDP thread composes frame N (VBlank-IN) while the SH2s
+ * already run frame N+1 and change the VDP2 registers. During that work
+ * the renderer reads the copy vdp2.cpp takes at VBlank-IN, otherwise the
+ * live state. Included last, by the renderer's own files only. */
+#ifndef NUUB_VDP2VIEW_H
+#define NUUB_VDP2VIEW_H
+
+#include "vdp2.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern Vdp2 *nuub_vdp2_regs_view;  /* NULL: the live registers */
+extern Vdp2 *nuub_vdp2_lines_view; /* NULL: the live per-line copies */
+#ifdef __cplusplus
+}
+#endif
+
+static inline Vdp2 *nuub_vdp2_regs(void)
+{
+  return nuub_vdp2_regs_view ? nuub_vdp2_regs_view : Vdp2Regs;
+}
+
+static inline Vdp2 *nuub_vdp2_lines(void)
+{
+  return nuub_vdp2_lines_view ? nuub_vdp2_lines_view : Vdp2Lines;
+}
+
+#define Vdp2Regs (nuub_vdp2_regs())
+#define Vdp2Lines (nuub_vdp2_lines())
+
+#endif
