@@ -347,6 +351,35 @@
 	queueRunner_.CopyFromReadbackBuffer(nullptr, w, h, Draw::DataFormat::R8G8B8A8_UNORM, destFormat, pixelStride, pixels);
 }
 
+// Unsynchronized push buffers are written again from the start when their frame slot comes
+// round: the render thread fences the frame's GPU work and the emu thread waits for that
+// fence before it reuses the slot, so the GPU never reads a buffer being rewritten.
+static void FencePushBuffers(GLFrameData &frameData) {
+#ifdef NUUBOS_PUSH_FENCE
+	EGLDisplay display = eglGetCurrentDisplay();
+	if (display == EGL_NO_DISPLAY)
+		return;
+	EGLSync fence = eglCreateSync(display, EGL_SYNC_FENCE, nullptr);
+	if (fence == EGL_NO_SYNC)
+		return;
+	glFlush();
+	if (frameData.pushFence)
+		eglDestroySync((EGLDisplay)frameData.pushFenceDisplay, (EGLSync)frameData.pushFence);
+	frameData.pushFenceDisplay = display;
+	frameData.pushFence = fence;
+#endif
+}
+
+static void WaitPushBuffers(GLFrameData &frameData) {
+#ifdef NUUBOS_PUSH_FENCE
+	if (!frameData.pushFence)
+		return;
+	eglClientWaitSync((EGLDisplay)frameData.pushFenceDisplay, (EGLSync)frameData.pushFence, 0, 1000000000ULL);
+	eglDestroySync((EGLDisplay)frameData.pushFenceDisplay, (EGLSync)frameData.pushFence);
+	frameData.pushFence = nullptr;
+#endif
+}
+
 void GLRenderManager::BeginFrame(bool enableProfiling) {
 #ifdef _DEBUG
 	curProgram_ = nullptr;
@@ -374,6 +407,7 @@
 		}
 		frameData.readyForFence = false;
 	}
+	WaitPushBuffers(frameData);
 
 	insideFrame_ = true;
 }
@@ -464,6 +498,9 @@
 		}
 		frameData.hasBegun = false;
 
+		if ((bufferStrategy_ & GLBufferStrategy::MASK_UNSYNCHRONIZED) && !skipGLCalls_)
+			FencePushBuffers(frameData);
+
 		VLOG("  PULL: Frame %d.readyForFence = true", task.frame);
 
 		{
