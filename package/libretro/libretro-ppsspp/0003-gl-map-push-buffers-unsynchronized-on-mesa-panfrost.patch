 };
--- a/Common/GPU/OpenGL/GLRenderManager.cpp
+++ b/Common/GPU/OpenGL/GLRenderManager.cpp
@@ -11,6 +11,10 @@
 #include "Common/StringUtils.h"
 
 #include <cstring>
+#if defined(__linux__) && !defined(__ANDROID__)
+#include <EGL/egl.h>
+#define NUUBOS_PUSH_FENCE 1
+#endif
 #include "Common/Math/math_util.h"
 
 #if 0 // def _DEBUG
@@ -97,7 +101,7 @@
 			// buffer that the previous frame still reads; an invalidating map
 			// gets a fresh buffer object instead and never waits.
 			if (gl_extensions.gpuVendor == GPU_VENDOR_MESA && strstr(gl_extensions.model, "Mali") != nullptr)
-				bufferStrategy_ = GLBufferStrategy::INVALIDATE_UNMAP;
+				bufferStrategy_ = GLBufferStrategy::FRAME_UNMAP_UNSYNCHRONIZED;
