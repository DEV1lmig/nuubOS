From: nuubOS Project <noreply@nuubos.invalid>
Subject: [PATCH] nuubOS dynamic CPU clock

When the H700 cannot emulate a game at 60 vblanks a second, PPSSPP ran
the whole game in slow motion (God of War: Chains of Olympus fights at
28.6 of 60). New core option ppsspp_nuubos_dynamic_clock (enabled): once
a second the libretro frontend lowers a cap on the emulated CPU clock
(game clock -> 266 -> 222 -> 166 -> 111 MHz) below 57 vblanks, and
raises it when the emulation thread's CPU time scaled by the next step
still fits (busy x ratio < 88 %). scePower runs the CPU at min(game
clock, cap) while the game keeps seeing its own clock; a game short of
cycles then needs two vblanks a frame and draws 30 fps at its own
speed. God of War with auto frameskip 1: 60 vblanks, 30 fps drawn,
settling at 166/111 MHz. A clock the user locked wins; the lock option
gains 111 and 166 MHz. Cap changes are logged on stderr, a per-second
trace with NUUBOS_PPSSPP_TRACE or /run/nuubos/ppsspp-trace.

Upstream-Status: Inappropriate [nuubOS specific]
---
--- a/Core/HLE/scePower.cpp
+++ b/Core/HLE/scePower.cpp
@@ -68,6 +68,19 @@
 static int pllFreq = 222000000;
 static int busFreq = 111000000;
 
+// nuubOS: a cap (MHz, 0 = none) on the emulated CPU clock, set by the
+// libretro frontend when the host cannot keep up (dynamic clock): the CPU
+// runs at min(the game's clock, cap) while the game keeps seeing its own.
+static int nuubCapMhz = 0;
+static int nuubGameCpuMhz = 222;
+int PowerCpuMhzToHz(int desired, int pllHz);
+
+static void ApplyCpuClock(int cpufreq) {
+	nuubGameCpuMhz = cpufreq;
+	int mhz = (nuubCapMhz > 0 && nuubCapMhz < cpufreq) ? nuubCapMhz : cpufreq;
+	CoreTiming::SetClockFrequencyHz(PowerCpuMhzToHz(mhz, pllFreq));
+}
+
 int GetLockedCPUSpeedMhz() {
 	return PSP_CoreParameter().compat.flags().RequireDefaultCPUClock ? 0 : g_Config.iLockedCPUSpeed;
 }
@@ -164,6 +177,11 @@
 	} else {
 		pllFreq = RealpllFreq;
 		busFreq = RealbusFreq;
+		// the game's clock is its PLL's (a state saved under a cap keeps
+		// the capped CoreTiming frequency)
+		nuubGameCpuMhz = RealpllFreq / 1000000;
+		if (nuubCapMhz > 0)
+			ApplyCpuClock(nuubGameCpuMhz);
 	}
 	DoArray(p, powerCbSlots, ARRAY_SIZE(powerCbSlots));
 	Do(p, volatileMemLocked);
@@ -458,7 +476,7 @@
 		if (GetLockedCPUSpeedMhz() <= 0) {
 			pllFreq = RealpllFreq;
 			busFreq = RealbusFreq;
-			CoreTiming::SetClockFrequencyHz(PowerCpuMhzToHz(cpufreq, pllFreq));
+			ApplyCpuClock(cpufreq);
 		}
 
 		// The delay depends on the source and destination frequency, most are 150ms.
@@ -472,7 +490,7 @@
 		return hleDelayResult(hleNoLog(0), "scepower set clockFrequency", usec);
 	}
 	if (GetLockedCPUSpeedMhz() <= 0)
-		CoreTiming::SetClockFrequencyHz(PowerCpuMhzToHz(cpufreq, pllFreq));
+		ApplyCpuClock(cpufreq);
 	return hleNoLog(0);
 }
 
@@ -483,7 +501,7 @@
 	if (GetLockedCPUSpeedMhz() > 0) {
 		return hleLogDebug(Log::sceMisc, 0, "locked by user config at %i", GetLockedCPUSpeedMhz());
 	}
-	CoreTiming::SetClockFrequencyHz(PowerCpuMhzToHz(cpufreq, pllFreq));
+	ApplyCpuClock(cpufreq);
 	return hleLogDebug(Log::sceMisc, 0);
 }
 
@@ -637,3 +655,15 @@
 void Register_sceSuspendForUser() {
 	RegisterHLEModule("sceSuspendForUser", ARRAY_SIZE(sceSuspendForUser), sceSuspendForUser);
 }
+
+// nuubOS dynamic clock (see nuubCapMhz).
+void __PowerSetCpuClockCap(int mhz) {
+	if (GetLockedCPUSpeedMhz() > 0 || mhz == nuubCapMhz)
+		return;
+	nuubCapMhz = mhz;
+	ApplyCpuClock(nuubGameCpuMhz);
+}
+
+int __PowerGetGameCpuMhz() {
+	return nuubGameCpuMhz;
+}
