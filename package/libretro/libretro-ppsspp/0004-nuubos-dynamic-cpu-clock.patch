+#include "Core/HW/Display.h"
+#include "Core/HLE/scePower.h"
+#include <pthread.h>
+#include <time.h>
+#include <unistd.h>
+
+/*
+ * nuubOS dynamic clock (ppsspp_nuubos_dynamic_clock, H700): when the host
+ * cannot emulate 60 vblanks a second, the emulated CPU clock is capped a
+ * step lower (game clock -> 266 -> 222 -> 166 -> 111 MHz): a game that
+ * then needs two vblanks a frame draws 30 fps at full game speed instead
+ * of running in slow motion. Once a second: below 57 vblanks the cap goes
+ * down a step; at full speed it goes up when the emulation thread's CPU
+ * time, scaled by the next step, still fits (busy x ratio < 88 %). God of
+ * War: Chains of Olympus fights: 28.6 vblanks a second at 333 MHz, 60 at
+ * 111 MHz (with frameskip). A clock the user locked wins.
+ */
+namespace Libretro { extern bool useEmuThread; pthread_t EmuThreadHandle(); }
+
+static void nuubos_clock_governor(void)
+{
+   static const int caps[] = { 0, 266, 222, 166, 111 };
+   static int frames, level, hold;
+   static double last_wall, last_cpu;
+   float vps, fps, actual;
+   double wall, cpu = 0.0, busy = 0.0;
+   struct timespec t;
+
+   if (++frames < 60)
+      return;
+   frames = 0;
+   if (!nuubos_dynamic_clock || g_Config.iLockedCPUSpeed > 0)
+   {
+      if (level)
+         __PowerSetCpuClockCap(level = 0);
+      return;
+   }
+   __DisplayGetFPS(&vps, &fps, &actual);
+   clock_gettime(CLOCK_MONOTONIC, &t);
+   wall = t.tv_sec + t.tv_nsec / 1e9;
+   if (Libretro::useEmuThread)
+   {
+      clockid_t id;
+      if (pthread_getcpuclockid(Libretro::EmuThreadHandle(), &id) == 0 && clock_gettime(id, &t) == 0)
+         cpu = t.tv_sec + t.tv_nsec / 1e9;
+   }
+   if (last_wall > 0.0 && wall > last_wall)
+      busy = (cpu - last_cpu) / (wall - last_wall);
+   last_wall = wall;
+   last_cpu = cpu;
+
+   {
+      static int trace = -1;
+      if (trace < 0)
+         trace = getenv("NUUBOS_PPSSPP_TRACE") != nullptr || access("/run/nuubos/ppsspp-trace", F_OK) == 0;
+      if (trace)
+      {
+         char b[128];
+         int n = snprintf(b, sizeof(b), "ppsspp-nuubos: vps %.1f fps %.1f busy %.2f cap %d\n", vps, actual, busy, caps[level]);
+         (void)!write(2, b, n);
+      }
+   }
+   int was = level;
+   if (hold > 0)
+      hold--;
+   else if (vps < 57.0f && level < 4)
+   {
+      __PowerSetCpuClockCap(caps[++level]);
+      hold = 2;
+   }
+   else if (level > 0 && vps >= 59.0f && busy > 0.0)
+   {
+      int game = __PowerGetGameCpuMhz();
+      int now  = caps[level] < game ? caps[level] : game;
+      int next = (level == 1 || caps[level - 1] > game) ? game : caps[level - 1];
+      if (busy * next / now < 0.88)
+      {
+         __PowerSetCpuClockCap(caps[--level]);
+         hold = 3;
+      }
+   }
+   if (level != was)
+   {
+      char b[96];
+      int n = snprintf(b, sizeof(b), "ppsspp-nuubos: CPU clock cap %d MHz (%.1f vblanks/s)\n", caps[level], vps);
+      (void)!write(2, b, n);
+   }
+}
+
 void retro_run(void)
 {
+   nuubos_clock_governor();
    if (g_pendingBoot) {
       BootState state = PSP_InitUpdate(&g_bootErrorString);
       switch (state) {
