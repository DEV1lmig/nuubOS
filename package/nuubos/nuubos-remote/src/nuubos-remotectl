#!/bin/sh
# nuubOS Remote Services and device credential (EPIC-037, EPIC-039).
#
#   start | stop                  boot/shutdown: prepare, then run the enabled services
#   status                        ssh= smb= web= (enabled) running_*= address= user=
#   set ssh|smb|web 0|1           enable/disable a service (persists device-wide)
#   credential show               the device password (local trusted console only)
#   credential regenerate         new random password; the old one stops working
#   keys list                     key=<SHA256 fingerprint>\t<type>\t<comment> rows
#   keys add                      add the OpenSSH public key line read on stdin
#   keys remove FINGERPRINT       remove that key
#
# One device-global credential (user "root") for SSH/SCP/SFTP, SMB file
# sharing and Web administration. It is generated randomly per device on
# first start and never shipped. Secrets live in STATE, root only:
#   /state/remote/credential      the password (Web administration sign-in
#                                 reads it on every attempt: nuubos-admind)
#   /state/remote/root.hash       its crypt(3) hash for /etc/shadow
#   /state/remote/ksmbd/          SMB user database
#   /state/remote/web-key.pem     Web administration TLS key and its
#   /state/remote/web-cert.pem    self-signed certificate (per device)
# SSH (Dropbear) signs root in with the credential or with one of the public
# keys in /state/ssh/root/authorized_keys (/root/.ssh links there; added from
# the Web administration). Keys are plain keys: no options, no certificates.
# The rootfs /etc/shadow is replaced by image updates, so every start
# re-applies the hash. The serial console logs in without a password (getty -n -l
# nuubos-console-login). Every service is disabled by default.
# Services only listen on the local network the console is on; Internet
# exposure is not supported.
# NUUBOS_ROOT prefixes the STATE/etc paths for the host test; daemons are
# not touched when NUUBOS_REMOTE_NO_DAEMONS=1.

R="${NUUBOS_ROOT:-}"
DIR="$R/state/remote"
CONF="$R/state/config/remote.conf"
CRED="$DIR/credential"
WEB_KEY="$DIR/web-key.pem"
WEB_CERT="$DIR/web-cert.pem"
WEB_FP="$DIR/web-cert.sha256"
KSMBD_DIR="$DIR/ksmbd"
ROOT_HASH="$DIR/root.hash"
SHADOW="$R/etc/shadow"
KEYS="$R/state/ssh/root/authorized_keys"
KEY_TYPES="ssh-ed25519 ecdsa-sha2-nistp256 ecdsa-sha2-nistp384 ecdsa-sha2-nistp521 ssh-rsa"
MAX_KEYS=32
USER_NAME=root
NO_DAEMONS="${NUUBOS_REMOTE_NO_DAEMONS:-0}"

log() { echo "nuubos-remote: $*" >&2; }

conf_get()
{
    sed -n "s/^$1=//p" "$CONF" 2>/dev/null | tail -n 1
}

conf_set()
{
    mkdir -p "${CONF%/*}"
    tmp="$CONF.tmp.$$"
    { grep -v "^$1=" "$CONF" 2>/dev/null; echo "$1=$2"; } > "$tmp" &&
        chmod 600 "$tmp" && mv "$tmp" "$CONF"
}

# 12 random characters without look-alikes, shown as xxxx-xxxx-xxxx.
new_password()
{
    raw="$(tr -dc 'abcdefghjkmnpqrstuvwxyz23456789' < /dev/urandom 2>/dev/null | head -c 12)"
    [ "${#raw}" -eq 12 ] || return 1
    printf '%s-%s-%s\n' "$(echo "$raw" | cut -c1-4)" "$(echo "$raw" | cut -c5-8)" "$(echo "$raw" | cut -c9-12)"
}

prepare_dir()
{
    mkdir -p "$DIR" && chmod 700 "$DIR"
}

# root's /etc/shadow field = the stored hash (rootfs copy, may be stale).
apply_shadow()
{
    h="$(cat "$ROOT_HASH" 2>/dev/null)"
    [ -n "$h" ] && [ -f "$SHADOW" ] || return 1
    [ "$(sed -n 's/^root:\([^:]*\):.*/\1/p' "$SHADOW")" = "$h" ] && return 0
    awk -F: -v OFS=: -v h="$h" '$1 == "root" { $2 = h } { print }' "$SHADOW" > "$SHADOW.tmp" &&
        chmod 600 "$SHADOW.tmp" && mv "$SHADOW.tmp" "$SHADOW"
}

# Apply a password to every consumer.
apply_password()
{
    pw="$1"
    h="$(printf '%s' "$pw" | mkpasswd -m sha512 -P 0)" && [ -n "$h" ] || return 1
    printf '%s\n' "$h" > "$ROOT_HASH.tmp" && chmod 600 "$ROOT_HASH.tmp" &&
        mv "$ROOT_HASH.tmp" "$ROOT_HASH" && apply_shadow || return 1
    mkdir -p "$KSMBD_DIR" && chmod 700 "$KSMBD_DIR"
    if [ "$NO_DAEMONS" != 1 ] && command -v ksmbd.adduser >/dev/null 2>&1; then
        rm -f "$KSMBD_DIR/ksmbdpwd.db"
        ksmbd.adduser -P "$KSMBD_DIR/ksmbdpwd.db" -C /etc/nuubos/ksmbd.conf -a "$USER_NAME" -p "$pw" >/dev/null 2>&1 ||
            log "SMB user update failed"
    fi
    sync
}

ensure_credential()
{
    if [ ! -s "$CRED" ]; then
        pw="$(new_password)" || { log "no randomness for the credential"; return 1; }
        printf '%s\n' "$pw" > "$CRED.tmp" && chmod 600 "$CRED.tmp" && mv "$CRED.tmp" "$CRED" || return 1
        apply_password "$pw" || return 1
        log "generated the device credential"
    elif [ ! -s "$ROOT_HASH" ]; then
        apply_password "$(cat "$CRED")" || return 1
    else
        apply_shadow || return 1
    fi
    chmod 600 "$CRED"
    # The Web administration used HTTP digest files before 0.2.
    rm -f "$DIR/web.htdigest"
}

ensure_conf()
{
    [ -f "$CONF" ] && return 0
    mkdir -p "${CONF%/*}" || return 1
    printf 'NUUBOS_REMOTE_VERSION=1\nSSH=0\nSMB=0\nWEB=0\n' > "$CONF.tmp" &&
        chmod 600 "$CONF.tmp" && mv "$CONF.tmp" "$CONF"
}

prepare()
{
    prepare_dir && ensure_credential && ensure_conf
}

enabled() { [ "$(conf_get "$(echo "$1" | tr a-z A-Z)")" = 1 ]; }

# ---------------------------------------------------------- public keys

# The ssh-keygen fingerprint of a base64 key blob: SHA256:<base64, no =>.
key_fp()
{
    printf 'SHA256:%s\n' "$(printf '%s' "$1" | base64 -d 2>/dev/null | sha256sum | cut -c1-64 | xxd -r -p | base64 | tr -d '=\n')"
}

keys_list()
{
    [ -r "$KEYS" ] || return 0
    while read -r type blob comment; do
        case "$type" in ''|'#'*) continue ;; esac
        printf 'key=%s\t%s\t%s\n' "$(key_fp "$blob")" "$type" "$comment"
    done < "$KEYS"
}

keys_write()
{
    mkdir -p "${KEYS%/*}" && chmod 700 "${KEYS%/*}" &&
        chmod 600 "$KEYS.tmp" && mv "$KEYS.tmp" "$KEYS"
}

# One "type base64 [comment]" line; its blob must decode and name its type.
keys_add()
{
    IFS= read -r line || [ -n "$line" ] || { echo "ERR key"; return 2; }
    line="$(printf '%s' "$line" | tr -d '\r' | tr '\t' ' ')"
    set -f
    # shellcheck disable=SC2086
    set -- $line
    set +f
    type="${1:-}"; blob="${2:-}"
    [ $# -ge 2 ] && shift 2 || { echo "ERR key"; return 2; }
    # Control characters out (BusyBox tr has no [:print:] class).
    comment="$(printf '%s' "$*" | tr -d '\000-\037\177' | cut -c1-100)"
    case " $KEY_TYPES " in *" $type "*) ;; *) echo "ERR type"; return 2 ;; esac
    printf '%s' "$blob" | grep -Eq '^[A-Za-z0-9+/]{40,}={0,2}$' || { echo "ERR key"; return 2; }
    named="$(printf '%s' "$blob" | base64 -d 2>/dev/null | head -c $((4 + ${#type})) | tail -c ${#type})"
    [ "$named" = "$type" ] || { echo "ERR key"; return 2; }
    fp="$(key_fp "$blob")"
    keys_list | grep -q "^key=$fp	" && { echo "ERR exists"; return 1; }
    [ "$(keys_list | wc -l)" -lt "$MAX_KEYS" ] || { echo "ERR full"; return 1; }
    mkdir -p "${KEYS%/*}" || { echo "ERR storage"; return 1; }
    { cat "$KEYS" 2>/dev/null; printf '%s %s%s\n' "$type" "$blob" "${comment:+ $comment}"; } > "$KEYS.tmp" &&
        keys_write || { echo "ERR storage"; return 1; }
    echo "OK $fp"
}

keys_remove()
{
    fp="${1:-}"
    [ -n "$fp" ] && keys_list | grep -q "^key=$fp	" || { echo "ERR missing"; return 1; }
    : > "$KEYS.tmp" || { echo "ERR storage"; return 1; }
    while IFS= read -r l; do
        set -f
        # shellcheck disable=SC2086
        set -- $l
        set +f
        [ $# -ge 2 ] && [ "$(key_fp "$2")" = "$fp" ] && continue
        printf '%s\n' "$l" >> "$KEYS.tmp"
    done < "$KEYS"
    keys_write || { echo "ERR storage"; return 1; }
    echo OK
}

# ------------------------------------------------------------------ daemons

pid_alive() { [ -r "$1" ] && kill -0 "$(cat "$1" 2>/dev/null)" 2>/dev/null; }

start_ssh()
{
    pid_alive /var/run/dropbear.pid && return 0
    DROPBEAR_ARGS=""
    # shellcheck disable=SC1091
    [ -r /etc/default/dropbear ] && . /etc/default/dropbear
    # -R: create host keys on demand (they live in /state/ssh/dropbear).
    umask 077
    # shellcheck disable=SC2086
    start-stop-daemon -S -q -p /var/run/dropbear.pid --exec /usr/sbin/dropbear -- $DROPBEAR_ARGS -R
}

stop_ssh()
{
    start-stop-daemon -K -q -p /var/run/dropbear.pid 2>/dev/null
    rm -f /var/run/dropbear.pid
}

start_smb()
{
    pidof ksmbd.mountd >/dev/null 2>&1 && return 0
    modprobe ksmbd 2>/dev/null
    [ -s "$KSMBD_DIR/ksmbdpwd.db" ] || apply_password "$(cat "$CRED")"
    ksmbd.mountd -C /etc/nuubos/ksmbd.conf -P "$KSMBD_DIR/ksmbdpwd.db" >/dev/null 2>&1
}

stop_smb()
{
    ksmbd.control -s >/dev/null 2>&1
    rmmod ksmbd 2>/dev/null
    return 0
}

# The certificate names the console; a new one only when there is none
# (browsers remember the one they were asked to trust).
ensure_cert()
{
    [ -s "$WEB_KEY" ] && [ -s "$WEB_CERT" ] && return 0
    name="$(tr -cd 'A-Za-z0-9-' < /etc/hostname 2>/dev/null | cut -c1-63)"
    [ -n "$name" ] || name=nuubos
    fp="$(nuubos-web-cert "$WEB_KEY" "$WEB_CERT" "$name")" || { log "no TLS certificate"; return 1; }
    printf '%s\n' "$fp" > "$WEB_FP"
    log "created the Web administration certificate"
}

start_web()
{
    pid_alive /var/run/nuubos-web.pid && pid_alive /var/run/nuubos-admind.pid && return 0
    ensure_cert || return 1
    pid_alive /var/run/nuubos-admind.pid ||
        start-stop-daemon -S -q -b -m -p /var/run/nuubos-admind.pid --exec /usr/sbin/nuubos-admind -- --owner www-data
    # lighttpd opens its log after dropping to www-data.
    touch /run/nuubos/web.log && chown www-data:www-data /run/nuubos/web.log
    pid_alive /var/run/nuubos-web.pid || lighttpd -f /etc/nuubos/web/lighttpd.conf
}

stop_web()
{
    for p in /var/run/nuubos-web.pid /var/run/nuubos-admind.pid; do
        [ -r "$p" ] && kill "$(cat "$p")" 2>/dev/null
        rm -f "$p"
    done
}

running()
{
    case "$1" in
        ssh) pid_alive /var/run/dropbear.pid ;;
        smb) pidof ksmbd.mountd >/dev/null 2>&1 ;;
        web) pid_alive /var/run/nuubos-web.pid && pid_alive /var/run/nuubos-admind.pid ;;
    esac
}

apply()
{
    [ "$NO_DAEMONS" = 1 ] && return 0
    for s in ssh smb web; do
        if enabled "$s"; then "start_$s"; else "stop_$s"; fi
    done
}

address()
{
    ip -4 addr show wlan0 2>/dev/null | awk '/inet / { sub(/\/.*/, "", $2); print $2; exit }'
}

case "${1:-}" in
    start)
        prepare || exit 1
        apply
        ;;
    stop)
        [ "$NO_DAEMONS" = 1 ] || { stop_web; stop_smb; stop_ssh; }
        ;;
    status)
        prepare >/dev/null 2>&1
        for s in ssh smb web; do
            if enabled "$s"; then e=1; else e=0; fi
            if [ "$NO_DAEMONS" != 1 ] && running "$s"; then r=1; else r=0; fi
            printf '%s=%s\nrunning_%s=%s\n' "$s" "$e" "$s" "$r"
        done
        printf 'address=%s\nuser=%s\nweb_fingerprint=%s\nend=1\n' "$(address)" "$USER_NAME" "$(cat "$WEB_FP" 2>/dev/null)"
        ;;
    set)
        case "${2:-}:${3:-}" in
            ssh:0|ssh:1|smb:0|smb:1|web:0|web:1) ;;
            *) echo "ERR usage"; exit 2 ;;
        esac
        prepare || { echo "ERR prepare"; exit 1; }
        conf_set "$(echo "$2" | tr a-z A-Z)" "$3" || { echo "ERR storage"; exit 1; }
        if [ "$NO_DAEMONS" != 1 ]; then
            if [ "$3" = 1 ]; then "start_$2"; else "stop_$2"; fi
        fi
        echo OK
        ;;
    credential)
        prepare || { echo "ERR prepare"; exit 1; }
        case "${2:-}" in
            show) cat "$CRED" ;;
            regenerate)
                pw="$(new_password)" || { echo "ERR random"; exit 1; }
                printf '%s\n' "$pw" > "$CRED.tmp" && chmod 600 "$CRED.tmp" && mv "$CRED.tmp" "$CRED" || { echo "ERR storage"; exit 1; }
                apply_password "$pw" || { echo "ERR apply"; exit 1; }
                # A running SMB server reloads its database; Dropbear reads
                # /etc/shadow and nuubos-admind the credential at each
                # sign-in (its open sessions end with the old password).
                if [ "$NO_DAEMONS" != 1 ]; then
                    enabled smb && { stop_smb; start_smb; }
                fi
                echo OK
                ;;
            *) echo "ERR usage"; exit 2 ;;
        esac
        ;;
    keys)
        case "${2:-}" in
            list) keys_list; echo "end=1" ;;
            add) keys_add ;;
            remove) keys_remove "${3:-}" ;;
            *) echo "ERR usage"; exit 2 ;;
        esac
        ;;
    *)
        echo "Usage: nuubos-remotectl start|stop|status|set ssh|smb|web 0|1|credential show|regenerate|keys list|add|remove FP" >&2
        exit 2
        ;;
esac
