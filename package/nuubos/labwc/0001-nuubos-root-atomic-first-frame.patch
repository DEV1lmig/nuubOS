From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nuubOS <nuubos@localhost>
Date: Sat, 10 Oct 2026 16:00:00 +0200
Subject: [PATCH] output: render the nuubOS boot raster in the first frame

Keep Labwc's mandatory first modeset commit, but give it the nuubOS boot
splash so the kernel splash -> compositor -> nuubUI handoff never jumps.
The raster comes from nuubos-splash-render.h (copied into src/ by
labwc.mk), the same renderer the kernel splash uses and nuubUI ports
pixel for pixel; it is one scene buffer in a dedicated direct child of
the scene root, lowered below Labwc's normal layer/view trees.

---
--- a/src/output.c
+++ b/src/output.c
@@ -11,6 +11,8 @@
 #include <assert.h>
 #include <drm_fourcc.h>
 #include <glib.h>
+#include <stdlib.h>
+#include <string.h>
 #include <strings.h>
 #include <wlr/backend/wayland.h>
 #include <wlr/config.h>
@@ -29,6 +31,7 @@
 #include "common/scene-helpers.h"
 #include "common/string-helpers.h"
 #include "config/rcxml.h"
+#include "buffer.h"
 #include "labwc.h"
 #include "layers.h"
 #include "node.h"
@@ -36,6 +39,9 @@
 #include "output-virtual.h"
 #include "regions.h"
 #include "session-lock.h"
+/* Copied from nuubos-splash by labwc.mk (PRE_BUILD): the same raster as
+ * the kernel splash and nuubUI. */
+#include "nuubos-splash-render.h"
 #include "view.h"
 #include "xwayland.h"
 
@@ -520,6 +526,77 @@
 	return wlr_output_test_state(wlr_output, state);
 }
 
+/* The renderer writes 0x00RRGGBB; scene buffers are ARGB8888. */
+static void
+nuubos_splash_opaque(uint32_t *pixels, size_t count)
+{
+	for (size_t i = 0; i < count; i++) {
+		pixels[i] |= 0xff000000u;
+	}
+}
+
+static void
+nuubos_create_atomic_boot_splash(struct output *output)
+{
+	static struct wlr_scene_tree *boot_tree;
+
+	if (boot_tree || !wlr_output_is_drm(output->wlr_output)) {
+		return;
+	}
+
+	struct wlr_output *wlr_output = output->wlr_output;
+	struct wlr_output_mode *mode = wlr_output->current_mode;
+
+	if (!mode) {
+		mode = wlr_output_preferred_mode(wlr_output);
+	}
+
+	if (!mode || mode->width <= 0 || mode->height <= 0) {
+		wlr_log(WLR_ERROR,
+			"nuubOS: cannot determine boot-splash output geometry");
+		return;
+	}
+
+	int width = mode->width;
+	int height = mode->height;
+	uint32_t *pixels = malloc((size_t)width * (size_t)height * 4);
+
+	if (!pixels) {
+		return;
+	}
+
+	struct nuubos_splash_palette palette;
+
+	nuubos_splash_load_palette(&palette, NULL);
+	nuubos_splash_render(pixels, width, width, height, "boot", &palette);
+	nuubos_splash_opaque(pixels, (size_t)width * (size_t)height);
+
+	/*
+	 * IMPORTANT:
+	 * This is deliberately a direct child of the scene ROOT, not of
+	 * output->layer_tree[0]. Labwc walks layer_tree children as layer-shell
+	 * nodes and asserts that node->data is a layer_surface.
+	 */
+	boot_tree = wlr_scene_tree_create(&server.scene->tree);
+	wlr_scene_node_lower_to_bottom(&boot_tree->node);
+
+	if (output->scene_output) {
+		wlr_scene_node_set_position(&boot_tree->node,
+			output->scene_output->x, output->scene_output->y);
+	}
+
+	/* One buffer node (the buffer owns the pixels). */
+	struct lab_data_buffer *buffer =
+		buffer_create_from_data(pixels, width, height, width * 4);
+
+	wlr_scene_buffer_create(boot_tree, &buffer->base);
+	wlr_buffer_drop(&buffer->base);
+
+	wlr_log(WLR_INFO,
+		"nuubOS: installed root atomic first-frame boot splash %dx%d",
+		width, height);
+}
+
 static void
 configure_new_output(struct output *output)
 {
@@ -552,6 +629,12 @@
 	server.pending_output_layout_change--;
 
 	/*
+	 * Populate the first compositor frame before Labwc performs its mandatory
+	 * initial modeset commit. Keep these nodes outside the layer-shell trees.
+	 */
+	nuubos_create_atomic_boot_splash(output);
+
+	/*
 	 * Force the initial modeset commit to actually happen.
 	 *
 	 * lab_wlr_scene_output_commit() skips the real commit whenever the
-- 
