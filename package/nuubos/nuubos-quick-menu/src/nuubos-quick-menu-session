#!/bin/sh

PIDFILE=/run/nuubos/quick-menu.pid
DAEMON=/usr/bin/nuubos-quick-menu

pid_command()
{
    PID="$1"

    [ -n "$PID" ] || return 1
    [ -r "/proc/$PID/cmdline" ] || return 1

    tr '\0' '\n' < "/proc/$PID/cmdline" 2>/dev/null \
        | sed -n '1p'
}

is_quick_menu_pid()
{
    PID="$1"
    CMD="$(pid_command "$PID")"

    [ "$CMD" = "$DAEMON" ]
}

# Every running instance, not only the pidfile one: the daemon writes the
# pidfile after its startup, so a restart right after the labwc autostart
# (first nuubos-wl-output-apply) used to leave the first instance running
# next to the new one (two resident menus, ~85 MB each).
running_pids()
{
    for DIR in /proc/[0-9]*; do
        PID="${DIR#/proc/}"
        is_quick_menu_pid "$PID" && echo "$PID"
    done
}

stop_current()
{
    PIDS="$(running_pids)"
    [ -n "$PIDS" ] && kill $PIDS 2>/dev/null

    # The old instance removes the pidfile and state files on exit: let it
    # finish before the new one writes them (SIGKILL after 2 s).
    TRIES=0
    while [ -n "$(running_pids)" ]; do
        TRIES=$((TRIES + 1))
        if [ "$TRIES" -gt 20 ]; then
            kill -9 $(running_pids) 2>/dev/null
            break
        fi
        sleep 0.1
    done

    rm -f \
        /run/nuubos/quick-menu.pid \
        /run/nuubos/quick-menu-mapped \
        /run/nuubos/quick-menu-surface \
        /run/nuubos/quick-menu-state
}

case "${1:-start}" in
    restart)
        stop_current
        ;;
    start)
        [ -n "$(running_pids)" ] && exit 0
        rm -f "$PIDFILE"
        ;;
    *)
        echo "Usage: $0 {start|restart}" >&2
        exit 1
        ;;
esac

exec "$DAEMON"
