#!/bin/sh
# nuubOS Tailscale (device-wide remote access).

DAEMON=/usr/sbin/nuubos-tsd
PIDFILE=/run/nuubos/tsd.pid
SOCKET=/run/nuubos/tsd.sock
TS_SOCKET=/run/nuubos/tailscale/tailscaled.sock

tsd_running()
{
    [ -r "$PIDFILE" ] || return 1
    PID="$(cat "$PIDFILE" 2>/dev/null)"
    [ -n "$PID" ] || return 1
    [ "$(tr '\0' '\n' < "/proc/$PID/cmdline" 2>/dev/null | sed -n '1p')" = "$DAEMON" ]
}

start_service()
{
    mkdir -p /run/nuubos
    tsd_running && return 0
    rm -f "$PIDFILE" "$SOCKET" "$TS_SOCKET"
    "$DAEMON" >/run/nuubos/tsd.log 2>&1 &
    return 0
}

stop_service()
{
    if tsd_running; then
        kill -TERM "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null || true
    fi
    rm -f "$PIDFILE" "$SOCKET" "$TS_SOCKET"
    return 0
}

case "${1:-}" in
    start) start_service ;;
    stop) stop_service ;;
    restart) stop_service; start_service ;;
    *) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac
