#!/bin/sh

DAEMON=/usr/sbin/nuubos-audiod
PIDFILE=/run/nuubos-audiod.pid
SOCKET=/run/nuubos/audiod.sock

wait_ready()
{
	i=0

	# Up to 10 s, looked at every 50 ms: the socket is there within
	# milliseconds, and a whole-second step cost every boot ~1 s (boot audit
	# 2026-10-22).
	while [ "$i" -lt 200 ]; do
		if [ -S "$SOCKET" ]; then
			return 0
		fi

		if [ -f "$PIDFILE" ]; then
			PID="$(cat "$PIDFILE" 2>/dev/null)"
			if [ -n "$PID" ] && ! kill -0 "$PID" 2>/dev/null; then
				break
			fi
		fi

		sleep 0.05
		i=$((i + 1))
	done

	return 1
}

case "${1:-}" in
	start)
		"$DAEMON" --supported || exit 0
		mkdir -p /run/nuubos

		start-stop-daemon 			-S -q -b -m 			-p "$PIDFILE" 			-x "$DAEMON"
		RC=$?

		if [ "$RC" -ne 0 ]; then
			echo "nuubos-audiod: start-stop-daemon failed rc=$RC" >&2
			exit "$RC"
		fi

		# Boot (docs/dev/platform.md "Boot time"): no service started
		# after this one talks to audiod, and nuubUI's clients retry, so
		# its PipeWire route setup (~0.4-0.9 s) runs alongside the rest
		# of the boot (/run/nuubos/booting: S13nuubos-ui-early to
		# S50nuubos-ui).
		[ -e /run/nuubos/booting ] && exit 0
		if wait_ready; then
			exit 0
		fi

		echo "nuubos-audiod: failed to become ready: $SOCKET was not created" >&2

		start-stop-daemon 			-K -q 			-p "$PIDFILE" 			-x "$DAEMON" 			2>/dev/null || true

		rm -f "$PIDFILE" "$SOCKET"
		exit 1
		;;
	stop)
		start-stop-daemon 			-K -q 			-p "$PIDFILE" 			-x "$DAEMON" 			2>/dev/null || true

		rm -f "$PIDFILE" "$SOCKET"
		exit 0
		;;
	restart|reload)
		"$0" stop
		"$0" start
		exit $?
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
