config BR2_PACKAGE_NUUBOS_FILES
	bool "nuubos-files"
	depends on BR2_USE_MMU
	select BR2_PACKAGE_NUUBOS_JOBS
	select BR2_PACKAGE_LIBSMB2
	help
	  EPIC-031/032/035/036 and USB storage (EPIC-024): File Manager
	  operations (nuubos-filesctl), removable media mount/eject
	  (nuubos-mediactl) and SMB network shares (nuubos-sharesctl),
	  long operations as nuubos-jobd jobs. The console backup
	  (EPIC-035) is nuubos-sd2-backup in the rootfs overlay.
