diff --color -ruN a/src/video/wayland.c b/src/video/wayland.c
--- a/src/video/wayland.c	2026-10-13 11:56:21.320423890 +0200
+++ b/src/video/wayland.c	2026-10-13 11:56:45.253707538 +0200
@@ -125,6 +125,7 @@
 /* Statistics for the nuubOS control channel. */
 static pthread_mutex_t stats_lock = PTHREAD_MUTEX_INITIALIZER;
 static struct wayland_video_stats stats;
+static int last_frame_number;
 
 static uint64_t now_us(void) {
   struct timespec ts;
@@ -604,6 +605,7 @@
   stream_width = width;
   stream_height = height;
   memset(&stats, 0, sizeof(stats));
+  last_frame_number = 0;
   if (decoder_open(videoFormat, width, height) != 0 || wayland_open() != 0) {
     wayland_close();
     decoder_close();
@@ -636,6 +638,17 @@
   }
   memset(au_buffer + offset, 0, AV_INPUT_BUFFER_PADDING_SIZE);
 
+  pthread_mutex_lock(&stats_lock);
+  stats.bytes_total += offset;
+  if (du->frameHostProcessingLatency) {
+    stats.host_latency_total += du->frameHostProcessingLatency;
+    stats.host_latency_frames++;
+  }
+  if (last_frame_number && du->frameNumber > last_frame_number + 1)
+    stats.lost += (uint64_t) (du->frameNumber - last_frame_number - 1);
+  last_frame_number = du->frameNumber;
+  pthread_mutex_unlock(&stats_lock);
+
   start = now_us();
   packet->data = au_buffer;
   packet->size = (int) offset;
