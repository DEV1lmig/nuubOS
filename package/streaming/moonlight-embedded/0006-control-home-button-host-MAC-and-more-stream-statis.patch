 }
 
+/* Presses (flags) or releases (0) buttons on player 1, on top of what its
+ * gamepad holds: the Home button the console keeps for its own menu. */
+void evdev_set_extra_buttons(int flags) {
+  struct input_device* dev = NULL;
+
+  extraButtonFlags = flags;
+  for (int i = 0; i < numDevices; i++) {
+    if (devices[i].controllerId == 0 && !devices[i].is_keyboard && !devices[i].is_mouse) {
+      dev = &devices[i];
+      break;
+    }
+  }
+  if (dev != NULL)
+    LiSendMultiControllerEvent(0, assignedControllerIds, dev->buttonFlags | flags, dev->leftTrigger, dev->rightTrigger, dev->leftStickX, dev->leftStickY, dev->rightStickX, dev->rightStickY);
+  else
+    LiSendMultiControllerEvent(0, assignedControllerIds | 1, flags, 0, 0, 0, 0, 0, 0);
+}
+
 static struct input_device* evdev_get_input_device(unsigned short controller_id) {
   for (int i=0; i<numDevices; i++)
     if (devices[i].controllerId == controller_id)
