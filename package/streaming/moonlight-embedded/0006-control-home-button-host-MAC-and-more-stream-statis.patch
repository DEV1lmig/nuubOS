+        LiSendMultiControllerEvent(dev->controllerId, assignedControllerIds, dev->buttonFlags | (dev->controllerId == 0 ? extraButtonFlags : 0), dev->leftTrigger, dev->rightTrigger, dev->leftStickX, dev->leftStickY, dev->rightStickX, dev->rightStickY);
       dev->gamepadModified = false;
